{
  "runtime": "Net80",
  "defaultVariables": "",
  "documentGenerator": {
    "fromDocument": {
      "json": "{\n  \"openapi\": \"3.1.1\",\n  \"info\": {\n    \"title\": \"OrganizationName1 Identity API\",\n    \"version\": \"1.0.0\"\n  },\n  \"servers\": [\n    {\n      \"url\": \"https://localhost:2000/\"\n    }\n  ],\n  \"paths\": {\n    \"/api/account/calling-codes\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Retrieves the supported calling codes.\",\n        \"operationId\": \"GetSupportedCallingCodes\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"$ref\": \"#/components/schemas/CallingCode\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/account/forgot-password\": {\n      \"post\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Generates a password reset token and sends it to the user via email.\",\n        \"operationId\": \"ForgotPassword\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ForgotPasswordRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/account/forgot-password/confirmation\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Changes the password of the user confirming the code received during forgot password process.\",\n        \"operationId\": \"ForgotPasswordConfirmation\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ForgotPasswordConfirmationRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/account/password-options\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Gets the password options that are applied when the user creates an account.\",\n        \"operationId\": \"GetPasswordOptions\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/PasswordOptions\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        }\n      }\n    },\n    \"/api/account/register\": {\n      \"post\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Self-service user registration endpoint.\",\n        \"operationId\": \"Register\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/RegisterRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/account/username-exists\": {\n      \"post\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Checks if a username already exists in the database.\",\n        \"operationId\": \"CheckUserNameExists\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ValidateUserNameRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          },\n          \"410\": {\n            \"description\": \"Gone\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/account/validate-password\": {\n      \"post\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Validates a user's password against one or more configured IPasswordValidator.\",\n        \"operationId\": \"ValidatePassword\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ValidatePasswordRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/CredentialsValidationInfo\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/activity-logs\": {\n      \"get\": {\n        \"tags\": [\n          \"ActivityLogs\"\n        ],\n        \"summary\": \"Gets the list of activity logs produced by the Identity system.\",\n        \"operationId\": \"GetActivityLogs\",\n        \"parameters\": [\n          {\n            \"name\": \"Page\",\n            \"in\": \"query\",\n            \"description\": \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Subject\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"SessionId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"MarkForReview\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Succeeded\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ActionName\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ResourceId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ResourceType\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Category\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"SubjectFilterMode\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"$ref\": \"#/components/schemas/SubjectFilterMode\"\n            }\n          },\n          {\n            \"name\": \"From\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          },\n          {\n            \"name\": \"To\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          },\n          {\n            \"name\": \"ApplicationId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"403\": {\n            \"description\": \"Forbidden\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ActivityLogEntryResultSet\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity:logs\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/activity-logs/{rowId}\": {\n      \"patch\": {\n        \"tags\": [\n          \"ActivityLogs\"\n        ],\n        \"summary\": \"Patches the specified log entry by updating the properties given in the request.\",\n        \"operationId\": \"PatchActivityLog\",\n        \"parameters\": [\n          {\n            \"name\": \"rowId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\",\n              \"format\": \"uuid\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ActivityLogEntryRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"403\": {\n            \"description\": \"Forbidden\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity:logs\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/app-settings\": {\n      \"get\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Returns a list of AppSettingInfo objects containing the total number of application settings in the database and the data filtered according to the provided AppSettingInfo.\",\n        \"operationId\": \"GetSettings\",\n        \"parameters\": [\n          {\n            \"name\": \"Page\",\n            \"in\": \"query\",\n            \"description\": \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppSettingInfoResultSet\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      },\n      \"post\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Creates a new application setting.\",\n        \"operationId\": \"CreateSetting\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CreateAppSettingRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"201\": {\n            \"description\": \"Created\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppSettingInfo\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/app-settings/{key}\": {\n      \"get\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Gets an application setting by it's key.\",\n        \"operationId\": \"GetSettingByKey\",\n        \"parameters\": [\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppSettingInfo\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      },\n      \"put\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Updates an existing application setting.\",\n        \"operationId\": \"UpdateSetting\",\n        \"parameters\": [\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdateAppSettingRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/AppSettingInfo\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      },\n      \"delete\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Permanently deletes an application setting.\",\n        \"operationId\": \"DeleteSetting\",\n        \"parameters\": [\n          {\n            \"name\": \"key\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/app-settings/load\": {\n      \"post\": {\n        \"tags\": [\n          \"AppSettings\"\n        ],\n        \"summary\": \"Loads the appsettings.json file and saves the configuration in the database.\",\n        \"operationId\": \"LoadFromAppSettingsJson\",\n        \"parameters\": [\n          {\n            \"name\": \"hardRefresh\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"boolean\",\n              \"default\": false\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/claim-types\": {\n      \"get\": {\n        \"tags\": [\n          \"ClaimTypes\"\n        ],\n        \"summary\": \"Returns a list of ClaimTypeInfo objects containing the total number of claim types in the database and the data filtered according to the provided ListOptions.\",\n        \"operationId\": \"GetClaimTypes\",\n        \"parameters\": [\n          {\n            \"name\": \"Page\",\n            \"in\": \"query\",\n            \"description\": \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n     