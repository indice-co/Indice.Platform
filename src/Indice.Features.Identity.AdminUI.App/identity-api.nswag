       \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CreateSecretRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/SecretInfo\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/clients/{clientId}/secrets/{secretId}\": {\n      \"delete\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Removes a specified secret from a client.\",\n        \"operationId\": \"DeleteClientSecret\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          },\n          {\n            \"name\": \"secretId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/clients/{clientId}/theme\": {\n      \"get\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Gets the UI configuration for the specified client.\",\n        \"operationId\": \"GetClientTheme\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ClientThemeConfigResponse\"\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      },\n      \"put\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Creates or updates the ui configuration for the specified client.\",\n        \"operationId\": \"CreateOrUpdateClientTheme\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ClientThemeConfigRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/clients/{clientId}/urls\": {\n      \"put\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Renews the list of client urls (redirect cors etc).\",\n        \"operationId\": \"UpdateClientUrls\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdateClientUrls\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/clients/certificates\": {\n      \"post\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Gets the metadata of a certificate for display.\",\n        \"operationId\": \"GetCertificateMetadata\",\n        \"requestBody\": {\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/CertificateUploadRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/SecretInfoBase\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/dashboard/metrics\": {\n      \"get\": {\n        \"tags\": [\n          \"Dashboard\"\n        ],\n        \"summary\": \"Gets the key user, client and resource figures shown on the Admin UI dashboard.\",\n        \"operationId\": \"GetDashboardMetrics\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/DashboardMetricsInfo\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:users\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/dashboard/news\": {\n      \"get\": {\n        \"tags\": [\n          \"Dashboard\"\n        ],\n        \"summary\": \"Displays blog posts from the official IdentityServer blog.\",\n        \"operationId\": \"GetNews\",\n        \"parameters\": [\n          {\n            \"name\": \"page\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"size\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/BlogItemInfoResultSet\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/dashboard/summary\": {\n      \"get\": {\n        \"tags\": [\n          \"Dashboard\"\n        ],\n        \"summary\": \"Gets some useful information as a summary of the system.\",\n        \"operationId\": \"GetSystemSummary\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/SummaryInfo\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:users\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/dashboard/ui\": {\n      \"get\": {\n        \"tags\": [\n          \"Dashboard\"\n        ],\n        \"summary\": \"Gets the UI features status.\",\n        \"operationId\": \"GetUiFeatures\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/UiFeaturesInfo\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/api/devices/push\": {\n      \"post\": {\n        \"tags\": [\n          \"DevicePush\"\n        ],\n        \"summary\": \"Sends a push notification.\",\n        \"operationId\": \"SendPushNotification\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SendPushNotificationRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/lookups/external-providers\": {\n      \"get\": {\n        \"tags\": [\n          \"Lookups\"\n        ],\n        \"summary\": \"Gets the list of available external providers.\",\n        \"operationId\": \"GetExternalProviders\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ExternalProviderResultSet\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account\": {\n      \"delete\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Permanently deletes current user's account.\",\n        \"operationId\": \"DeleteAccount\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/block\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Blocks a user account.\",\n        \"operationId\": \"BlockAccount\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/SetUserBlockRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/claims\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Gets the claims of the user.\",\n        \"operationId\": \"GetClaims\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ClaimInfoResultSet\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      },\n      \"post