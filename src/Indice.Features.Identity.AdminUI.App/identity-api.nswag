: \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"From\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          },\n          {\n            \"name\": \"To\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          },\n          {\n            \"name\": \"ApplicationId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n