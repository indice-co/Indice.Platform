  \"identity\"\n            ]\n          }\n        ]\n      },\n      \"patch\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Upserts the requested claims on the current user's account.\",\n        \"operationId\": \"PatchClaims\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"$ref\": \"#/components/schemas/CreateClaimRequest\"\n                }\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ClaimInfoResultSet\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/claims/{claimId}\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Updates the specified claim for the current user.\",\n        \"operationId\": \"UpdateClaim\",\n        \"parameters\": [\n          {\n            \"name\": \"claimId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"format\": \"int32\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdateUserClaimRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ClaimInfo\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/email\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Updates the email of the current user.\",\n        \"operationId\": \"UpdateEmail\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdateUserEmailRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/email/change\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Request email change for the current user.\",\n        \"operationId\": \"EmailChange\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ChangeUserEmailRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/email/change-confirmation\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Confirms the email address change of the current user and saves.\",\n        \"operationId\": \"ConfirmEmailChange\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ConfirmEmailChangeRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/email/confirmation\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Confirms the email address of a given user.\",\n        \"operationId\": \"ConfirmEmail\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ConfirmEmailRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/grants\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Gets the consents given by the user.\",\n        \"operationId\": \"GetConsents\",\n        \"parameters\": [\n          {\n            \"name\": \"Page\",\n            \"in\": \"query\",\n            \"description\": \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ConsentType\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"$ref\": \"#/components/schemas/UserConsentType\"\n            }\n          },\n          {\n            \"name\": \"ClientId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/UserClientInfoResultSet\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      },\n      \"delete\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Revokes all a user's consents and grants for all clients.\",\n        \"operationId\": \"RevokeAllConsents\",\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/grants/{clientId}\": {\n      \"delete\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Revokes all a user's consents and grants for a client.\",\n        \"operationId\": \"RevokeConsents\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/max-devices-count\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Updates the max devices count.\",\n        \"operationId\": \"UpdateMaxDevicesCount\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdateMaxDevicesCountRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/password\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Changes the password for the current user, but requires the old password to be present.\",\n        \"operationId\": \"UpdatePassword\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/ChangePasswordRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"204\": {\n            \"description\": \"No Content\"\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/password-expiration-policy\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Updates the password expiration policy.\",\n        \"operationId\": \"UpdatePasswordExpirationPolicy\",\n        \"requestBody\": {\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/UpdatePasswordExpirationPolicyRequest\"\n              }\n            }\n          },\n          \"required\": true\n        },\n       