efault is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ClaimType\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ClaimValue\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"UserId\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          {\n            \"name\": \"Blocked\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"LockedOut\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"EmailConfirmed\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"PhoneNumberConfirmed\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"TwoFactorEnabled\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"expandClaims\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          }\n        ],\n        \"responses\": {\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"403\": {\n            \"description\": \"Forbidden\",\n            \"content\": {\n              \"application/proble