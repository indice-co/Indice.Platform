)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"d\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/picture/{size}\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Get my profile picture.\",\n        \"operationId\": \"GetMyPictureSize\",\n        \"parameters\": [\n          {\n            \"name\": \"size\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"d\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/picture/{size}.{format}\": {\n      \"get\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Get my profile picture.\",\n        \"operationId\": \"GetMyPictureSizeFormat\",\n        \"parameters\": [\n          {\n            \"name\": \"size\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"format\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"pattern\": \"jpg|png|webp\",\n              \"type\": \"string\"\n            }\n          },\n          {\n            \"name\": \"d\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/account/username\": {\n      \"put\": {\n        \"tags\": [\n          \"MyAccount\"\n        ],\n        \"summary\": \"Changes the username for the current user.\",\n 