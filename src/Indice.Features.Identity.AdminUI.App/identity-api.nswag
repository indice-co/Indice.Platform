          \"identity:logs\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/my/devices\": {\n      \"get\": {\n        \"tags\": [\n          \"MyDevices\"\n        ],\n        \"summary\": \"Returns a list of registered user devices.\",\n        \"operationId\": \"GetDevices\",\n        \"parameters\": [\n          {\n            \"name\": \"Page\",\n            \"in\": \"query\",\n            \"description\": \"The current page of the list. Default is 1.\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Size\",\n            \"in\": \"query\",\n            \"description\": \"The size of the list. Default is 100\",\n            \"schema\": {\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\n              \"type\": [\n                \"null\",\n                \"integer\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Sort\",\n            \"in\": \"query\",\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Search\",\n            \"in\": \"query\",\n            \"description\": \"A search term used to limit the results of the list.\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"string\"\n              ]\n            }\n          },\n          {\n            \"name\": \"IsPushNotificationEnabled\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"IsTrusted\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"Blocked\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"ClientType\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"$ref\": \"#/components/schemas/DeviceClientType\"\n            }\n          },\n          {\n            \"name\": \"IsPendingTrustActivation\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          },\n          {\n            \"name\": \"IsMfaSessionExpired\",\n            \"in\": \"query\",\n            \"schema\": {\n              \"type\": [\n                \"null\",\n                \"boolean\"\n              ]\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"401\": {\n            \"description\": \"Unauthorized\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"applic