},\n          \"200\": {\n            \"description\": \"OK\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ClaimInfo\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Not Found\"\n          },\n          \"400\": {\n            \"description\": \"Bad Request\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\n                }\n              }\n            }\n          }\n        },\n        \"security\": [\n          {\n            \"oauth2\": [\n              \"identity\",\n              \"identity:clients\"\n            ]\n          }\n        ]\n      }\n    },\n    \"/api/clients/{clientId}/claims/{claimId}\": {\n      \"delete\": {\n        \"tags\": [\n          \"Clients\"\n        ],\n        \"summary\": \"Removes an identity resource from the specified client.\",\n        \"operationId\": \"DeleteClientClaim\",\n        \"parameters\": [\n          {\n            \"name\": \"clientId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          },\n          {\n            \"name\": \"claimId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\",\n              \"format\": \"int32\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"500\": {\n            \"description\": \"Internal Server Error\",\n            \"content\": {\n              \"application/problem+json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\n                }\n              }\n            }\n          },\n          \"40