  <Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageTags>AspNetCore;IdentityServer;</PackageTags>
    <VersionPrefix>$(VersionPrefixIdentity)</VersionPrefix>
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)..\..\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Examples\**" />
    <EmbeddedResource Remove="Examples\**" />
    <None Remove="Examples\**" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Indice.AspNetCore" Version="$(VersionPrefixCore)-*" />
    <PackageReference Include="Indice.Extensions.Configuration.Database" Version="$(VersionPrefixCore)-*" />
    <PackageReference Include="Indice.Features.GeoIP" Version="$(VersionPrefixGeoIP)-*" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Duende.IdentityServer.EntityFramework" Version="7.4.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Indice.AspNetCore\Indice.AspNetCore.csproj" />
    <ProjectReference Include="..\Indice.Extensions.Configuration.Database\Indice.Extensions.Configuration.Database.csproj" />
    <ProjectReference Include="..\Indice.Features.GeoIP\Indice.Features.GeoIP.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="ExtendedIdentityErrorResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ExtendedIdentityErrorResources.resx</DependentUpon>
    </Compile>
    <Compile Update="IdentityResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IdentityResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="EmailValidation\Resources\email_blocklist.conf" />
    <EmbeddedResource Include="PhoneNumberValidation\Resources\phones-blacklist.conf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="ExtendedIdentityErrorResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ExtendedIdentityErrorResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="IdentityResources.resx">
      <CustomToolNamespace>Indice.Features.Identity.Core</CustomToolNamespace>
      <LastGenOutput>IdentityResources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/Identity-Product.md" Pack="true" PackagePath="docs\" />
    <None Include="../../docs/identity-admin-logo.svg" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
