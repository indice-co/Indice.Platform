{
  "runtime": "Net80",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": "{\r\n  \"openapi\": \"3.0.1\",\r\n  \"info\": {\r\n    \"title\": \"Cases API. cases-workflow\",\r\n    \"description\": \"Cases REST API for Workflow\",\r\n    \"termsOfService\": \"https://localhost:2000/terms\",\r\n    \"contact\": {\r\n      \"name\": \"Indice Developer\",\r\n      \"url\": \"https://www.indice.gr\",\r\n      \"email\": \"\"\r\n    },\r\n    \"version\": \"v1\"\r\n  },\r\n  \"paths\": {\r\n    \"/api/manage/workflow-integration/{caseId}\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Gets an admin case.\",\r\n        \"operationId\": \"GetById\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"fetchPublicData\",\r\n            \"in\": \"query\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"boolean\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"includeAttachments\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"boolean\",\r\n              \"default\": false\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Case\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/approve\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Adds an approval to a case.\",\r\n        \"operationId\": \"AddApproval\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/WorkflowAddApprovalRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/approve-with-comment\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Adds an approval with comment to a case translating the provided comment.\",\r\n        \"operationId\": \"AddApprovalWithComment\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/WorkflowAddApprovalWithCommentRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/assign\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Assign case to a user.\",\r\n        \"operationId\": \"Assign\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/WorkflowActor\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/AuditMeta\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/block-previous-approver\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Remove assignment and send a message for the UI.\",\r\n        \"operationId\": \"BlockPreviousApprover\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/WorkflowActor\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/json-patch-data\": {\r\n      \"patch\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Patches the data for a case.\",\r\n        \"description\": \"\\r\\nUpdate the Case Data for the specific caseId according to https://datatracker.ietf.org/doc/html/rfc6902#appendix-A\\r\\nExample Usage:\\r\\n```csharp\\r\\n_casesApiClient.JsonPatchAdminCaseDataAsync(caseId, null, new PatchJsonPathRequest[] {\\r\\n   Operations = new PatchOperation[] {\\r\\n     new() { Op = OperationType.Add, Path = \\\"/t1\\\", Value = \\\"test\\\" },\\r\\n     new() { Op = OperationType.Remove, Path = \\\"/t2\\\" }\\r\\n}\\r\\n- **If the path is found \\\"add\\\" works as add or replace.**\\r\\n- **This will NOT create non existing paths, be sure to specify the full object as value on a JsonPointer that exists.**\\r\\n```\\r\\n\",\r\n        \"operationId\": \"JsonPatchData\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/JsonPatchDataRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/last-approval\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Gets last approval of a case.\",\r\n        \"operationId\": \"GetLastApproval\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/CaseApproval\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/metadata\": {\r\n      \"patch\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Patches the metadata of a case.\",\r\n        \"description\": \"\\r\\nPatches the Metadata of the Case from a Dictionary<string, string>\\r\\nNote that this runs as a systemic user and does not perform ANY authorization as opposed to the front facing endpoint.\\r\\nThis should return a boolean response indicating if the Metadata was actually updated.\\r\\n    \",\r\n        \"operationId\": \"PatchMetadata\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"type\": \"object\",\r\n                \"additionalProperties\": {\r\n                  \"type\": \"string\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"boolean\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/patch-data\": {\r\n      \"patch\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Patches the data for a case.\",\r\n        \"description\": \"\\r\\nPatches the Case.Data object with an object passed in the body.\\r\\nIf Data is invalid due to schema validation failure, no change will happen and an error 500 will be returned\\r\\nRecursively merges two JsonNodes by ensuring that the structure of the `original` node is\\r\\nupdated defensively preventing overwrites of incompatible JsonNode types.\\r\\n\\r\\n1. If the `toMerge` node contains multiple nested types, each one of them should exist as-is in the `original` node.\\r\\n2. If the `toMerge` node contains nested types that the `original` node only partially matches (subset),\\r\\n  the remaining nested types are added to the corresponding location in the `original` node.\\r\\n3. When we encounter a JsonArray we add/replace from THIS POINT ON the nested element at the end of the array,\\r\\nand NOT replace any existing - nested or not - items.\\r\\n\\r\\n**JsonIgnoreCondition.WhenWritingNull must NOT be set in the nswag client serializer if you want to remove a property**\\r\\nhttps://indice.visualstudio.com/Platform/_wiki/wikis/Platform.wiki/1613/Patch-Case-Data-API\\\">Documentation\\r\\nFor handling nested arrays, moving elements, checking if data exists at specified locations use JsonPatch API\\r\\n```csharp\\r\\n_casesApiClient.PatchAdminCaseDataAsync(caseId, null, new { t1 = \\\"test\\\", t2 = (object)null! }\\r\\n```\\r\\n- **If the path is found \\\"add\\\" works as add or replace.**\\r\\n- **This will NOT create non existing paths, be sure to specify the full object as value on a JsonPointer that exists.**\\r\\n\",\r\n        \"operationId\": \"PatchData\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/PatchDataRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/{caseId}/remove-assignment\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Removes the assigner of a case.\",\r\n        \"operationId\": \"RemoveAssignment\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                