: \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/manage/workflow-integration/case-types/{caseTypeCode}/subscribers\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Cases workflow\"\r\n        ],\r\n        \"summary\": \"Get case type subscribers.\",\r\n        \"operationId\": \"GetCaseTypeSubscribers\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"caseTypeCode\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Page\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The current page of the list. Default is 1.\",\r\n            \"schema\": {\r\n              \"type\": \"integer\",\r\n              \"format\": \"int32\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Size\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The size of the list. Default is 100\",\r\n            \"schema\": {\r\n              \"type\": \"integer\",\r\n              \"format\": \"int32\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Sort\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Search\",\r\n            \"in\": \"query\",\r\n            \"description\": \"A search term used to limit the results of the list.\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"groupIds\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"emails\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": \"array\",\r\n              \"items\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/NotificationSubscriptionResultSet\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"cases\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  \"components\": {\r\n    \"schemas\": {\r\n      \"Approval\": {\r\n        \"enum\": [\r\n          \"Approve\",\r\n          \"Reject\"\r\n        ],\r\n        \"type\": \"string\",\r\n        \"x-enum-varnames\": [\r\n          \"Approve\",\r\n          \"Reject\"\r\n        ]\r\n      },\r\n      \"AttachFileRequest\": {\r\n        \"required\": 