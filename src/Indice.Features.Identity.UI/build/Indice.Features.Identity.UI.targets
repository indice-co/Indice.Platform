<Project>
  <!-- This will remove any duplicate assets found on the Host web application and the UI project. Host always wins-->
  <Target Name="RemoveIdentityDuplicateAssets">
    <ItemGroup>
      <_DuplicateAssetCandidate Include="@(StaticWebAsset)" Condition="%(SourceId) == 'Indice.Features.Identity.UI'">
        <_RelativePath>$([System.Text.RegularExpressions.Regex]::Replace('%(RelativePath)', '(#\[.+\]\?)(\.[a-zA-Z]+)+(?=\.gz|\.br)(\.gz|\.br)|(#\[.+\]\?)(\.[a-zA-Z]+)+', '$2$5'))</_RelativePath>
        <Path>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)/wwwroot%(BasePath)%(_DuplicateAssetCandidate._RelativePath)))</Path>
      </_DuplicateAssetCandidate>
      <DuplicateAsset Include="@(_DuplicateAssetCandidate)" Condition="Exists(%(Path))"></DuplicateAsset>
    </ItemGroup>
    <ItemGroup>
      <StaticWebAsset Remove="@(DuplicateAsset)" />
    </ItemGroup>
    
  </Target>
</Project>