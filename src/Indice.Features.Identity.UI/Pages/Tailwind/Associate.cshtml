@page "/associate"

@model BaseAssociateModel

@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.Register_Associate_your_Account(Model.View.Provider);
}

<div class="content-wrapper">
    <div class="card-wrapper register">
        <vc:page-heading title="@Localizer.Associate_PageHeader" image-src="" />
        <partial name="_ValidationSummary" />
        <form asp-page="/Associate" method="post" autocomplete="off" novalidate>
            <input type="hidden" asp-for="Input.ReturnUrl" />
            <input type="hidden" asp-for="Input.UserName" />
            <div class="row">
                @if (Model.View.ShowFullName)
                {
                    <div class="input-group">
                        <label class="form-label">@Localizer.Profile_FullName</label>
                        <input class="form-control" type="text" placeholder="@Localizer.Profile_FullName" value="@Model.Input.LastName @Model.Input.FirstName" readonly="readonly" />
                        <input class="form-control" type="hidden" asp-for="Input.FirstName" />
                        <input class="form-control" type="hidden" asp-for="Input.LastName" />
                    </div>
                }
                else
                {
                    <div class="input-group-w-full">
                        <label asp-for="Input.FirstName">@Localizer.Profile_First_Name</label>
                        <input class="form-control" type="text" asp-for="Input.FirstName" placeholder="@Localizer.Profile_First_Name" autofocus readonly="@Model.View.DisableEditGivenName" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="input-group">
                        <label asp-for="Input.LastName" class="">@Localizer.Profile_Last_Name</label>
                        <input class="form-control" type="text" asp-for="Input.LastName" placeholder="@Localizer.Profile_Last_Name" readonly="@Model.View.DisableEditFamilyName" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                }
            </div>
            <div class="row">

                <div class="input-group">
                    <label asp-for="Input.PhoneNumber" class="">@Localizer.Profile_Phone_Number</label>
                    <input class="form-control" type="tel" asp-for="Input.PhoneNumber" placeholder="@Localizer.Profile_Phone_Number" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="input-group">
                    <label asp-for="Input.Email" class="">@Localizer.Email</label>
                    <input class="form-control" type="email" asp-for="Input.Email" placeholder="@Localizer.Email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>

                </div>
            </div>
            @if (!string.IsNullOrEmpty(Localizer.Register_Primary_Contact_Information_Notice.Value))
            {
                <div class="row">
                    <div class="col-span-12">
                        <p class="text-gray-500 text-sm mb-4">@Localizer.Register_Primary_Contact_Information_Notice</p>
                    </div>
                </div>
            }
            <div class="grid grid-cols-1 place-items-start place-content-start mb-4">
                <div class="col-span-1 flex flex-row text-left mb-4">
                    <input asp-for="Input.HasAcceptedTerms" type="checkbox" />
                    <label class="checkbox">
                        @Localizer.Register_I_Have_Read_And_Accept_Terms()
                    </label>
                </div>
                <span asp-validation-for="Input.HasAcceptedTerms" class="text-danger"></span>
                <div class="col-span-1 flex flex-row text-left">
                    <input asp-for="Input.HasReadPrivacyPolicy" type="checkbox" />
                    <label class="checkbox">
                        @Localizer.Register_I_Consent_To_Registration()
                        <a style="font-weight:bold" asp-page="/Privacy" target="_blank">@Localizer.Register_Here.</a>.
                    </label>
                </div>
                <span asp-validation-for="Input.HasReadPrivacyPolicy" class="text-danger"></span>
            </div>
            <div class="row content-center place-items-center text-center mt-8">
                <div class="col-span-12">
                    <button class="btn btn-primary btn-block btn-hover" type="submit">@Localizer.Register_Register</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}
