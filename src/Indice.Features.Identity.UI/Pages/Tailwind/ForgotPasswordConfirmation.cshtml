@page "/forgot-password/confirmation"

@model BaseForgotPasswordConfirmationModel

@inject IdentityUILocalizer Localizer


@{
    ViewData["Title"] = Localizer.ForgotPasswordConfirmation_PageTitle;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.ForgotPasswordConfirmation_PageHeader" image-src="" />
        <partial name="_ValidationSummary" />
        @if (!Model.PasswordSuccessfullyChanged)
        {
            <form data-sbind="event: { change: formChanged }" method="post" autocomplete="off" data-token="@Base64Id.Parse(Model.View.UserId!)" data-userName="@Model.View.UserName">
                <div class="card border-info mt-1 mb-3 p-0">
                    <div class="card-body text-dark text-center justify-content-center align-items-center">
                        <p class="m-0">@Localizer.ForgotPasswordConfirmation_Please_Fill_In_Your_New_Password</p>
                    </div>
                </div>
                <div>
                    <input asp-for="Input.Email" readonly="readonly" class="form-control" />
                    <input asp-for="Input.Token" type="hidden" class="form-control" />
                    <input asp-for="Input.ReturnUrl" type="hidden" class="form-control" />
                    <input asp-for="Input.DeviceId" type="hidden" />
                </div>
                <div>
                    <input type="password" class="form-control" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" placeholder="@Localizer.ForgotPasswordConfirmation_New_Password" autofocus autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div>
                    <div id="password-rules" class="password-rules">
                        <ul data-sbind="foreach: passwordRules">
                            <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                        </ul>
                    </div>
                </div>
                <div>
                    <button class="btn btn-primary" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Localizer.ForgotPasswordConfirmation_Send</button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-success flex-col" role="alert">
                <strong>@Localizer.ForgotPasswordConfirmation_Password_Changed</strong>
                <div>
                    @Localizer.ForgotPasswordConfirmation_LoginLink(Model.Input.ReturnUrl!)
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    @if (Model.View.GenerateDeviceId)
    {
        <script type="text/javascript" src="~/lib/@@fingerprintjs/fingerprintjs/dist/fp.min.js" csp-nonce></script>
        <script type="text/javascript" src="~/js/mfa.js" csp-nonce></script>
        <script type="text/javascript" csp-nonce>
            $(document).ready(function () {
                var viewModelParameters = {
                    $deviceIdInput: $('#Input_DeviceId'),
                    browserFamily: '@Request.GetBrowserName()'
                };
                var viewModel = new indice.mfaViewModelFactory(viewModelParameters);
                viewModel.init();
                viewModel.calculateDeviceId();
            });
        </script>
    }
}
