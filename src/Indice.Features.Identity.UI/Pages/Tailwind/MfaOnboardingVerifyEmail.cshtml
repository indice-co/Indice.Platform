@page "/login/mfa/onboarding/verify-email"

@model BaseMfaOnboardingVerifyEmailModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer

@{
    ViewBag.Title = Localizer.MfaOnBoardingVerifyEmail_PageTitle;
    var infoMessage = TempData.Peek<ExtendedValidationTempDataModel>(BaseMfaOnboardingVerifyEmailModel.TempDataKey);
    var displayNext = !string.IsNullOrEmpty(infoMessage?.NextStepUrl) && infoMessage?.Alert?.AlertType == AlertType.Success;
}
<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.MfaOnBoardingVerifyEmail_PageHeader" image-src="" />
        <partial name="_ValidationSummary" />
        <partial name="_Alert" model="infoMessage?.Alert" />

        <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" novalidate>
            <input type="hidden" asp-for="Input.ReturnUrl" />
            <input type="hidden" asp-for="Input.Email" />

            <div class="mb-4">
                <label asp-for="Input.Code" class="sr-only">@Localizer.MfaOnBoardingVerifyEmail_Code</label>
                <input asp-for="Input.Code"
                       type="text"
                       placeholder="@Localizer.MfaOnBoardingVerifyEmail_Code"
                       disabled="@displayNext"
                       autofocus
                       autocomplete="off"
                       class="block w-full px-3 py-2 border border-gray-300 rounded-md
               placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500
               focus:border-transparent disabled:bg-gray-100 disabled:cursor-not-allowed" />
                <span asp-validation-for="Input.Code" class="block mt-1 text-sm text-red-600"></span>
            </div>

            <div class="mb-4">
                <div class="flex flex-wrap -mx-1">
                    <div class="w-full sm:w-1/2 px-1 py-1">
                        <button type="submit"
                                disabled="@displayNext"
                                class="block w-full py-2 px-4 font-semibold rounded-md
                   bg-blue-500 hover:bg-blue-600 text-white transition
                   disabled:opacity-50 disabled:cursor-not-allowed">
                            @Localizer.MfaOnBoardingVerifyEmail_Save
                        </button>
                    </div>
                    @if (displayNext)
                    {
                        <div class="w-full sm:w-1/2 px-1 py-1">
                            <a href="@infoMessage!.NextStepUrl"
                               class="block w-full py-2 px-4 text-center font-semibold rounded-md
                     bg-blue-500 hover:bg-blue-600 text-white transition">
                                @Localizer.MfaOnBoardingVerifyEmail_Next
                            </a>
                        </div>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}
