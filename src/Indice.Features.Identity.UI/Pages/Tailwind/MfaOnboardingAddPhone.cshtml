@page "/login/mfa/onboarding/add-phone"

@model BaseMfaOnboardingAddPhoneModel

@inject IIdentityViewLocalizer Localizer
@inject IWebHostEnvironment HostingEnvironment

@{
    var title = ViewBag.Title = Localizer["MFA onboarding - SMS"].Value;
    var alert = TempData.Peek<AlertModel>(BaseMfaOnboardingAddPhoneModel.TempDataKey);
}
<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@title" image-src="" />
        <partial name="_ValidationSummary" />
        <partial name="_Alert" model="alert" />

        <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate>
            <div class="mb-4">
                <input type="hidden" asp-for="Input.ReturnUrl" />
                <label asp-for="Input.PhoneNumber" class="sr-only">
                    @Localizer["Phone number"]
                </label>
                <input type="hidden" data-env="@HostingEnvironment.EnvironmentName" />

                <input asp-for="Input.PhoneNumber"
                       type="text"
                       placeholder="@Localizer["Phone number"]"
                       readonly="@Model.View.DisablePhoneNumberInput"
                       class="block w-full px-3 py-2 border border-gray-300 rounded-md
                   placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500
                   focus:border-transparent disabled:bg-gray-100 readonly:bg-gray-100" />

                <span asp-validation-for="Input.PhoneNumber"
                      class="block mt-1 text-sm text-red-600"></span>
            </div>

            <div class="mb-4">
                <div class="w-full">
                    @if (!string.IsNullOrEmpty(Model.View.NextStepUrl))
                    {
                        <a href="@Model.View.NextStepUrl"
                           class="block w-full py-2 px-4 text-center font-semibold rounded-md
                       bg-blue-500 hover:bg-blue-600 text-white transition">
                            @Localizer["Next"]
                        </a>
                    }
                    else
                    {
                        <button type="submit"
                                class="block w-full py-2 px-4 font-semibold rounded-md
                       bg-blue-500 hover:bg-blue-600 text-white transition">
                            @Localizer["Save"]
                        </button>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}
