@page "/login/mfa/onboarding/recovery-codes"
@model BaseMfaOnboardingRecoveryCodesModel

@inject IdentityUILocalizer Localizer

@{
    ViewBag.Title = Localizer.MfaOnBoardingRecoveryCodes_PageTitle;
}
<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.MfaOnBoardingRecoveryCodes_PageHeader" image-src="" />

        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
            @Localizer.MfaOnBoardingRecoveryCodes_SaveWarning
        </div>

        <div class="grid grid-cols-2 gap-2 mb-6">
            @foreach (var code in Model.View.RecoveryCodes)
            {
                <code class="block p-2 border border-gray-200 rounded bg-gray-50 text-center font-mono select-all">@code</code>
            }
        </div>

        <a asp-page-handler="Download" target="_blank" rel="noopener noreferrer" class="block w-full py-2 px-4 font-semibold rounded-md
                       bg-gray-800 hover:bg-gray-900 text-white transition mb-2">
            @Localizer.MfaOnBoardingRecoveryCodes_Download
        </a>

        <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate>
            <button type="submit"
                    class="block w-full py-2 px-4 font-semibold rounded-md
                           bg-blue-500 hover:bg-blue-600 text-white transition">
                @Localizer.MfaOnBoardingRecoveryCodes_Continue
            </button>
        </form>
    </div>
</div>

