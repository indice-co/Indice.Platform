@page "/manage/profile"

@inject IZoneInfoProvider zoneInfoProvider
@inject CallingCodesProvider callingCodesProvider
@inject IOptions<IdentityUIOptions> identityUiOptions
@inject ExtendedUserManager<User> userManager
@inject IdentityUILocalizer Localizer

@model BaseProfileModel

@{
    Layout = "_IdentityProfileLayout";
    ViewData["Title"] = Localizer.Profile_PageTitle;
    var alert = TempData.Get<AlertModel>("Alert");
}

<div class="tab-panel"
     id="edit-profile"
     role="tabpanel"
     aria-labelledby="profile-tab">
    <h3 class="text-black mb-1">@Localizer.Profile_Manage_Profile</h3>
    <div id="send-confirmation-success" class=" text-sm hidden my-2.5">
        <div class="alert alert-success">@Localizer.Profile_A_Confirmation_Email_Has_Been_Sent_To(Model.View.Email ?? throw new InvalidOperationException("User email cannot be null."))</div>
    </div>
    <div id="send-confirmation-error" class=" text-sm hidden my-2.5">
        <div class="alert alert-danger">@Localizer.Profile_Confirmation_Email_Delivery_Failed_Please_Contact_System_Administrator</div>
    </div>
    @if (Model.ProfileSuccessfullyChanged)
    {
        var message = Localizer.Profile_Your_Profile_Was_Updated_Successfully.Value!;
        if (Model.EmailChangeRequested)
        {
			message += (Localizer.ForgotPasswordConfirmation_LoginLink(Url.PageLink("/Login")!)).Value;
        }
        <partial name="_Alert" model="@AlertModel.Success(message)" />
    }
    @if (Model.View.EmailChangePending && !Model.ProfileSuccessfullyChanged)
    {
		<partial name="_Alert" model="@AlertModel.Warn(Localizer.Profile_Your_New_Email_Verification_Is_Still_Pending)" />
    }
    <partial name="_Alert" model="alert" />
    <partial name="_ValidationSummary" />
    <form method="post" class="md:max-h-[60vh] overflow-y-scroll pr-8">
        <div class="row">
            <div class="input-group">
                <input class="peer" type="text" placeholder="@Localizer.Profile_First_Name" asp-for="Input.FirstName" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.FirstName">@Localizer.Profile_First_Name</label>
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="input-group">
                <input class="peer" type="text" placeholder="@Localizer.Profile_Last_Name" asp-for="Input.LastName" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.LastName">@Localizer.Profile_Last_Name</label>
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="input-group">
                <input class="peer" type="text" placeholder="@Localizer.Profile_Username" asp-for="Input.UserName" readonly="@(identityUiOptions.Value.DisableEmailEdit || userManager.EmailAsUserName)" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.UserName">@Localizer.Profile_Username</label>
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>
            <div class="input-group">
                <a indice-if="Model.View.EmailChangePending" href="#" id="resend-email-link" style="font-size: x-small;">(@Localizer.Profile_Confirmation →)</a>
                <input class="peer" type="text" placeholder="@Localizer.Email" asp-for="Input.Email" readonly="@(identityUiOptions.Value.DisableEmailEdit)" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.Email">@Localizer.Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            @if (identityUiOptions.Value.EnablePhoneNumberCallingCodes)
            {
                <div class="input-group">
                    <select class="peer" asp-for="Input.CallingCode" required>
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                        {
                            <option value="@callingCode" selected="@(callingCode.Code == Model.Input.CallingCode)">@callingCode.DisplayName</option>
                        }
                    </select>
                    <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.CallingCode">@Localizer.Profile_Calling_Code</label>
                    <span asp-validation-for="Input.CallingCode" class="text-danger"></span>
                </div>
                <div class="input-group">
                    <input class="peer" type="text" placeholder="@Localizer.Profile_Phone_Number" asp-for="Input.PhoneNumber" readonly="@(identityUiOptions.Value.DisablePhoneEdit)" />
                    <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.PhoneNumber">@Localizer.Profile_Phone_Number</label>
                    <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="input-group">
                    <input class="peer" type="text" placeholder="@Localizer.Profile_Phone_Number]" asp-for="Input.PhoneNumber" />
                    <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.PhoneNumber">@Localizer.Profile_Phone_Number</label>
                    <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
                </div>
                <div class="input-group">
                    <select class="peer" asp-for="Input.ZoneInfo" required>
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var timezone in zoneInfoProvider.GetTimeZones())
                        {
                            <option value="@timezone.Id">@timezone.DisplayName</option>
                        }
                    </select>
                    <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.ZoneInfo">@Localizer.Profile_Timezone</label>
                    <span asp-validation-for="Input.ZoneInfo" class="text-danger"></span>
                </div>
            }
        </div>
        <div class="row">
            <div class="input-group">
                <input class="peer" type="text" placeholder="@Localizer.Profile_Tax_Identification" asp-for="Input.Tin" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.Tin">@Localizer.Profile_Tax_Identification</label>
                <span asp-validation-for="Input.Tin" class="text-danger"></span>
            </div>
            <div class="input-group">
                <input class="peer" type="date" placeholder="@Localizer.Profile_Birth_Date" asp-for="Input.BirthDate" />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.BirthDate">@Localizer.Profile_Birth_Date</label>
                <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
            </div>
        </div>
        @if (identityUiOptions.Value.EnablePhoneNumberCallingCodes)
        {
            <div class="row">
                <div class="input-group">
                    <select class="peer" asp-for="Input.ZoneInfo" required>
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var timezone in zoneInfoProvider.GetTimeZones())
                        {
                            <option value="@timezone.Id">@timezone.DisplayName</option>
                        }
                    </select>
                    <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.ZoneInfo">@Localizer.Profile_Timezone</label>
                    <span asp-validation-for="Input.ZoneInfo" class="text-danger"></span>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-span-12 flex flex-row text-left">
                <input asp-for="Input.ConsentCommercial" type="checkbox" />
                <label for="ConsentCommercial">
                    <span>
                        @Localizer.Profile_PrivacyPolicyConsent
                        <a class="font-bold" target="_blank" href="/privacy" onclick="event.stopPropagation();">@Localizer.Profile_Here.</a>
                    </span>
                </label>
            </div>
        </div>
        <div class="row mt-7 mb-12">
            <div class="md:col-span-6 col-span-12"> <button class="btn  btn-primary" type="submit">@Localizer.Profile_Save</button></div>
        </div>

    </form>
    <div class="m-auto">
        <hr>
        <h3 class="text-black mb-1">@Localizer.Profile_Preferences</h3>
        <form id="userPreferenceForm" method="post" asp-page-handler="UpdateLanguagePreference">

            <div class="input-group">
                <select class="peer" asp-for="InputLanguagePreference.Locale" placeholder="@Localizer.Profile_Language" required>
                    <option value="">@Localizer.Profile_Choose</option>
                    @foreach (var culture in Model.View.SupportedCultures)
                    {
                        <option value="@culture.TwoLetterISOLanguageName" selected="@(culture.TwoLetterISOLanguageName.Equals(Model.View.Locale))">@culture.TwoLetterISOLanguageName.ToUpperInvariant() - @culture.NativeName</option>
                    }
                </select>
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="InputLanguagePreference.Locale">@Localizer.Profile_Language</label>
                <span asp-validation-for="InputLanguagePreference.Locale" class="text-danger"></span>
            </div>
        </form>
    </div>
    <div class="m-auto" indice-if="Model.View.CurrentLogins?.Count > 0 || Model.View.OtherLogins?.Count > 0">
        <hr>
        <h3 class="text-black mb-1">@Localizer.Profile_External_Providers</h3>
        @{
            var alertProviders = TempData.Get<AlertModel>("AlertProviders");
        }
        <partial name="_Alert" model="alertProviders" />
        @if (Model.View.CurrentLogins?.Count > 0)
        {
            <p class="text-sm">@Localizer.Profile_Existing_Providers</p>
            <div class="row pb-5 mt-5">
                @foreach (var provider in Model.View.CurrentLogins)
                {
                    <div class="idp-@provider.LoginProvider.ToLower() col-span-6">
                        <a class="no-underline cursor-pointer"></a>
                    </div>
                    <div class="col-span-6">
                        <form asp-page-handler="RemoveLogin" method="post" class="inline">
                            <input asp-for="@provider.LoginProvider" name="@nameof(provider.LoginProvider)" type="hidden" />
                            <input asp-for="@provider.ProviderKey" name="@nameof(provider.ProviderKey)" type="hidden" />
                            <button type="submit" class="btn btn-danger" disabled="@(!Model.View.CanRemoveProvider)">@Localizer.Profile_Remove</button>
                        </form>
                    </div>
                }
            </div>
        }
        @if (Model.View.OtherLogins?.Count > 0)
        {
            <p class="text-sm">@Localizer.Profile_Connect_A_New_Provider</p>
            <div class="flex justify-start pb-5 mt-5">

                @foreach (var provider in Model.View.OtherLogins)
                {
                    <div class="idp idp-@provider.Name.ToLower() mx-2.5">
                        <a asp-page-handler="LinkLogin" asp-route-provider="@provider.Name" title="@provider.DisplayName">
                        </a>
                    </div>
                }
            </div>
        }
    </div>
    <partial name="_LanguageSelector" />
</div>

@section scripts {
    <script type="text/javascript" csp-nonce="true">
        $(document).ready(function () {
            $('#resend-email-link').click(function () {
                $.ajax({
                    url: '@Url.PageLink(pageName: "/ConfirmEmail", pageHandler: "Resend")',
                    type: 'GET',
                    dataType: 'json',
                    statusCode: {
                        204: function () {
                            $('#resend-email-link').addClass('disabled');
                            $('#send-confirmation-success').removeClass('hidden');
                        },
                        500: function () {
                            $('#send-confirmation-error').removeClass('hidden');
                        }
                    }
                });
            });
        });
    </script>
    <partial name="_ValidationScripts" />
    <script csp-nonce="true">
        document.querySelectorAll('.idp a').forEach(function (el) {
            el.onclick = function (link) {
                if (!link.target.classList.contains('disabled')) {
                    link.target.classList.add('disabled');
                }
            };
        });
    </script>
    <script csp-nonce="true">
        document.querySelectorAll('#userPreferenceForm select').forEach(function (el) {
            el.addEventListener("change", function (select) {
                document.getElementById('userPreferenceForm').submit();
            });
        });
    </script>
}
