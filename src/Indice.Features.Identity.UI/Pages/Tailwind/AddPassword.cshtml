@page "/add-password"

@model BaseAddPasswordModel

@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels

@{
    var title = ViewData["Title"] = Labels.AddPassword_Add_Password;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@title" image-src="" />
        <partial name="_ValidationSummary" />
        @if (Model.PasswordSuccessfullyAdded)
        {
            <div class="alert alert-success" role="alert">
                <strong>@Labels.AddPassword_Process_completed</strong> @Labels.AddPassword_Password_successfully_added.
            </div>
        }
        <form indice-if="!Model.PasswordSuccessfullyAdded" data-sbind="event: { change: formChanged }" data-token="@Base64Id.Parse(User.FindSubjectId()!)" data-userName="@(User.Identity?.Name ?? string.Empty)" novalidate method="post">
            <div class="form-group">
                <label asp-for="Input.NewPassword" class="">@Labels.AddPassword_New_password</label>
                <input class="form-control" type="password" placeholder="@Labels.AddPassword_New_password" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" autocomplete="off" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="">@Labels.AddPassword_Confirm_password</label>
                <input class="form-control" type="password" placeholder=@Labels.AddPassword_Confirm_password asp-for="Input.ConfirmPassword" autocomplete="off" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div id="password-rules" class="password-rules">
                    <ul data-sbind="foreach: passwordRules">
                        <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                    </ul>
                </div>
            </div>
            <div class="form-group">
                <button class="btn btn-primary btn-block" name="button" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Labels.AddPassword_Add</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/password-rules.js" csp-nonce="true"></script>
}
