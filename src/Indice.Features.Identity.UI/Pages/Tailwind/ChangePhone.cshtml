@page "/manage/phone"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("manage/mfa-challenge")]

@model BaseChangePhoneModel

@inject CallingCodesProvider callingCodesProvider
@inject IdentityUILocalizer Localizer

@{
    Layout = "_IdentityProfileLayout";
    ViewData["Title"] = Localizer.ChangePhone_PageTitle;
    var mfaChallenge = Model.MfaChallenge;
}

<div class="tab-panel" role="tabpanel" inert="@(mfaChallenge is not null)">
    <a class="inline-flex items-center gap-1 mb-4 text-black no-underline" asp-page="/Profile">&larr; @Localizer.Mfa_Back</a>
    <h3 class="text-black mb-4">@Localizer.ChangePhone_PageTitle</h3>
    <partial name="_ValidationSummary" />
    <form method="post" class="px-0" novalidate>
        <div class="row">
            <div indice-if="Model.IdentityUiOptions.EnablePhoneNumberCallingCodes" class="input-group">
                <select class="peer" asp-for="Input.CallingCode" required>
                    <option value="">@Localizer.Profile_Choose</option>
                    @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                    {
                        <option value="@callingCode" selected="@(callingCode.Code == Model.Input.CallingCode)">@callingCode.DisplayName</option>
                    }
                </select>
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.CallingCode">@Localizer.Profile_Calling_Code</label>
                <span asp-validation-for="Input.CallingCode" class="text-danger"></span>
            </div>
            <div class="input-group">
                <input class="peer" type="tel" placeholder="@Localizer.Profile_Phone_Number" asp-for="Input.PhoneNumber" autocomplete="tel" autofocus />
                <label class="peer-focus:-translate-y-[6px] peer-focus:visible absolute" asp-for="Input.PhoneNumber">@Localizer.Profile_Phone_Number</label>
                <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
            </div>
        </div>
        <div class="flex justify-end gap-2 mt-4">
            <button class="btn btn-primary" type="submit">@Localizer.Profile_Save</button>
        </div>
    </form>
</div>

@if (Model.CodeSent)
{
    <div class="verify-dialog" role="dialog" aria-modal="true" aria-labelledby="verify-dialog-title">
        <div class="verify-dialog__box">
            <a class="verify-dialog__close" asp-page="/Profile" aria-label="@Localizer.ChangeEmail_Close">&times;</a>
            <h2 class="verify-dialog__title" id="verify-dialog-title">@Localizer.ChangeEmail_VerifyTitle</h2>
            <p class="verify-dialog__text">@Localizer.ChangePhone_VerifyOtpPrompt(Model.Verify.PhoneNumber ?? string.Empty)</p>
            <form method="post" asp-page-handler="Verify" class="px-0" novalidate>
                <input type="hidden" asp-for="Verify.PhoneNumber" />
                <label asp-for="Verify.Code" class="block mb-2 text-sm">@Localizer.ChangeEmail_OtpCode</label>
                <input class="otp-field__input" data-otp-length="6" type="text" inputmode="numeric" autocomplete="one-time-code" asp-for="Verify.Code" value="" autofocus />
                <span asp-validation-for="Verify.Code" class="text-danger"></span>
                <p class="otp-field__resend">
                    <button type="submit" id="otp-resend" name="Verify.OtpResend" value="true" formnovalidate class="otp-field__resend-btn">
                        <span class="otp-field__resend-text">@Localizer.VerifyPhone_Resend</span>
                        <span class="otp-field__wait">@Localizer.Mfa_ResendAvailableIn <span class="countdown"></span></span>
                    </button>
                </p>
                <div class="verify-dialog__actions">
                    <button class="btn btn-primary" type="submit">@Localizer.ChangeEmail_Verify</button>
                </div>
            </form>
        </div>
    </div>
}

@if (mfaChallenge is not null)
{
    <partial name="_ProfileMfaChallenge" model="mfaChallenge" />
}

@section scripts {
    <partial name="_ValidationScripts" />
    @if (Model.CodeSent || mfaChallenge?.CanEnterCode == true)
    {
        <script type="text/javascript" src="~/js/otp.js" csp-nonce="true"></script>
        <script type="text/javascript" src="~/js/otp-field.js" csp-nonce="true"></script>
    }
}
