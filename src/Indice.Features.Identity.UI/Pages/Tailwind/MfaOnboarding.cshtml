@page "/login/mfa/onboarding"
@using Indice.Features.Identity.Core.Models

@model BaseMfaOnboardingModel

@inject IConfiguration Configuration
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = @Localizer.MfaOnBoarding_PageTitle;
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var langSuffix = (lang == "el") ? ".el" : string.Empty;
}
@functions {
    public string GetIconFromAuthenticationMethod(AuthenticationMethod method)
    {
        return method.Code.ToLowerInvariant() switch
        {
            "viber" => "fa-brands fa-viber",
            "sms" => "fa-regular fa-message",
            "email" => "fa-regular fa-envelope",
            "authenticatorapp" => "fa-solid fa-shield-halved",
            "trusteddevice" => "fa-solid fa-mobile-screen",
            "fido2" => "fa-solid fa-fingerprint",
            "code" => "fa-solid fa-square-binary",
            _ => "fa-regular fa-message"
        };
    }
}
<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.MfaOnboarding_PageHeader" image-src="" />
        <h1 class="text-center mb-6">
            <a class="header-logo inline-block" href="/">
                <img src="~/img/logo@(langSuffix).svg" alt="Logo" />
            </a>
            <span class="block text-2xl font-semibold mt-2">
                @Localizer.MfaOnBoarding_Keep_Your_Account_Safe
            </span>
            <span class="block text-base text-gray-600 mt-1">
                @Localizer.MfaOnBoarding_Setup_An_Additional_Authentication_Method
            </span>
        </h1>

        <div id="authentication-methods" class="space-y-4">
            <!-- ko foreach: authenticationMethods -->
            <a href="javascript:void(0)"
               data-sbind="event: { click: $parent.methodSelected }, css: { outline: selected }"
               class="block p-4 bg-white border border-gray-200 rounded hover:bg-gray-50 transition">
                <div class="flex justify-between">
                    <h5 class="text-lg font-medium" data-sbind="text: displayName"></h5>
                </div>
                <small class="block text-sm text-gray-500 mt-1" data-sbind="text: description"></small>
            </a>
            <!-- /ko -->

            <span asp-validation-for="Input.SelectedAuthenticationMethod"
                  class="block text-red-600 mt-2"></span>
        </div>

        <form class="mt-3"
              asp-route-returnUrl="@Model.View.ReturnUrl"
              method="post"
              novalidate>
            <input type="hidden" asp-for="Input.ReturnUrl" />
            <input type="hidden"
                   data-sbind="value: selectedMethodType"
                   asp-for="Input.SelectedAuthenticationMethod" />

            <div class="mb-3">
                <div class="w-full m-0">
                    <button type="submit"
                            name="button"
                            value="login"
                            class="w-full py-2 px-4 font-semibold rounded bg-blue-600 hover:bg-blue-700 text-white transition">
                        @Localizer.MfaOnBoarding_Next
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/mfa-onboarding.js" csp-nonce></script>
    <script type="text/javascript" csp-nonce>
        var viewModelParameters = {
           authenticationMethods: @Html.Raw(JsonSerializer.Serialize(Model.View.AuthenticationMethods, JsonSerializerOptionDefaults.GetDefaultSettings())),
           icons: @Html.Raw(JsonSerializer.Serialize(Model.View.AuthenticationMethods.ToDictionary(x => x.Code, x => GetIconFromAuthenticationMethod(x)), JsonSerializerOptionDefaults.GetDefaultSettings()))
        };
        var viewModel = new indice.MfaOnboardingViewModelFactory(viewModelParameters);
        viewModel.init();
        ko.bindingProvider.instance = new ko.secureBindingsProvider();
        ko.applyBindings(viewModel);
    </script>
}