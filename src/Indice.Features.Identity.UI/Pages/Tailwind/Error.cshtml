@page "/error"

@inject IdentityUILocalizer Localizer

@model BaseErrorModel

@{
    var error = Localizer.Error_Oops_Seems_We_Encountered_An_Error.Value;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <partial name="_PageHeader" model="error" />
        <p class="pt-5">
            @if (Model is { Message: { Length: > 0 } })
            {
                <strong>
                    <em>: @Model.Message</em>
                </strong>
            }
            @if (Model is { RequestId: { Length: > 0 } })
            {
                <div class="request-id">@Localizer.Error_Request_Id: @Model.RequestId</div>
            }
        </p>
    </div>
</div>
