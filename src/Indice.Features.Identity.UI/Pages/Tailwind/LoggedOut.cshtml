@page "/logged-out"

@model BaseLoggedOutModel
@inject IdentityUILocalizer Localizer


@{
    var title = ViewData["Title"] = Localizer.LoggedOut_PageTitle;
    ViewData["signed-out"] = true;
}

<section class="content-wrapper @(Model.AutomaticRedirectAfterSignOut ? "hidden": "")">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.LoggedOut_PageHeader" image-src="" />
        <p>@Localizer.LoggedOut_You_Are_Now_Logged_Out</p>
        <div>
            @Localizer.LoggedOut_Click <a id="PostLogoutRedirectUri" class="text-tenant-900" href="@(Model.HasPostLogoutRedirectUri ? Model.PostLogoutRedirectUri : "/")">@Localizer.LoggedOut_Here</a> @Localizer.LoggedOut_To_Return_To_The_Application
            <span indice-if="Model.HasPostLogoutRedirectUri">@Model.ClientName</span>.
        </div>
        <iframe indice-if="Model.SignOutIframeUrl != null" width="0" height="0" class="signout" src="@Model.SignOutIframeUrl"></iframe>
    </div>
</section>

@section scripts {
    @if (Model.AutomaticRedirectAfterSignOut)
    {
        <script csp-nonce="true" src="~/js/signout-redirect.js" asp-append-version="true"></script>
    }
}