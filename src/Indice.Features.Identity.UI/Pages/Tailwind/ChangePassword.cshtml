@page "/change-password"

@model BaseChangePasswordModel

@inject IdentityUILocalizer Localizer

@{
    Layout = "_IdentityProfileLayout";
    ViewData["Title"] = Localizer.ChangePassword_PageTitle;
}

<div class="tab-panel"
     id="changePassword"
     role="tabpanel"
     aria-labelledby="changePassword-tab">
    <h3 class="text-black mb-1">Localizer.ChangePassword_PageHeader</h3>
    <partial name="_ValidationSummary" />
    @if (Model.PasswordSuccessfullyChanged)
    {
        <div class="alert alert-success" role="alert">
            <strong>@Localizer.ChangePassword_ProcessCompleted</strong> @Localizer.ChangePassword_PasswordSuccessfullyChanged.
        </div>
    }
    <form data-sbind="event: { change: formChanged }" data-token="@Base64Id.Parse(User.FindSubjectId()!)" data-userName="@(User.Identity?.Name ?? string.Empty)" novalidate method="post" class="px-0">
        <div class="row">            
            <div class="input-group-w-full password-control">
                <div class="relative">
                    <div class="absolute inset-y-0 right-4 flex items-center mt-[1.8rem]">
                        <button type="button" class="btn-password-show"></button>
                    </div>
                </div>
                <input class="form-control peer" type="password" placeholder="@Localizer.ChangePassword_OldPassword" asp-for="Input.OldPassword" autocomplete="old-password" />
                <label asp-for="Input.OldPassword" class="peer-focus:-translate-y-[6px] peer-focus:visible absolute">@Localizer.ChangePassword_OldPassword</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>            
            <div class="input-group-w-full password-control">
                <div class="relative">
                    <div class="absolute inset-y-0 right-4 flex items-center mt-[1.8rem]">
                        <button type="button" class="btn-password-show"></button>
                    </div>
                </div>
                <input class="form-control peer" type="password" placeholder="@Localizer.ChangePassword_Newpassword_FieldLabel" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" autocomplete="new-password" />
                <label asp-for="Input.NewPassword" class="peer-focus:-translate-y-[6px] peer-focus:visible absolute">@Localizer.ChangePassword_Newpassword_FieldLabel</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div id="password-rules" class="password-rules col-span-12">
                <ul data-sbind="foreach: passwordRules">
                    <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                </ul>
            </div>
        </div>
        <div class="grid justify-items-start">
            <button class="btn btn-primary"
                    name="button" type="submit" data-sbind="attr: { disabled: !isFormValid }">
                @Localizer.ChangePassword_Change
            </button>
        </div>
    </form>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
}