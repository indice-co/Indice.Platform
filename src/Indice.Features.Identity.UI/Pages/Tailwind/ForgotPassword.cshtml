@page "/forgot-password"

@model BaseForgotPasswordModel

@inject IdentityLabelsMessageDescriber Labels
@inject ExtendedUserManager<User> userManager

@{
    var title = ViewData["Title"] = Labels.ForgotPassword_Forgot_Password;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@title" image-src="" />
        <p>@Labels.ForgotPassword_ResetInstructions</p>
        <partial name="_ValidationSummary" />
        <form method="post" autocomplete="off" class="form">
            <input type="hidden" asp-for="Input.ReturnUrl" />
            @if (Model.RequestSent)
            {
                <div class="alert alert-info" role="alert">
                    <strong>@Labels.ForgotPassword_Request_Sent.</strong> @ViewData["message"]
                </div>
            }
            <div class="row">
                <div class="input-group-w-full">
                    <input asp-for="Input.Email" class="peer" type="text" class="form-control" placeholder="@Labels.Email" autofocus />
                    <label asp-for="Input.Email" class="peer-focus:-translate-y-[6px] peer-focus:visible absolute">
                        @Labels.Email
                    </label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>
            <div class="flex justify-center items-center mt-8">
                <button class="btn btn-primary" type="submit">@(Model.RequestSent? Labels.ForgotPassword_Resend: Labels.ForgotPassword_Send)</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}