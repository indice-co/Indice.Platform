@page "/logout"

@model BaseLogoutModel

@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels

@{
    var title = ViewData["Title"] = Labels.Logout_Logout;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@title" image-src="" />
        <p>@Labels.Logout_Would_You_Like_To_Logout</p>
        <form asp-page="/Logout">
            <input type="hidden" name="logoutId" value="@Model.LogoutId" />
            <fieldset>
                <button class="btn btn-primary">@Labels.Logout_Yes</button>
            </fieldset>
        </form>
    </div>
</div>
