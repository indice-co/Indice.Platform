@page "/logout"

@model BaseLogoutModel

@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.Logout_PageTitle;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.Logout_PageHeader" image-src="" />
        <p>@Localizer.Logout_Would_You_Like_To_Logout</p>
        <form asp-page="/Logout">
            <input type="hidden" name="logoutId" value="@Model.LogoutId" />
            <fieldset>
                <button class="btn btn-primary">@Localizer.Logout_Yes</button>
            </fieldset>
        </form>
    </div>
</div>
