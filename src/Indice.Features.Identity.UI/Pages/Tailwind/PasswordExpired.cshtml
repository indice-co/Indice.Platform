@page "/login/password-expired"

@model BasePasswordExpiredModel

@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.PasswordExpired_PageTitle;
    var tempData = TempData.Peek<ExtendedValidationTempDataModel>(BasePasswordExpiredModel.TempDataKey);
    var alert = tempData?.Alert;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.PasswordExpired_PageHeader" image-src="" />
        <partial name="_ValidationSummary" />
        <partial name="_Alert" model="alert" />
        <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" data-sbind="event: { change: formChanged }" novalidate>
            <input asp-for="Input.DeviceId" type="hidden" />
            <div indice-if="@(tempData?.DisableForm != true)" class="input-group-w-full group password-control">
                <input class="peer password" type="password" placeholder="@Localizer.PasswordExpired_New_Password" asp-for="Input.NewPassword" disabled="@(tempData?.DisableForm == true)" autocomplete="new-password" data-sbind="event: { keyup: passwordChanged }" />
                <label asp-for="Input.NewPassword" class="peer-focus:-translate-y-[6px] peer-focus:visible absolute">@Localizer.PasswordExpired_New_Password</label>
                <i role="button" class="reveal-icon" aria-label="Show password" title="Show password" aria-pressed="false"></i>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div indice-if="@(tempData?.DisableForm != true)" class="input-group-w-full group password-control">
                <input class="peer password" type="password" placeholder="@Localizer.PasswordExpired_New_Password_Confirmation" asp-for="Input.NewPasswordConfirmation"
                       disabled="@(tempData?.DisableForm == true)"
                       autocomplete="new-password" />
                <label asp-for="Input.NewPasswordConfirmation" class="peer-focus:-translate-y-[6px] peer-focus:visible absolute">@Localizer.PasswordExpired_New_Password_Confirmation</label>
                <i role="button" class="reveal-icon" aria-label="Show password" title="Show password" aria-pressed="false"></i>
                <span asp-validation-for="Input.NewPasswordConfirmation" class="text-danger"></span>
            </div>
            <div id="password-rules" class="password-rules col-md-12">
                <ul data-sbind="foreach: passwordRules">
                    <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                </ul>
            </div>
            <div class="row justify-items-center place-items-center">
                <div class="@(tempData?.DisableForm is true ? "col-span-6" : "col-span-12") flex flex-col">
                    <button class="btn btn-primary" type="submit" disabled="@(tempData?.DisableForm == true)" data-sbind="attr: { disabled: !isFormValid }">@Localizer.PasswordExpired_Save</button>
                </div>
                @if (tempData?.DisableForm == true && !string.IsNullOrWhiteSpace(tempData.NextStepUrl))
                {
                    <div class="col-span-6 flex flex-col">
                        <a class="btn btn-primary no-underline" href="@tempData.NextStepUrl">@Localizer.PasswordExpired_Next</a>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/reveal-password.js" csp-nonce="true"></script>
    @if (Model.View.GenerateDeviceId)
    {
        <script type="text/javascript" src="~/lib/@@fingerprintjs/fingerprintjs/dist/fp.min.js" csp-nonce></script>
        <script type="text/javascript" src="~/js/mfa.js" csp-nonce></script>
        <script type="text/javascript" csp-nonce>
            $(document).ready(function () {
                var viewModelParameters = {
                    $deviceIdInput: $('#Input_DeviceId'),
                    browserFamily: '@Request.GetBrowserName()'
                };
                var viewModel = new indice.mfaViewModelFactory(viewModelParameters);
                viewModel.init();
                viewModel.calculateDeviceId();
            });
        </script>
    }
}
