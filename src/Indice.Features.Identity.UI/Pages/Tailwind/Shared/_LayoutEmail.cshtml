@using Indice.Features.Identity.Server.Manager.Models
@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject IConfiguration Configuration
@inject IdentityUILocalizer Localizer
@{
    var settings = GeneralSettings.Value;
    var ui = UIOptions.Value;
    var linkColor = ui.EmailLinkColorHex;
    var legalEntity = Configuration.GetSection("General");
    var supportPhone = legalEntity["OrganizationSupportPhone"] ?? "";
    var supportEmail = legalEntity["OrganizationSupportEmail"] ?? "";
    var hasSupport = !string.IsNullOrWhiteSpace(supportPhone) && !string.IsNullOrWhiteSpace(supportEmail);
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var recipientEmail = GetSafeRecipientEmail();
    var organizationLegalName = (Localizer.OrganizationLegalName() ?? legalEntity["OrganizationLegalName"])!.ToString();
    var organizationAddress = (Localizer.OrganizationAddress() ?? legalEntity["OrganizationAddress"])!.ToString();
    var organizationRegistryNumber =  legalEntity["OrganizationRegistryNumber"]!.ToString();

    var phoneLink = $"<a href=\"tel:{supportPhone.Replace(" ", string.Empty)}\" style=\"color:#{linkColor};text-decoration:underline;\">{supportPhone}</a>";
    var emailLink = $"<a href=\"mailto:{supportEmail}\" style=\"color:#{linkColor};text-decoration:underline;\">{supportEmail}</a>";
}

@functions {
    public string? GetSafeRecipientEmail() => Model switch
    {
        IIdentityEmailModelMetadata metadata => metadata.RecipientEmail,
        IDictionary<string, object> dictionary
            when dictionary.TryGetValue(nameof(IIdentityEmailModelMetadata.RecipientEmail), out var recipient)
                => recipient?.ToString(),
        _ => null
    };
}

<html>
<head>
</head>
<body style="margin: 0; padding: 0; background:#f2f2f2;">
    <center span class="pre-header" style="display:none; font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 10px; color:#595959;">
        @RenderSection("preheader", required: false)
    </center>
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="648" style="border-collapse: collapse;">
        <tr>
            <td bgcolor="#ffffff" style="padding:30px 30px 30px 30px; font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 14px;">
                <p>
                    @RenderSection("subject", required: false)
                </p>
                <p>
                    @RenderBody()
                </p>
            </td>
        </tr>
        @* Email footer *@
        <tr>
            <td bgcolor="#ffffff" style="padding: 24px 30px 30px; border-top: 1px solid #ececec; font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 11px; color: #8a8a8a; line-height: 150%;">
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse;">

                    @if (!string.IsNullOrWhiteSpace(recipientEmail)) {
                        <tr>
                            <td align="center" style="padding: 0 0 8px; font-size: 11px; color: #8a8a8a;">
                                @Localizer.EmailFooter_SentTo($"<strong style=\"color:#595959;\">{recipientEmail}</strong>")
                            </td>
                        </tr>
                    }
                    <tr>
                        <td align="center" style="padding: 2px 0 0; font-size: 11px; color: #595959;">
                            &copy; @ui.CopyYear @organizationLegalName
                            @if (!string.IsNullOrWhiteSpace(organizationAddress)) {
                                <text>&bull; @organizationAddress</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(organizationRegistryNumber)) {
                                <text>&bull; @Localizer.EmailFooter_RegistryNumber(organizationRegistryNumber)</text>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding: 4px 0 0; font-size: 11px;">
                            <a href="@(settings.Host)/privacy?culture=@culture" target="_blank" style="color: #@linkColor; text-decoration: underline; margin: 0 6px;">@Localizer.Footer_Privacy</a>
                            <span style="color: #cccccc;">|</span>
                            <a href="@(settings.Host)/terms?culture=@culture" target="_blank" style="color: #@linkColor; text-decoration: underline; margin: 0 6px;">@Localizer.Footer_Terms</a>
                        </td>
                    </tr>
                    @if (hasSupport) {
                        <tr>
                            <td align="center" style="padding: 2px 0 0; font-size: 11px; color: #8a8a8a;">
                                <strong style="color: #595959;">@Localizer.EmailFooter_NeedHelp</strong>
                                @Localizer.EmailFooter_SupportContactLine(phoneLink, emailLink)
                            </td>
                        </tr>
                    }
                    <tr>
                        <td align="center" style="padding: 0 0 8px; font-size: 11px; color: #8a8a8a;">
                            @Localizer.ConfirmEmail_DoNotReply
                            @Localizer.ConfirmEmail_ServiceEmailInfo
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
