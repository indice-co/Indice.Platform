@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject UserManager<User> UserManager
@inject IdentityLabelsMessageDescriber Labels

@{
    Layout = "_LayoutEmail.cshtml";
}

@{
    var settings = GeneralSettings.Value;
    var subject = ViewData["Subject"];
    var body = ViewData["Body"];
    var userName = Model?.UserName ?? UserManager.GetUserName(User);
    var confirmationLink = Model?.Url ?? throw new InvalidOperationException("Confirmation link cannot be null.");
}

@section preheader {
    @Labels.Email_Preheader_Verify <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@confirmationLink">@Labels.Email_Preheader_Here</a> @Labels.Email_Preheader_ToGetVerified!
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-weight:normal">@subject</h1>
}

<p style="font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 12px;">
    @Labels.Email_Body_Hi @(userName ?? string.Empty),
    <br />
    <br />
    @Labels.Email_Preheader_Verify <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@confirmationLink">@Labels.Email_Preheader_Here</a> @Labels.Email_Preheader_ToGetVerified
    <br />
    <br />
    @Labels.Email_Body_Thanks.
    <br />
    <br />
    @Labels.Email_Body_Sincerely, @Labels.OrganizationName(settings.Organization!).
</p>