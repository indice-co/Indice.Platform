@inject IIdentityViewLocalizer Localizer
@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject UserManager<User> UserManager

@{
    Layout = "_LayoutEmail.cshtml";
}

@{
    var settings = GeneralSettings.Value;
    var subject = Model?.Subject ?? Localizer["Welcome to {0}! Please confirm your email to get started.", settings.ApplicationName!].Value;
    var userName = Model?.UserName ?? UserManager.GetUserName(User);
    var confirmationLink = Model?.Url ?? throw new InvalidOperationException("Confirmation link cannot be null.");
}

@section preheader {
    @Localizer[$"Welcome to {0}! Please confirm your email to get started.", settings.ApplicationName!]
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-weight:normal">
        @subject
    </h1>
}

<p style="font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 12px;">
    @Localizer["Hi"] @(userName ?? string.Empty),
    <br />
    <br />
    @Localizer["Welcome to {0}! We’re excited to have you on board.", settings.ApplicationName!]
    <br />
    <br />
    @Localizer["To complete your registration, please confirm your email address by clicking"]
    <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@confirmationLink">@Localizer["here"]</a>.
    <br />
    <br />
    @Localizer["If you did not create an account, you can safely ignore this email."]
    <br />
    <br />
    @Localizer["Thank you for joining!"]
    <br />
    <br />
    @Localizer["Sincerely"],<br />
    @Localizer[settings.Organization!]
</p>