@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject UserManager<User> UserManager
@inject IdentityUILocalizer Localizer


@{
    Layout = "_LayoutEmail.cshtml";
}

@{
    var settings = GeneralSettings.Value;
    var subject = Model?.Subject ?? Localizer.EmailRegister_Subject(settings.ApplicationName!);
    var userName = Model?.UserName ?? UserManager.GetUserName(User);
    var confirmationLink = Model?.Url ?? throw new InvalidOperationException("Confirmation link cannot be null.");
}

@section preheader {
    @Localizer.EmailRegister_Subject(settings.ApplicationName!)
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-weight:normal">
        @subject
    </h1>
}

<p style="font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 12px;">
    @Localizer.EmailRegister_Body_Hi @(userName ?? string.Empty),
    <br />
    <br />
    @Localizer.EmailRegister_Body_Welcome(settings.ApplicationName!)
    <br />
    <br />
    @if (!UIOptions.Value.AutomaticSigninAfterRegister)
    {
        @Localizer.EmailRegister_Body_ConfirmEmail
        <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@confirmationLink">@Localizer.Email_Preheader_Here</a>
        <br />
        <br />
    }
    @Localizer.EmailRegister_Body_IgnoreNotice
    <br />
    <br />
    @Localizer.EmailRegister_Body_Thanks
    <br />
    <br />
    @Localizer.Email_Body_Sincerely,<br />
    @Localizer.Email_Body_Organization(settings.Organization!)
</p>