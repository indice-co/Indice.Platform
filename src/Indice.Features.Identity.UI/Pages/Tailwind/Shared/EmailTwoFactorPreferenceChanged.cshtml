@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject IdentityUILocalizer Localizer
@model Indice.Features.Identity.Core.Models.TwoFactorPreferenceChangedNotificationModel
@{
    Layout = "_LayoutEmail.cshtml";
    var settings = GeneralSettings.Value;
}

@section preheader {
    @Localizer.EmailTwoFactorPreferenceChanged_Preheader
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif, Helvetica, Arial, sans-serif; font-weight:normal">
        @(Model.Subject ?? Localizer.EmailTwoFactorPreferenceChanged_Subject.Value)
    </h1>
}
<p style="font-family: 'Century Gothic', Arial, sans-serif, Helvetica, Arial, sans-serif; font-size: 12px;">
    @Localizer.EmailTwoFactorPreferenceChanged_Body_Hi @(Model.DisplayName ?? Model.UserName ?? string.Empty),
    <br /><br />
    @Localizer.EmailTwoFactorPreferenceChanged_Body_EventOccurred<br /><br />
    <strong>@Localizer.EmailTwoFactorPreferenceChanged_Body_EventDetails</strong><br />
    <ul>
        <li>@Localizer.EmailTwoFactorPreferenceChanged_Body_EventTime: @Model.TimeStamp.ToString()</li>
        <li>@Localizer.EmailTwoFactorPreferenceChanged_Body_Username: @Model.UserName</li>
        <li>@Localizer.EmailTwoFactorPreferenceChanged_Body_Email: @Model.User?.Email</li>
        <li>@Localizer.EmailTwoFactorPreferenceChanged_Body_AuthMethod: @Model.AuthenticationMethodCode</li>
    </ul>
</p>
<p style="font-family: 'Century Gothic', Arial, sans-serif, Helvetica, Arial, sans-serif; font-size: 12px;">
    @Localizer.EmailTwoFactorPreferenceChanged_Body_ContactSupport
    <br />
    <br />
    @Localizer.Email_Body_Sincerely,
    <br />
    <br />
    @Localizer.Email_Body_Organization_Signature(settings.Organization!)
</p>
