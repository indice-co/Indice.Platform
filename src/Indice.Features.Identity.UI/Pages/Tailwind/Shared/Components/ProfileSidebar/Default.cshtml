@inject IdentityUILocalizer Localizer

@model ProfileViewModel

@{
    ViewData["Title"] = Localizer.Profile_PageTitle;
	var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
	var langSuffix = (lang == "el") ? ".el" : string.Empty;
	var alert = TempData.Get<AlertModel>("Alert");
}
<div class="tab-panel"
	 id="profile"
	 role="tabpanel"
	 aria-labelledby="profile-tab">
	<h3 class="text-black mb-1">@Localizer.Profile_Manage_Profile</h3>
	<div class="overflow-y-scroll">
		<partial name="_Alert" model="alert" />
		<partial name="_ValidationSummary" />
		<div class="row">
        @if (Model.ShowFullName)
        {
                <div class="input-group-w-full flex flex-col mb-3">
                    <span>@Model.LastName @Model.FirstName</span>
                    <label>@Localizer.Profile_FullName</label>
                </div>
        }
        else
        {
			<div class="input-group flex flex-col mb-3">
				<span>@Model.FirstName</span>
				<label>@Localizer.Profile_First_Name</label>
			</div>
			<div class="input-group flex flex-col mb-3">
				<span>@Model.LastName</span>
				<label>@Localizer.Profile_Last_Name</label>
			</div>
        }
		</div>
		<div class="row">
			<div class="input-group flex flex-col mb-3">
				<span>@Model.UserName</span>
				<label>@Localizer.Profile_Username</label>
			</div>
			<div class="input-group flex flex-col mb-3">
				<a indice-if="Model.EmailChangePending" href="#" id="resend-email-link" style="font-size: x-small;">(@Localizer.Profile_Confirmation)</a>
				<span>@Model.Email</span>
				<label> @Localizer.Email</label>
			</div>
		</div>
		<div class="row">
			<div class="input-group flex flex-col">
				<span>@Model.PhoneNumber</span>
				<label>@Localizer.Profile_Phone_Number</label>
			</div>
		</div>
		<div class="row">
			<div class="input-group flex flex-col mb-3">
				<span>@(!string.IsNullOrWhiteSpace(Model.Tin) ? Model.Tin : '-')</span>
				<label>@Localizer.Profile_Tax_Identification</label>
			</div>
			<div class="input-group flex flex-col mb-3">
				<span>@(Model.BirthDate.HasValue? Model.BirthDate: '-')</span>
				<label>@Localizer.Profile_Birth_Date</label>
			</div>
		</div>
		<div indice-if="Model.HasDeveloperTotp" class="row">
			<div class="input-group flex flex-col mb-3">
				<span>@Model.DeveloperTotp</span>
				<label>@Localizer.Profile_Developer_TOTP</label>
			</div>
		</div>
		<div class="m-auto">
			<hr>
			<h3 class="text-black mb-1">@Localizer.Profile_Preferences</h3>
			<div class="input-group flex flex-col mb-3">
				<span>@Model.Locale</span>
				<label>@Localizer.Profile_Language</label>
			</div>
		</div>
		<div class="m-auto" indice-if="Model.CurrentLogins?.Count > 0 || Model.OtherLogins?.Count > 0">
			<hr>
			<h3 class="text-black mb-1">@Localizer.Profile_External_Providers</h3>
			@{
				var alertProviders = TempData.Get<AlertModel>("AlertProviders");
			}
			<partial name="_Alert" model="alertProviders" />
			@if (Model.CurrentLogins?.Count > 0)
			{
				<p class="text-sm">@Localizer.Profile_Existing_Providers</p>
				<div class="row pb-5 mt-5">
					@foreach (var provider in Model.CurrentLogins)
					{
						<div class="idp-@provider.LoginProvider.ToLower() col-span-6">
							<a class="no-underline cursor-pointer"></a>
						</div>
					}
				</div>
			}
			@if (Model.OtherLogins?.Count > 0)
			{
				<p class="text-sm">@Localizer.Profile_Connect_A_New_Provider</p>
				<div class="flex justify-start pb-5 mt-5">

					@foreach (var provider in Model.OtherLogins)
					{
						<div class="idp-@provider.Name.ToLower() mx-2.5">
							<a asp-page="/Profile" asp-page-handler="LinkLogin" asp-route-provider="@provider.Name">
							</a>
						</div>
					}
				</div>
			}
		</div>
	</div>
</div>