@page "/confirm-email"

@model BaseConfirmEmailModel

@inject IdentityUILocalizer Localizer

@{
    var title = ViewData["Title"] = Localizer.ConfirmEmail_PageTitle;
}

<div class="content-wrapper">
    <div class="card-wrapper">
        <vc:page-heading title="@Localizer.ConfirmEmail_PageHeader" image-src="" />
        @if (Model.View.AlreadyVerified)
        {
            <h1>
                <span class="header-text">@Localizer.ConfirmEmail_PageHeader</span>
            </h1>
            <p>
                <span indice-if="Model.View.HasReturnUrl">
                    @Localizer.ConfirmEmail_Click
                    <a href="@Model.View.ReturnUrl">@Localizer.ConfirmEmail_Here</a>
                    @Localizer.ConfirmEmail_To_Sign_In_Or_Go_Back
                </span>
                @Localizer.ConfirmEmailChange_You_Can_Now_Close_This_Browse_Window
            </p>
        }
        else if (Model.View.InvalidOrExpiredToken)
        {
            <h1>
                <span class="header-text">@Localizer.ConfirmEmail_Email_Verification_Link_Has_Expired</span>
            </h1>
            <p>
                @Localizer.ConfirmEmail_Please_Log_In_And_Resend_The_Link
                <a indice-if="Model.View.HasReturnUrl" href="@Model.View.ReturnUrl">@Localizer.ConfirmEmail_Here</a>
            </p>
        }
        else if (Model.View.Verified)
        {
            <h1>
                <span class="header-text">@Localizer.ConfirmEmail_Your_Email_Has_Been_Successfully_Confirmed</span>
            </h1>
            <p>
                <span indice-if="Model.View.HasReturnUrl">
                    @Localizer.ConfirmEmail_Click
                    <a href="@Model.View.ReturnUrl">@Localizer.ConfirmEmail_Here</a>
                    @Localizer.ConfirmEmail_To_Sign_In_Or_Go_Back
                </span>
                @Localizer.ConfirmEmail_You_Can_Now_Close_This_Browse_Window
            </p>
        }
        else if (!ViewContext.ModelState.IsValid)
        {
            <h1>
                <span class="header-text">@Localizer.ConfirmEmail_No_Action_Was_Taken</span>
            </h1>
            <p>
                @Localizer.ConfirmEmail_If_You_Feel_You_Got_This_Error_By_Mistake_Simply_Click
                <a asp-page="/Home">@Localizer.ConfirmEmail_Here</a>
                @Localizer.ConfirmEmail_To_Sign_In_Or_Go_Back
            </p>
        }
        else
        {
            <h1>
                <span class="header-text">@Localizer.ConfirmEmail_Verifying_Your_Email</span>
            </h1>
            <p>
                @Localizer.ConfirmEmail_This_May_Take_A_Moment_Click_On_The_Link_Below_To_Verify_Your_Email_Address
                <strong>@Model.View.Email</strong>
            </p>
            <form name="EmailVerificationForm" method="post" asp-route-client_id="@Model.Input.ClientId">
                <input type="hidden" asp-for="Input.UserId" />
                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.ClientId" />
                <input type="hidden" asp-for="Input.ReturnUrl" />
                <input type="hidden" asp-for="Input.ShouldRedirect" />
                <input type="hidden" asp-for="Input.ThrowWhenConfirmed" />
                <button type="submit" class="btn btn-primary">@Localizer.ConfirmEmail_Verify</button>
            </form>
            <script type="text/javascript" csp-nonce="true">
                function submitform() {
                    document.forms["EmailVerificationForm"].submit();
                }
                window.onload = submitform;
            </script>
        }
    </div>
</div>
