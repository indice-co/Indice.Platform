@page "/logout"

@model BaseLogoutModel
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.Logout_PageTitle;
}

<section class="auth-card auth-card--message">
    <vc:page-heading title="@Localizer.Logout_PageHeader" subtitle="@Localizer.Logout_Would_You_Like_To_Logout" image-src="" />
    <form asp-page="/Logout" class="auth-form">
        <input type="hidden" name="logoutId" value="@Model.LogoutId" />
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit">@Localizer.Logout_Yes</button>
        </div>
    </form>
</section>
