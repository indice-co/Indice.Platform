@page "/login/mfa/onboarding/add-email"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login/mfa/onboarding/add-email")]

@model BaseMfaOnboardingAddEmailModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer


@{
    ViewBag.Title = Localizer.MfaOnBoardingAddEmail_PageTitle;
    var alert = TempData.Peek<AlertModel>(BaseMfaOnboardingAddEmailModel.TempDataKey);
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.MfaOnBoardingAddEmail_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="alert" />
    <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate class="auth-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="field">
            <label asp-for="Input.Email" class="field__label">@Localizer.MfaOnBoardingAddEmail_Email</label>
            <input type="hidden" data-env="@HostingEnvironment.EnvironmentName" />
            <input class="form-control field__control" type="email" placeholder="@Localizer.MfaOnBoardingAddEmail_Email" asp-for="Input.Email" readonly="@Model.View.DisableEmailInput" autocomplete="email" aria-describedby="Input_Email-error" />
            <span asp-validation-for="Input.Email" class="field__error" id="Input_Email-error"></span>
        </div>
        <div class="auth-form__actions">
            @if (!string.IsNullOrEmpty(Model.View.NextStepUrl))
            {
                <a class="btn btn-primary auth-form__submit" href="@Model.View.NextStepUrl">@Localizer.MfaOnBoardingAddEmail_Next</a>
            }
            else
            {
                <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.MfaOnBoardingAddEmail_Save</button>
            }
        </div>
        <a asp-page="/MfaOnboarding" class="mfa__back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @Localizer.Mfa_Back
        </a>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
