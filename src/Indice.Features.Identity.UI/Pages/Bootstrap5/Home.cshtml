@page "/"

@model BaseHomeModel

@inject GeneralSettings Settings
@inject IWebHostEnvironment Environment
@inject IdentityLabelsMessageDescriber Labels

@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var langSuffix = (lang == "el") ? ".el" : string.Empty;
}

<h1 class="text-center display-4 p-sm-2 p-md-3 p-lg-4">
    @Labels.Home_WelcomeDigitalServices(Settings.Organization!)
</h1>
<section class="border-0 identity-panel">
    <article class="text-center">
        <div class="header-logo d-xs-block d-sm-block d-md-none pb-5">
            <img class="img-fluid" src="/img/logo@(langSuffix).svg" />
        </div>
        @if (!User.IsAuthenticated())
        {
            <div class="section text-start" id="welcome-to-identity">
                <p class="lead">
                    @Html.Raw(Labels.Home_WelcomeDigitalServices(Settings.Organization!))
                </p>
            </div>
            <partial name="_ServiceDeck" model="Model.Services" />
            <p class="lead" indice-if="@Environment.IsDevelopment()">
                @Labels.Home_Please_Login_To_The_Application <a asp-page="/Login">@Labels.Home_Here</a>.
            </p>
        }
        else
        {
            <h3 class="py-5">
                @Labels.Home_Welcome_Back@User.FindDisplayName().
            </h3>
            <div class="section text-start" id="welcome-to-identity">
                <p class="lead">@Labels.Home_IntroTextWithOrgName(Settings.Organization!) </p>
            </div>
            <partial name="_ServiceDeck" model="Model.Services" />
            <div class="paragraph-block text-start">
                <h4>@Labels.Home_Manage_Your_Grants</h4>
                <p class="lead">
                    @Labels.Home_Check_And_Revoke_Your <a asp-page="/Grants" class="reference external">@Labels.Home_Authorized_Applications</a>
                </p>
            </div>
        }
    </article>
</section>
<div id="stars"></div>
<div id="stars2"></div>
<div id="stars3"></div>
