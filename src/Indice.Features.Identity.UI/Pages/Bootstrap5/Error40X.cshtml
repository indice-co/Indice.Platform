@page "/{statusCode:range(400,404)}"

@inject IdentityUILocalizer Localizer

@model BaseError40XModel

@{
    ViewData["Title"] = Localizer.Error_PageTitle;
    var error = Model.ErrorMessages.GetValueOrDefault(Model.ErrorStatusCode.GetValueOrDefault());
}

<section class="auth-card auth-card--message error-page">
    <p class="error-page__code" aria-hidden="true">@Model.ErrorStatusCode</p>
    <h1 class="auth-card__title">
        <span class="visually-hidden">@Model.ErrorStatusCode</span>
        @(!string.IsNullOrEmpty(error?.Title) ? error!.Title : Localizer.Error_PageHeader.Value)
    </h1>
    <p indice-if="!string.IsNullOrEmpty(error?.Message)" class="auth-card__text">@error!.Message</p>
    <div class="auth-form__actions">
        <a class="btn btn-primary auth-form__submit" asp-page="/Home">@Localizer.Error_Go_back_home</a>
    </div>
</section>
