@page "/login/add-phone"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login/add-phone")]
@model BaseAddPhoneModel

@inject IWebHostEnvironment HostingEnvironment
@inject CallingCodesProvider callingCodesProvider
@inject IOptions<IdentityUIOptions> identityUiOptions


@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.AddPhone_PageTitle;
    var alert = TempData.Peek<AlertModel>(BaseAddPhoneModel.TempDataKey);
}

<section class="auth-card">
    <vc:page-heading title="@Localizer.AddPhone_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" class="auth-form">
        <div class="field" indice-if="identityUiOptions.Value.EnablePhoneNumberCallingCodes">
            <label asp-for="Input.CallingCode" class="field__label">@Localizer.AddPhone_CallingCode</label>
            <select class="form-select field__control" asp-for="Input.CallingCode" required aria-describedby="Input_CallingCode-error">
                <option value="" selected>@Localizer.Profile_Choose</option>
                @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                {
                    <option value="@callingCode">@callingCode.DisplayName</option>
                }
            </select>
            <span asp-validation-for="Input.CallingCode" class="field__error" id="Input_CallingCode-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.PhoneNumber" class="field__label">@Localizer.AddPhone_PhoneNumber</label>
            <input type="hidden" data-env="@HostingEnvironment.EnvironmentName" />
            <input class="form-control field__control" type="tel" placeholder="@Localizer.AddPhone_PhoneNumber" asp-for="Input.PhoneNumber" autocomplete="tel" aria-describedby="Input_PhoneNumberWithCallingCode-error" />
            <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="field__error" id="Input_PhoneNumberWithCallingCode-error"></span>
        </div>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.AddPhone_Save</button>
        </div>
        <input type="hidden" asp-for="Input.ReturnUrl" />
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
