@page "/register"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("register")]

@model BaseRegisterModel

@inject ExtendedUserManager<User> userManager
@inject CallingCodesProvider callingCodesProvider
@inject IOptions<IdentityUIOptions> identityUiOptions
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.Register_PageTitle;
}

<section class="sign-up m-auto">
    <vc:page-heading title="@Localizer.Register_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    @if (Model.View.VisibleExternalProviders.Any())
    {
        <div class="login-form">
            <ul class="list-unstyled">
                @foreach (var provider in Model.View.VisibleExternalProviders)
                {
                    <li class="idp idp-@provider.AuthenticationScheme!.ToLower()">
                        <a class="btn btn-@provider.AuthenticationScheme.ToLower() btn-hover" asp-page="/Challenge" asp-route-provider="@provider.AuthenticationScheme" asp-route-returnUrl="@Model.View.ReturnUrl" asp-route-prompt="@OidcConstants.PromptModes.SelectAccount">
                            @Localizer.GetGeneric(provider.DisplayName!)
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="hr-sect">@Localizer.Register_OR</div>
    }
    <form asp-route-returnUrl="@Model.View.ReturnUrl" data-sbind="event: { change: formChanged }" method="post" autocomplete="new-password" novalidate id="registerForm">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.FirstName" class="form-label">@Localizer.Register_First_Name</label>
                    <input class="form-control" type="text" asp-for="Input.FirstName" placeholder="@Localizer.Register_First_Name" autofocus />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label">@Localizer.Register_Last_Name</label>
                    <input class="form-control" type="text" asp-for="Input.LastName" placeholder="@Localizer.Register_Last_Name" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>
        </div>
        @if (!userManager.EmailAsUserName || !identityUiOptions.Value.EnablePhoneNumberCallingCodes)
        {
            <div class="row">
                <div indice-if="!userManager.EmailAsUserName" class="@(identityUiOptions.Value.EnablePhoneNumberCallingCodes ? "col-md-12" : "col-md-6")">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">@Localizer.Email</label>
                        <input class="form-control" type="text" asp-for="Input.Email" placeholder="@Localizer.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>
                <div indice-if="!identityUiOptions.Value.EnablePhoneNumberCallingCodes" class="@(userManager.EmailAsUserName ? "col-md-12" : "col-md-6")">
                    <div class="mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label">@Localizer.Register_Phone_number</label>
                        <input class="form-control" type="text" asp-for="Input.PhoneNumber" placeholder="@Localizer.Register_Phone_number" />
                        <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }
        <div indice-if="identityUiOptions.Value.EnablePhoneNumberCallingCodes" class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.CallingCode">@Localizer.Register_Calling_Code</label>
                    <select class="form-control lh-lg" asp-for="Input.CallingCode" required>
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                        {
                            <option value="@callingCode">@callingCode.DisplayName</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CallingCode" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label">@Localizer.Register_Phone_number]</label>
                    <input class="form-control" type="text" asp-for="Input.PhoneNumber" placeholder="@Localizer.Register_Phone_number]" />
                    <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
                </div>
            </div>
        </div>
        @if (userManager.EmailAsUserName)
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <hr>
                        <div>
                            <p>
                                @Localizer.Register_Choose_An_Email_And_A_Password
                                <br><br>
                                @Localizer.Register_Credentials_Notice
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">@Localizer.Email</label>
                        <input class="form-control" type="text" asp-for="Input.Email" placeholder="@Localizer.Email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <hr>
                        <div>
                            <p>
                                @Localizer.Register_Choose_A_Username_And_A_Password
                                <br><br>
                                @Localizer.Register_Credentials_Notice
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label asp-for="Input.UserName" class="form-label">@Localizer.Register_Username</label>
                        <input class="form-control" type="text" asp-for="Input.UserName" placeholder="@Localizer.Register_Username" autocomplete="off" />
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">@Localizer.Register_Password</label>
                    <div class="password-control">
                        <input class="form-control password" type="password" placeholder="@Localizer.Register_Password" data-sbind="event: { keyup: passwordChanged }" asp-for="Input.Password" autocomplete="new-password" />
                        <i role="button" class="reveal-icon" aria-label="Show password" title="Show password" aria-pressed="false"></i>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div id="password-rules" class="password-rules col-md-12">
                <ul data-sbind="foreach: passwordRules">
                    <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                </ul>
            </div>
        </div>
        @if (identityUiOptions.Value.ShowConfirmationPassword)
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label asp-for="Input.PasswordConfirmation" class="form-label">@Localizer.Register_Password_Confirmation</label>
                        <div class="password-control">
                            <input class="form-control password" type="password" placeholder="@Localizer.Register_Password_Confirmation" asp-for="Input.PasswordConfirmation" autocomplete="new-password" />
                            <i role="button" class="reveal-icon" aria-label="Show password" title="Show password" aria-pressed="false"></i>
                        </div>
                        <span asp-validation-for="Input.PasswordConfirmation" class="text-danger"></span>
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label class="checkbox">
                        <input asp-for="Input.HasAcceptedTerms" type="checkbox" />
                        @Localizer.Register_I_Have_Read_And_Accept_Terms()
                    </label>
                    <span asp-validation-for="Input.HasAcceptedTerms" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label class="checkbox">
                        <input asp-for="Input.HasReadPrivacyPolicy" type="checkbox" />
                        @Localizer.Register_I_Consent_To_Registration()
                    </label>
                    <span asp-validation-for="Input.HasReadPrivacyPolicy" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label class="checkbox">
                        <input asp-for="Input.HasConsentedToCommercialCommunications" type="checkbox" />
                        @Localizer.Register_I_Consent_To_Contact_Usage
                    </label>
                    <span asp-validation-for="Input.HasConsentedToCommercialCommunications" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <partial name="_Recaptcha" model='new RecaptchaViewModel { FormId = "registerForm", ButtonId = "submitButton", Action = "register" }' />
            </div>
        </div>
        <div class="row align-items-center">
            <div class="col-md-6 col-12">
                <div class="mb-3">
                    <a class="btn btn-link w-100" asp-page="/Login" asp-route-returnUrl="@Model.View.ReturnUrl">@Localizer.Register_Already_Have_An_Account</a>
                </div>
            </div>
            <div class="col-md-6 col-12">
                <div class="mb-3">
                    <button class="btn btn-primary w-100" id="submitButton" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Localizer.Register_Join_Us</button>
                </div>
            </div>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/reveal-password.js" csp-nonce="true"></script>
    <script csp-nonce="true">
        document.querySelectorAll('.idp a').forEach(function (el) {
        el.onclick = function (link) {
        if (!link.target.classList.contains('disabled')) {
        link.target.classList.add('disabled');
        }
        };
        });
    </script>
}
