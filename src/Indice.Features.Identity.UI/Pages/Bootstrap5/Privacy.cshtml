@page "/privacy"

@model BasePrivacyModel
@inject IdentityUILocalizer Localizer

@{
    ViewData["body-css-class"] = "article-page";
    ViewData["Title"] = Localizer.Privacy_PageTitle;
}

<article class="p-0 py-md-4 px-md-5">
    <vc:page-heading title="@Localizer.Privacy_PageHeader" image-src="" />
    <md path="@Model.View.MarkdownPath" class="markdown-body"></md>
</article>