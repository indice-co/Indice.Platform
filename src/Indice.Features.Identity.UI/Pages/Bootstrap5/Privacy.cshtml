@page "/privacy"

@model BasePrivacyModel
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.Privacy_PageTitle;
    ViewData["Shell"] = "article";
}

<article class="article-card">
    <header class="article-card__header">
        <h1 class="article-card__title">@Localizer.Privacy_PageHeader</h1>
    </header>
    <md path="@Model.View.MarkdownPath" class="article-card__body markdown-body"></md>
</article>
