@page "/manage/profile"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("manage/profile")]

@inject CallingCodesProvider callingCodesProvider
@inject IZoneInfoProvider zoneInfoProvider
@inject IOptions<IdentityUIOptions> identityUiOptions
@inject ExtendedUserManager<User> userManager
@inject IdentityUILocalizer Localizer

@model BaseProfileModel

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = Localizer.Profile_PageTitle;
    var alert = TempData.Get<AlertModel>("Alert");
    var options = identityUiOptions.Value;
    var maxMb = Math.Round(options.PictureUploadSizeLimit / 1024d / 1024d, 1);
    var alertProviders = TempData.Get<AlertModel>("AlertProviders");
}

<div id="send-confirmation-success" class="alert alert-success d-none" role="status">
    @Localizer.Profile_A_Confirmation_Email_Has_Been_Sent_To(Model.View.Email ?? throw new InvalidOperationException("User email cannot be null."))
</div>
<div id="send-confirmation-error" class="alert alert-danger d-none" role="alert">
    @Localizer.Profile_Confirmation_Email_Delivery_Failed_Please_Contact_System_Administrator
</div>
@if (Model.ProfileSuccessfullyChanged)
{
    var message = Localizer.Profile_Your_Profile_Was_Updated_Successfully.Value!;
    if (Model.EmailChangeRequested)
    {
        message += Localizer.Profile_EmailSentToNewEmail.Value;
    }
    <partial name="_Alert" model="@AlertModel.Success(message)" />
}
@if (Model.View.EmailChangePending && !Model.ProfileSuccessfullyChanged)
{
    <partial name="_Alert" model="@AlertModel.Warn(Localizer.Profile_Your_New_Email_Verification_Is_Still_Pending.ToString())" />
}
<partial name="_Alert" model="alert" />
<partial name="_ValidationSummary" />

@* ---- Profile photo (own form: multipart upload) ---- *@
<section class="data-card">
    <header class="data-card__header">
        <h1 class="data-card__title">@Localizer.Profile_Photo</h1>
    </header>
    <form asp-page-handler="UploadPicture" enctype="multipart/form-data" method="post" class="avatar-upload">
        <label class="avatar-upload__control" for="profile_picture">
            <img class="avatar avatar--lg" profile-pic="128" profile-display-name="@Model.Input.DisplayName" profile-pic-background="cecece" alt="" />
            <span class="avatar-upload__cta"><i class="fa-solid fa-camera" aria-hidden="true"></i> @Localizer.Profile_PhotoUpload</span>
        </label>
        <input type="file" id="profile_picture" name="file" accept="image/*" class="avatar-upload__input" aria-describedby="profile_picture-help" />
        <div class="avatar-upload__text">
            <p class="avatar-upload__name">@Model.Input.DisplayName</p>
            <p class="avatar-upload__help">@Localizer.Profile_PhotoHelp</p>
            <p class="avatar-upload__constraints" id="profile_picture-help">@Localizer.Profile_PhotoConstraints(maxMb, options.PictureMaxSideSize)</p>
        </div>
    </form>
    <script csp-nonce="true">
        var fileInput = document.getElementById('profile_picture');
        fileInput.addEventListener('change', function () {
            fileInput.closest('form').submit();
        });
    </script>
</section>

@* ---- Account details: each field is updated separately through its own handler ---- *@
@{
    var canEditUserName = !(options.DisableEmailEdit || userManager.EmailAsUserName);
    var canEditEmail = !options.DisableEmailEdit;
    var canEditPhone = !options.DisablePhoneEdit;
    var phoneDisplay = string.IsNullOrWhiteSpace(Model.View.PhoneNumber) ? null : (options.EnablePhoneNumberCallingCodes && !string.IsNullOrWhiteSpace(Model.View.CallingCode) && !Model.View.PhoneNumber.StartsWith("+") ? $"+{Model.View.CallingCode} {Model.View.PhoneNumber}" : Model.View.PhoneNumber);
}
<section class="data-card">
    <header class="data-card__header">
        <h2 class="data-card__title">@Localizer.Profile_AccountDetails</h2>
        <p class="data-card__meta">
            @if (Model.View.CreateDate.HasValue)
            {
                <span>@Localizer.Profile_AccountCreated(Model.View.CreateDate.Value.ToLocalTime().ToString("d"))</span>
            }
            @if (Model.View.LastSignInDate.HasValue)
            {
                <span class="data-card__meta-separator" aria-hidden="true">|</span>
                <span>@Localizer.Profile_LastLogin(Model.View.LastSignInDate.Value.ToLocalTime().ToString("g"))</span>
            }
        </p>
    </header>
    <div class="account-rows">
        <form method="post" asp-page-handler="UpdateEmail" class="account-row @(Model.View.EditingField == "Email" ? "account-row--editing" : null)">
            <label asp-for="Input.Email" class="account-row__label">
                @Localizer.Email
                <a indice-if="Model.View.EmailChangePending" href="#" id="resend-email-link" class="field__label-action">(@Localizer.Profile_Confirmation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>)</a>
            </label>
            <span class="account-row__value">@Model.View.Email</span>
            <button indice-if="canEditEmail" type="button" class="account-row__toggle" aria-label="@Localizer.Profile_Edit @Localizer.Email"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button>
            <div indice-if="canEditEmail" class="account-row__edit">
                <input class="form-control field__control" type="email" placeholder="@Localizer.Email" asp-for="Input.Email" autocomplete="email" aria-describedby="Input_Email-error" />
                <span asp-validation-for="Input.Email" class="field__error" id="Input_Email-error"></span>
                <div class="account-row__actions">
                    <button type="button" class="btn btn-outline-secondary account-row__cancel">@Localizer.Profile_Cancel</button>
                    <button type="submit" class="btn btn-primary">@Localizer.Profile_Save</button>
                </div>
            </div>
        </form>
        <form method="post" asp-page-handler="UpdatePhone" class="account-row @(Model.View.EditingField == "Phone" ? "account-row--editing" : null)">
            <label asp-for="Input.PhoneNumber" class="account-row__label">@Localizer.Profile_Phone_Number</label>
            <span class="account-row__value">@phoneDisplay</span>
            <button indice-if="canEditPhone" type="button" class="account-row__toggle" aria-label="@Localizer.Profile_Edit @Localizer.Profile_Phone_Number"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button>
            <div indice-if="canEditPhone" class="account-row__edit">
                <div indice-if="options.EnablePhoneNumberCallingCodes" class="field">
                    <label class="field__label" asp-for="Input.CallingCode">@Localizer.Profile_Calling_Code</label>
                    <select class="form-select field__control" asp-for="Input.CallingCode" required aria-describedby="Input_CallingCode-error">
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                        {
                            <option value="@callingCode" selected="@(callingCode.Code == Model.Input.CallingCode)">@callingCode.DisplayName</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CallingCode" class="field__error" id="Input_CallingCode-error"></span>
                </div>
                <input class="form-control field__control" type="tel" placeholder="@Localizer.Profile_Phone_Number" asp-for="Input.PhoneNumber" autocomplete="tel" aria-describedby="Input_PhoneNumberWithCallingCode-error" />
                <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="field__error" id="Input_PhoneNumberWithCallingCode-error"></span>
                <div class="account-row__actions">
                    <button type="button" class="btn btn-outline-secondary account-row__cancel">@Localizer.Profile_Cancel</button>
                    <button type="submit" class="btn btn-primary">@Localizer.Profile_Save</button>
                </div>
            </div>
        </form>
        <form method="post" asp-page-handler="UpdateUserName" class="account-row @(Model.View.EditingField == "UserName" ? "account-row--editing" : null)">
            <label asp-for="Input.UserName" class="account-row__label">@Localizer.Profile_Username</label>
            <span class="account-row__value">@Model.View.UserName</span>
            <button indice-if="canEditUserName" type="button" class="account-row__toggle" aria-label="@Localizer.Profile_Edit @Localizer.Profile_Username"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button>
            <div indice-if="canEditUserName" class="account-row__edit">
                <input class="form-control field__control" type="text" placeholder="@Localizer.Profile_Username" asp-for="Input.UserName" autocomplete="username" aria-describedby="Input_UserName-error" />
                <span asp-validation-for="Input.UserName" class="field__error" id="Input_UserName-error"></span>
                <div class="account-row__actions">
                    <button type="button" class="btn btn-outline-secondary account-row__cancel">@Localizer.Profile_Cancel</button>
                    <button type="submit" class="btn btn-primary">@Localizer.Profile_Save</button>
                </div>
            </div>
        </form>
    </div>
</section>

@* ---- Profile details ---- *@
<form method="post" class="profile-form">
    <section class="data-card">
        <header class="data-card__header">
            <h2 class="data-card__title">@Localizer.Profile_DetailsSection</h2>
        </header>
        <div class="data-card__grid">
            @if (Model.View.ShowFullName)
            {
                <div class="field data-card__span">
                    <label class="field__label" for="Input_FullName">@Localizer.Profile_FullName</label>
                    <input class="form-control field__control" id="Input_FullName" type="text" placeholder="@Localizer.Profile_FullName" value="@Model.Input.LastName @Model.Input.FirstName" readonly="readonly" />
                    <input class="form-control" type="hidden" asp-for="Input.FirstName" />
                    <input class="form-control" type="hidden" asp-for="Input.LastName" />
                </div>
            }
            else
            {
                <div class="field">
                    <label asp-for="Input.FirstName" class="field__label">@Localizer.Profile_First_Name</label>
                    <input class="form-control field__control" type="text" placeholder="@Localizer.Profile_First_Name" asp-for="Input.FirstName" readonly="@Model.View.DisableEditGivenName" autocomplete="given-name" aria-describedby="Input_FirstName-error" />
                    <span asp-validation-for="Input.FirstName" class="field__error" id="Input_FirstName-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.LastName" class="field__label">@Localizer.Profile_Last_Name</label>
                    <input class="form-control field__control" type="text" placeholder="@Localizer.Profile_Last_Name" asp-for="Input.LastName" readonly="@Model.View.DisableEditFamilyName" autocomplete="family-name" aria-describedby="Input_LastName-error" />
                    <span asp-validation-for="Input.LastName" class="field__error" id="Input_LastName-error"></span>
                </div>
            }
            <div class="field">
                <label asp-for="Input.Tin" class="field__label">@Localizer.Profile_Tax_Identification</label>
                <input class="form-control field__control" type="text" placeholder="@Localizer.Profile_Tax_Identification" readonly="@Model.View.DisableEditTin" asp-for="Input.Tin" aria-describedby="Input_Tin-error" />
                <span asp-validation-for="Input.Tin" class="field__error" id="Input_Tin-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.BirthDate" class="field__label">@Localizer.Profile_Birth_Date</label>
                <input class="form-control field__control" type="date" placeholder="@Localizer.Profile_Birth_Date" asp-for="Input.BirthDate" autocomplete="bday" aria-describedby="Input_BirthDate-error" />
                <span asp-validation-for="Input.BirthDate" class="field__error" id="Input_BirthDate-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ZoneInfo" class="field__label">@Localizer.Profile_Timezone</label>
                <select class="form-select field__control" asp-for="Input.ZoneInfo" aria-describedby="Input_ZoneInfo-error">
                    <option value="">@Localizer.Profile_Choose</option>
                    @foreach (var timezone in zoneInfoProvider.GetTimeZones())
                    {
                        <option value="@timezone.Id">@timezone.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="Input.ZoneInfo" class="field__error" id="Input_ZoneInfo-error"></span>
            </div>
            <div class="field" indice-if="Model.View.HasDeveloperTotp">
                <label asp-for="Input.DeveloperTotp" class="field__label">@Localizer.Profile_Developer_TOTP</label>
                <input class="form-control field__control" type="text" placeholder="@Localizer.Profile_Developer_TOTP" readonly="readonly" asp-for="Input.DeveloperTotp" />
            </div>
        </div>
        <div class="form-check">
            <input asp-for="Input.ConsentCommercial" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="Input.ConsentCommercial">
                @Localizer.Profile_PrivacyPolicyConsent
                <a target="_blank" href="/privacy" onclick="event.stopPropagation();">@Localizer.Profile_Here.</a>
            </label>
        </div>
        <div class="data-card__actions">
            <button class="btn btn-primary" type="submit">@Localizer.Profile_Save</button>
        </div>
    </section>
</form>

@* ---- Preferences (own form: auto-submits on change) ---- *@
<section class="data-card" indice-if="Model.View.SupportedCultures.Count > 0">
    <header class="data-card__header">
        <h2 class="data-card__title">@Localizer.Profile_Preferences</h2>
    </header>
    <form id="userPreferenceForm" method="post" asp-page-handler="UpdateLanguagePreference">
        <div class="data-card__grid">
            <div class="field">
                <label asp-for="InputLanguagePreference.Locale" class="field__label">@Localizer.Profile_PreferredLanguage</label>
                <select class="form-select field__control" asp-for="InputLanguagePreference.Locale" required aria-describedby="InputLanguagePreference_Locale-error">
                    <option value="">@Localizer.Profile_Choose</option>
                    @foreach (var culture in Model.View.SupportedCultures)
                    {
                        <option value="@culture.TwoLetterISOLanguageName" selected="@(culture.TwoLetterISOLanguageName.Equals(Model.View.Locale))">@culture.TwoLetterISOLanguageName.ToUpperInvariant() - @culture.NativeName</option>
                    }
                </select>
                <span asp-validation-for="InputLanguagePreference.Locale" class="field__error" id="InputLanguagePreference_Locale-error"></span>
            </div>
        </div>
    </form>
</section>

@* ---- External providers ---- *@
<section class="data-card" indice-if="Model.View.CurrentLogins?.Count > 0 || Model.View.OtherLogins.Count > 0">
    <header class="data-card__header">
        <h2 class="data-card__title">@Localizer.Profile_External_Providers</h2>
    </header>
    <partial name="_Alert" model="alertProviders" />
    @if (Model.View.CurrentLogins.Count > 0)
    {
        <h3 class="data-card__subtitle">@Localizer.Profile_Existing_Providers</h3>
        <ul class="provider-rows">
            @foreach (var provider in Model.View.CurrentLogins)
            {
                var scheme = provider.LoginProvider.ToLower();
                <li class="provider-row provider-row--@scheme">
                    <span class="provider-row__name">
                        <span class="provider-logo provider-logo--@scheme" aria-hidden="true"></span>
                        @Localizer.GetGeneric(string.IsNullOrEmpty(provider.ProviderDisplayName) ? provider.LoginProvider : provider.ProviderDisplayName)
                    </span>
                    <form asp-page-handler="RemoveLogin" method="post" class="provider-row__form">
                        <input asp-for="InputLoginLink.LoginProvider" type="hidden" value="@provider.LoginProvider" />
                        <input asp-for="InputLoginLink.ProviderKey" type="hidden" value="@provider.ProviderKey" />
                        <button type="submit" class="provider-row__action remove-idp" disabled="@(!Model.View.CanRemoveProvider)">
                            <i class="fa-regular fa-circle-minus" aria-hidden="true"></i> @Localizer.Profile_Remove
                        </button>
                    </form>
                </li>
            }
        </ul>
    }
    @if (Model.View.OtherLogins.Count > 0)
    {
        <h3 class="data-card__subtitle">@Localizer.Profile_Connect_A_New_Provider</h3>
        <ul class="provider-list">
            @foreach (var provider in Model.View.OtherLogins)
            {
                var scheme = provider.Name.ToLower();
                <li class="provider-list__item">
                    <a class="btn provider-btn provider-btn--@scheme" title="@Localizer.GetGeneric(provider.DisplayName ?? "Unknown")" aria-label="@Localizer.GetGeneric(provider.DisplayName ?? "Unknown")" asp-page-handler="LinkLogin" asp-route-provider="@provider.Name">
                        <span class="provider-btn__logo" aria-hidden="true"></span>
                        <span class="provider-btn__label">@Localizer.GetGeneric(provider.DisplayName ?? "Unknown")</span>
                    </a>
                </li>
            }
        </ul>
    }
</section>

@section scripts {
    <script type="text/javascript" csp-nonce="true">
        $(document).ready(function () {
            $('#resend-email-link').click(function () {
                $.ajax({
                    url: '@Url.PageLink(pageName: "/ConfirmEmail", pageHandler: "Resend")',
                    type: 'GET',
                    dataType: 'json',
                    statusCode: {
                        204: function () {
                            $('#resend-email-link').addClass('disabled');
                            $('#send-confirmation-success').removeClass('d-none');
                        },
                        500: function () {
                            $('#send-confirmation-error').removeClass('d-none');
                        }
                    }
                });
            });
        });
    </script>
    <partial name="_ValidationScripts" />
    <script csp-nonce="true">
        document.querySelectorAll('.account-row').forEach(function (row) {
            var toggle = row.querySelector('.account-row__toggle');
            var cancel = row.querySelector('.account-row__cancel');
            if (!toggle) {
                return;
            }
            toggle.addEventListener('click', function () {
                row.classList.add('account-row--editing');
                var input = row.querySelector('.account-row__edit input, .account-row__edit select');
                if (input) {
                    input.focus();
                }
            });
            cancel.addEventListener('click', function () {
                row.reset();
                row.querySelectorAll('.field__error').forEach(function (el) { el.textContent = ''; });
                row.classList.remove('account-row--editing');
                toggle.focus();
            });
        });
    </script>
    <script csp-nonce="true">
        document.querySelectorAll('.provider-btn').forEach(function (el) {
            el.addEventListener('click', function () {
                if (!el.classList.contains('disabled')) {
                    el.classList.add('disabled');
                }
            });
        });
    </script>
    <script csp-nonce="true">
        document.querySelectorAll('#userPreferenceForm select').forEach(function (el) {
            el.addEventListener("change", function (select) {
                document.getElementById('userPreferenceForm').submit();
            });
        });
    </script>
}
