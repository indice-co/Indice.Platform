@page "/manage/email"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("manage/mfa-challenge")]

@model BaseChangeEmailModel

@inject IdentityUILocalizer Localizer

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = Localizer.ChangeEmail_PageTitle;
    var pendingEmail = Model.PendingEmail;
    var mfaChallenge = Model.MfaChallenge;
}

<section class="data-card data-card--form" inert="@(mfaChallenge is not null)">
    <a class="data-card__back" asp-page="/Profile">&larr; @Localizer.Mfa_Back</a>
    <header class="data-card__header">
        <h1 class="data-card__title">@Localizer.ChangeEmail_PageTitle</h1>
    </header>
    <partial name="_ValidationSummary" />
    <form method="post" class="auth-form" novalidate>
        <div class="field">
            <label asp-for="Input.Email" class="field__label">@Localizer.Email</label>
            <input class="form-control field__control" type="email" placeholder="@Localizer.Email" asp-for="Input.Email" value="@(Model.Input.Email ?? Model.CurrentEmail)" autocomplete="email" aria-describedby="Input_Email-error" autofocus />
            <span asp-validation-for="Input.Email" class="field__error" id="Input_Email-error"></span>
        </div>
        <div class="form-check">
            <input asp-for="PrivacyConsent" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="PrivacyConsent">
                @Localizer.Profile_PrivacyPolicyConsent
                <a target="_blank" href="/privacy">@Localizer.Profile_Here.</a>
            </label>
            <span asp-validation-for="PrivacyConsent" class="field__error"></span>
        </div>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.Profile_Save</button>
        </div>
    </form>
</section>

@if (pendingEmail is not null)
{
    <div class="verify-dialog" role="dialog" aria-modal="true" aria-labelledby="verify-dialog-title">
        <div class="verify-dialog__box">
            <a class="verify-dialog__close" asp-page="/Profile" aria-label="@Localizer.ChangeEmail_Close">&times;</a>
            <h2 class="verify-dialog__title" id="verify-dialog-title">@Localizer.ChangeEmail_VerifyTitle</h2>
            @if (!Model.UseOtp)
            {
                <p class="verify-dialog__text" data-email-poll-url="@Url.Page(null, "EmailStatus", new { email = pendingEmail })">@Localizer.ChangeEmail_VerifyLinkPrompt(pendingEmail)</p>
            }
            else
            {
                <p class="verify-dialog__text">@Localizer.ChangeEmail_VerifyOtpPrompt(pendingEmail)</p>
                <form method="post" asp-page-handler="Verify" class="auth-form" novalidate>
                    <input type="hidden" name="Input.Email" value="@pendingEmail" />
                    <div class="field">
                        <label for="Code" class="field__label">@Localizer.ChangeEmail_OtpCode</label>
                        <input class="form-control field__control otp-field__input" data-otp-length="6" type="text" inputmode="numeric" autocomplete="one-time-code" id="Code" name="Code" value="" aria-describedby="Code-error" autofocus />
                        <span asp-validation-for="Code" class="field__error" id="Code-error"></span>
                    </div>
                    <p class="otp-field__resend">
                        <button type="submit" id="otp-resend" name="otpResend" value="true" formnovalidate class="otp-field__resend-btn">
                            <span class="otp-field__resend-text">@Localizer.VerifyPhone_Resend</span>
                            <span class="otp-field__wait">@Localizer.Mfa_ResendAvailableIn <span class="countdown otp-field__countdown"></span></span>
                        </button>
                    </p>
                    <div class="verify-dialog__actions">
                        <button class="btn btn-primary" type="submit">@Localizer.ChangeEmail_Verify</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (mfaChallenge is not null)
{
    <partial name="_ProfileMfaChallenge" model="mfaChallenge" />
}

@section scripts {
    <partial name="_ValidationScripts" />
    @if ((pendingEmail is not null && Model.UseOtp) || mfaChallenge?.CanEnterCode == true)
    {
        <script type="text/javascript" src="~/js/otp.js" csp-nonce></script>
        <script type="text/javascript" src="~/js/otp-field.js" csp-nonce></script>
    }
    @if (pendingEmail is not null && !Model.UseOtp)
    {
        <script type="text/javascript" src="~/js/email-confirmation-poll.js" csp-nonce></script>
    }
}
