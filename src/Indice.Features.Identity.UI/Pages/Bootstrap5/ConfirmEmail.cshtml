@page "/confirm-email"

@model BaseConfirmEmailModel

@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels

@{
    ViewData["Title"] = Labels.ConfirmEmail_Email_Confirmation;
}

<section class="identity-panel wide border-0 confirm-email">
    <article class="text-center">
        @if (Model.View.AlreadyVerified)
        {
            <partial name="_PageHeader" model="@Labels.ConfirmEmail_Email_Confirmation" />
            <p>
                <span indice-if="Model.View.HasReturnUrl">
                    @Labels.ConfirmEmail_Click
                    <a href="@Model.View.ReturnUrl">@Labels.ConfirmEmail_Here</a>
                    @Labels.ConfirmEmail_To_Sign_In_Or_Go_Back
                </span>
                @Labels.ConfirmEmailChange_You_Can_Now_Close_This_Browse_Window
            </p>
        }
        else if (Model.View.InvalidOrExpiredToken)
        {
            <partial name="_PageHeader" model="@Labels.ConfirmEmail_Email_Verification_Link_Has_Expired" />
            <p>
                @Labels.ConfirmEmail_Please_Log_In_And_Resend_The_Link
                <a indice-if="Model.View.HasReturnUrl" href="@Model.View.ReturnUrl">@Labels.ConfirmEmail_Here</a>
            </p>
        }
        else if (Model.View.Verified)
        {
            <partial name="_PageHeader" model="@Labels.ConfirmEmail_Your_Email_Has_Been_Successfully_Confirmed.Value" />
            <p>
                <span indice-if="Model.View.HasReturnUrl">
                    @Labels.ConfirmEmail_Click
                    <a href="@Model.View.ReturnUrl">@Labels.ConfirmEmail_Here</a>
                    @Labels.ConfirmEmail_To_Sign_In_Or_Go_Back
                </span>
                @Labels.ConfirmEmail_You_Can_Now_Close_This_Browse_Window
            </p>
        }
        else if (!ViewContext.ModelState.IsValid)
        {
            <partial name="_PageHeader" model="@Labels.ConfirmEmail_No_Action_Was_Taken" />
            <p>
                @Labels.ConfirmEmail_If_You_Feel_You_Got_This_Error_By_Mistake_Simply_Click
                <a asp-page="/Home">@Labels.ConfirmEmail_Here</a>
                @Labels.ConfirmEmail_To_Sign_In_Or_Go_Back
            </p>
        }
        else
        {
            <partial name="_PageHeader" model="@Labels.ConfirmEmail_Verifying_Your_Email" />
            <p>
                @Labels.ConfirmEmail_This_May_Take_A_Moment_Click_On_The_Link_Below_To_Verify_Your_Email_Address
                <strong>@Model.View.Email</strong>
            </p>
            <form name="EmailVerificationForm" method="post" asp-route-client_id="@Model.Input.ClientId">
                <input type="hidden" asp-for="Input.UserId" />
                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.ClientId" />
                <input type="hidden" asp-for="Input.ReturnUrl" />
                <input type="hidden" asp-for="Input.ShouldRedirect" />
                <input type="hidden" asp-for="Input.ThrowWhenConfirmed" />
                <button type="submit" class="btn btn-primary">@Labels.ConfirmEmail_Verify</button>
            </form>
            <script type="text/javascript" csp-nonce="true">
                function submitform() {
                    document.forms["EmailVerificationForm"].submit();
                }
                window.onload = submitform;
            </script>
        }
    </article>
</section>
