@page "/login/mfa/onboarding/recovery-codes"
@model BaseMfaOnboardingRecoveryCodesModel

@inject IdentityUILocalizer Localizer

@{
    ViewBag.Title = Localizer.MfaOnBoardingRecoveryCodes_PageTitle;
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.MfaOnBoardingRecoveryCodes_PageHeader" image-src="" />

    <div class="alert alert-warning" role="alert">
        @Localizer.MfaOnBoardingRecoveryCodes_SaveWarning
    </div>

    <ul class="mfa__codes">
        @foreach (var code in Model.View.RecoveryCodes)
        {
            <li><code>@code</code></li>
        }
    </ul>

    <div class="auth-form__actions">
        <a asp-page-handler="Download" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary auth-form__submit">
            <i class="fa-solid fa-download" aria-hidden="true"></i> @Localizer.MfaOnBoardingRecoveryCodes_Download
        </a>
    </div>
    <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate class="auth-form">
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.MfaOnBoardingRecoveryCodes_Continue</button>
        </div>
    </form>
</section>
