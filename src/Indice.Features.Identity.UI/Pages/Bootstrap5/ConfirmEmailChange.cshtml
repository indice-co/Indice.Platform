@page "/confirm-email-change"

@model BaseConfirmEmailChangeModel

@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.ConfirmEmailChange_PageTitle;
}

<section class="auth-card auth-card--message">
    @if (Model.View.AlreadyVerified)
    {
        <partial name="_PageHeader" model="@Localizer.ConfirmEmailChange_Your_Email_Is_Already_Verified_Thank_You.Value" />
        <p class="auth-card__text">
            <span indice-if="Model.View.HasReturnUrl">
                @Localizer.ConfirmEmailChange_Click
                <a href="@Model.View.ReturnUrl">@Localizer.ConfirmEmailChange_Here</a>
                @Localizer.ConfirmEmailChange_To_Sign_In_Or_Go_Back
            </span>
            @Localizer.ConfirmEmailChange_You_Can_Now_Close_This_Browse_Window
        </p>
    }
    else if (Model.View.InvalidOrExpiredToken)
    {
        <partial name="_PageHeader" model="@Localizer.ConfirmEmailChange_Email_Verification_Link_Has_Expired.Value" />
        <p class="auth-card__text">
            @Localizer.ConfirmEmailChange_Please_Log_In_And_Resend_The_Link
            <a indice-if="Model.View.HasReturnUrl" href="@Model.View.ReturnUrl">@Localizer.ConfirmEmailChange_Here</a>
        </p>
    }
    else if (Model.View.Verified)
    {
        <partial name="_PageHeader" model="@Localizer.ConfirmEmailChange_Your_Email_Has_Been_Successfully_Changed.Value" />
        <p class="auth-card__text">
            <span indice-if="Model.View.HasReturnUrl">
                @Localizer.ConfirmEmailChange_Click
                <a href="@Model.View.ReturnUrl">@Localizer.ConfirmEmailChange_Here</a>
                @Localizer.ConfirmEmailChange_To_Sign_In_Or_Go_Back
            </span>
            @Localizer.ConfirmEmailChange_You_Can_Now_Close_This_Browse_Window
        </p>
    }
    else if (!ViewContext.ModelState.IsValid)
    {
        <partial name="_PageHeader" model="@Localizer.ConfirmEmailChange_No_Action_Was_Taken.Value" />
        <p class="auth-card__text">
            @Localizer.ConfirmEmailChange_If_You_Feel_You_Got_This_Error_By_Mistake_Simply_Click
            <a asp-page="/Home">@Localizer.ConfirmEmailChange_Here</a>
            @Localizer.ConfirmEmailChange_To_Sign_In_Or_Go_Back
        </p>
    }
    else
    {
        <partial name="_PageHeader" model="@Localizer.ConfirmEmailChange_Verifying_Your_Email.Value" />
        <p class="auth-card__text">
            @Localizer.ConfirmEmailChange_This_May_Take_A_Moment_Click_On_The_Link_Below_To_Verify_Your_Email_Address
            <strong>@Model.View.Email</strong>
        </p>
        <form name="EmailVerificationForm" method="post" asp-route-client_id="@Model.Input.ClientId" class="auth-form">
            <input type="hidden" asp-for="Input.UserId" />
            <input type="hidden" asp-for="Input.Email" />
            <input type="hidden" asp-for="Input.Token" />
            <input type="hidden" asp-for="Input.ClientId" />
            <input type="hidden" asp-for="Input.ReturnUrl" />
            <input type="hidden" asp-for="Input.ShouldRedirect" />
            <input type="hidden" asp-for="Input.ThrowWhenConfirmed" />
            <div class="auth-form__actions">
                <button type="submit" class="btn btn-primary auth-form__submit">@Localizer.ConfirmEmailChange_Verify</button>
            </div>
        </form>
        <script type="text/javascript" csp-nonce="true">
            function submitform() {
                document.forms["EmailVerificationForm"].submit();
            }
            window.onload = submitform;
        </script>
    }
</section>
