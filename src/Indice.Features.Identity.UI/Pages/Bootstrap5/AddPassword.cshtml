@page "/add-password"

@model BaseAddPasswordModel


@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.AddPassword_PageTitle;
    ViewData["Shell"] = "profile";
}

<section class="data-card data-card--form">
    <header class="data-card__header">
        <h1 class="data-card__title">@Localizer.AddPassword_PageHeader</h1>
    </header>
    <partial name="_ValidationSummary" />
    @if (Model.PasswordSuccessfullyAdded)
    {
        <div class="alert alert-success" role="status">
            <strong>@Localizer.AddPassword_ProcessCompleted</strong> @Localizer.AddPassword_PasswordSuccessfullyAdded
        </div>
    }
    <form indice-if="!Model.PasswordSuccessfullyAdded" data-sbind="event: { change: formChanged }" data-token="@Base64Id.Parse(User.FindSubjectId()!)" data-userName="@(User.Identity?.Name ?? string.Empty)" novalidate method="post" class="auth-form">
        <div class="field">
            <label asp-for="Input.NewPassword" class="field__label">@Localizer.AddPassword_Newpassword_FieldLabel</label>
            <div class="field__group">
                <input class="form-control field__control password" type="password" placeholder="@Localizer.AddPassword_Newpassword_FieldLabel" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" autocomplete="new-password" aria-describedby="Input_NewPassword-error password-rules" />
                <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="field__error" id="Input_NewPassword-error"></span>
            <ul id="password-rules" class="password-rules" data-sbind="foreach: passwordRules" aria-live="polite">
                <li class="password-rules__item" data-sbind="text: $data.requirement, css: { 'password-rules__item--valid': $data.isValid }"></li>
            </ul>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword" class="field__label">@Localizer.AddPassword_ConfirmPassword</label>
            <div class="field__group">
                <input class="form-control field__control password" type="password" placeholder="@Localizer.AddPassword_ConfirmPassword" asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-describedby="Input_ConfirmPassword-error" />
                <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="field__error" id="Input_ConfirmPassword-error"></span>
        </div>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" name="button" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Localizer.AddPassword_Add</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/reveal-password.js" csp-nonce="true"></script>
}
