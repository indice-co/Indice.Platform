@page "/add-password"

@model BaseAddPasswordModel


@inject IdentityLabelsMessageDescriber Labels

@{
    var title = ViewData["Title"] = Labels.AddPassword_AddPassword;
}

<section class="sign-in m-auto">
    <vc:page-heading title="@title" image-src="" />
    <partial name="_ValidationSummary" />
    @if (Model.PasswordSuccessfullyAdded)
    {
        <div class="alert alert-success" role="alert">
            <strong>@Labels.AddPassword_ProcessCompleted</strong> @Labels.AddPassword_PasswordSuccessfullyAdded
        </div>
    }
    <form indice-if="!Model.PasswordSuccessfullyAdded" data-sbind="event: { change: formChanged }" data-token="@Base64Id.Parse(User.FindSubjectId()!)" data-userName="@(User.Identity?.Name ?? string.Empty)" novalidate method="post">
        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">@Labels.AddPassword_NewPassword</label>
            <input class="form-control" type="password" placeholder="@Labels.AddPassword_NewPassword" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" autocomplete="off" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">@Labels.AddPassword_ConfirmPassword</label>
            <input class="form-control" type="password" placeholder="@Labels.AddPassword_ConfirmPassword" asp-for="Input.ConfirmPassword" autocomplete="off" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <div id="password-rules" class="password-rules">
                <ul data-sbind="foreach: passwordRules">
                    <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                </ul>
            </div>
        </div>
        <div class="mb-3">
            <button class="btn btn-primary w-100" name="button" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Labels.AddPassword_Add</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/password-rules.js" csp-nonce="true"></script>
}
