@using Indice.Extensions
@using Indice.Features.Identity.Core.Models
@inject IdentityUILocalizer Localizer
@model BaseMfaModel

<div id="panel-channels" class="d-none">
    <p class="auth-card__subtitle">@Localizer.Mfa_Authenticate_Yourself_Using</p>

    <ul class="choice-list">
        @foreach (var method in Model.View.AvailableAuthenticationMethods)
        {
            <li class="choice-list__item choice-list__item--button">
                <button type="submit"
                        name="ChangeSelectedMethodCode"
                        value="@method.Code"
                        class="choice-list__button channel-btn channel-@(method.DisplayName.ToKebabCase())">
                    <span class="choice-list__icon"><i class="@GetIconFromAuthenticationMethod(method)" aria-hidden="true"></i></span>
                    <span class="choice-list__body">
                        <span class="choice-list__title">@Localizer.GetGeneric(method.DisplayName)</span>
                        <span class="choice-list__desc">@Localizer.GetGeneric(method.Description)</span>
                    </span>
                    <i class="idui-icon idui-icon--chevron-right choice-list__chevron" aria-hidden="true"></i>
                </button>
            </li>
        }
    </ul>

    <button id="go-back" type="button" class="mfa__back mfa__link">
        <i class="idui-icon idui-icon--arrow-left" aria-hidden="true"></i> @Localizer.Mfa_Back
    </button>
</div>
@functions {
    public string GetIconFromAuthenticationMethod(AuthenticationMethod method)
    {
        return method.Code.ToLowerInvariant() switch
        {
            "viber" => "idui-icon idui-icon--phone",
            "sms" => "idui-icon idui-icon--message-square",
            "email" => "idui-icon idui-icon--mail",
            "authenticatorapp" => "idui-icon idui-icon--shield-check",
            "trusteddevice" => "idui-icon idui-icon--smartphone",
            "fido2" => "idui-icon idui-icon--fingerprint",
            "recoverycode" => "idui-icon idui-icon--square-asterisk",
            _ => "idui-icon idui-icon--message-square"
        };
    }
}
