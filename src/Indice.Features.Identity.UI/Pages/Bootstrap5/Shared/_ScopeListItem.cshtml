@inject IMarkdownProcessor Markdown
@inject IdentityUILocalizer Localizer

@model ScopeViewModel

@{
    var hasDescription = Model.Description is not null;
}

<li class="choice-list__item">
    <div class="form-check choice-list__check">
        <input class="form-check-input consent-scopecheck" type="checkbox" name="Input.ScopesConsented" id="scopes_@Model.Value" value="@Model.Value" checked="@Model.Checked" disabled="@Model.Required" aria-describedby="@(hasDescription ? $"scopes_{Model.Value}-desc" : null)" />
        @if (Model.Required)
        {
            <input type="hidden" name="Input.ScopesConsented" value="@Model.Value" />
        }
        <label class="form-check-label choice-list__title" for="scopes_@Model.Value">
            @(!string.IsNullOrWhiteSpace(Model.DisplayName) ? @Localizer.GetGeneric(Model.DisplayName) : string.Empty)
            <i indice-if="Model.Emphasize" class="fa-solid fa-circle-exclamation choice-list__emphasis" aria-hidden="true"></i>
            <em indice-if="Model.Required" class="choice-list__required">(@Localizer.AddPassword_Required)</em>
        </label>
    </div>
    @if (hasDescription)
    {
        <div class="choice-list__desc" id="scopes_@Model.Value-desc">@Html.Raw(Markdown.Convert(Model.Description!))</div>
    }
    @if (Model.Metadata is not null)
    {
        <div class="choice-list__meta">
            <vc:parsed-scope model="Model.Metadata" />
        </div>
    }
</li>
