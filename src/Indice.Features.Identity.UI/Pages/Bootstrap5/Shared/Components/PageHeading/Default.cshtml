@model PageHeadingViewModel

<header class="auth-card__header">
    <img indice-if="!string.IsNullOrWhiteSpace(Model.ImageSrc)" class="auth-card__image" src="@Model.ImageSrc" alt="" />
    <h1 class="auth-card__title">@Model.Title</h1>
    <p indice-if="!string.IsNullOrWhiteSpace(Model.Subtitle?.ToString())" class="auth-card__subtitle">@Model.Subtitle</p>
</header>
