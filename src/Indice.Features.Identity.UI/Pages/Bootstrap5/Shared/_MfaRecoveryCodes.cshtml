@using Indice.Features.Identity.Core.Models
@inject IdentityUILocalizer Localizer
@model BaseMfaModel

<form id="mfa-form"
      asp-page="/Mfa"
      asp-page-handler="RecoveryCode"
      asp-route-returnUrl="@Model.Input.ReturnUrl"
      method="post"
      class="auth-form">
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.DeviceId" />
    <input type="hidden" asp-for="Input.SelectedAuthenticationMethodCode" value="@Model.View.AuthenticationMethod?.Code" />

    <div id="panel-main">
        <p class="mfa__notice">
            <i class="mfa__notice-icon fa-solid fa-square-binary" aria-hidden="true"></i>
            <span>@Localizer.Mfa_EnterRecoveryCode</span>
        </p>
        <div class="field">
            <label asp-for="Input.RecoveryCode" class="field__label">@Localizer.Mfa_RecoveryCode</label>
            <input asp-for="Input.RecoveryCode"
                   class="form-control field__control"
                   placeholder="@Localizer.Mfa_RecoveryCode"
                   autocomplete="off"
                   autofocus
                   aria-describedby="Input_RecoveryCode-error" />
            <span asp-validation-for="Input.RecoveryCode" class="field__error" id="Input_RecoveryCode-error"></span>
        </div>
        <div class="auth-form__actions">
            <button type="submit" class="btn btn-primary auth-form__submit">@Localizer.Mfa_Authenticate</button>
        </div>
        <p class="mfa__alt">
            <button id="show-channels" type="button" class="mfa__link">@Localizer.Mfa_Other_Authentication_Methods</button>
        </p>
    </div>

    <partial name="_MfaChannelSelector" model="Model" />
</form>
