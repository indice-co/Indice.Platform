@using Indice.Features.Identity.Core.Models
@inject IdentityUILocalizer Localizer
@model BaseMfaModel

<form id="mfa-form"
      asp-page="/Mfa"
      asp-page-handler="RecoveryCode"
      asp-route-returnUrl="@Model.Input.ReturnUrl"
      method="post">
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.DeviceId" />
    <input type="hidden" asp-for="Input.SelectedAuthenticationMethodCode" value="@Model.View.AuthenticationMethod?.Code" />

    <div id="panel-main">
        <div class="alert alert-warning mb-4">
            <div class="d-flex flex-row  align-items-center gap-3">
                <i class="fa-2xl fa-solid fa-square-binary" aria-label="icon"></i>
                <div class="d-flex w-100 flex-column justify-content-between">
                    <span>
                        @Localizer.Mfa_EnterRecoveryCode
                    </span>
                </div>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Input.RecoveryCode" class="form-label">
                @Localizer.Mfa_RecoveryCode
            </label>
            <input asp-for="Input.RecoveryCode"
                   class="form-control"
                   placeholder="@Localizer.Mfa_RecoveryCode"
                   autocomplete="off"
                   autofocus />
            <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center justify-content-end mb-4">
            <button type="submit" class="btn btn-primary">
                @Localizer.Mfa_Authenticate
            </button>
        </div>

        <div class="text-center mb-3">
            <button id="show-channels"
                    type="button"
                    class="btn btn-link text-decoration-none p-0">
                @Localizer.Mfa_Other_Authentication_Methods
            </button>
        </div>
    </div>

    <partial name="_MfaChannelSelector" model="Model" />
</form>
