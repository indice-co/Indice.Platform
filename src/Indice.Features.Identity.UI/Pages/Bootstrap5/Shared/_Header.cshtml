@inject IOptions<GeneralSettings> GeneralSettingsWrapper
@inject ExtendedSignInManager<User> SignInManager
@inject IdentityUILocalizer Localizer

@{
    var displayMenu = SignInManager.IsSignedIn(User) && !User.IsSignedInWithScheme(ExtendedIdentityConstants.ExtendedValidationScheme);
    var settings = GeneralSettingsWrapper.Value;
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var langSuffix = (lang == "el") ? ".el" : string.Empty;
    var applicationName = Localizer.ApplicationName(settings.ApplicationName ?? string.Empty);
}

<header class="site-header">
    <a class="site-header__brand" href="~/">
        <img class="site-header__logo site-header__logo--light" src="~/img/logo@(langSuffix).svg" alt="" />
        <img class="site-header__logo site-header__logo--dark" src="~/img/logo-dark-bg@(langSuffix).svg" alt="" />
        <span class="site-header__wordmark">@applicationName</span>
    </a>
    @if (displayMenu)
    {
        <div class="site-header__actions">
            <button type="button" class="site-header__avatar" data-bs-toggle="offcanvas" data-bs-target="#account-panel" aria-controls="account-panel" aria-label="@Localizer.Nav_OpenMenu">
                <img class="avatar avatar--sm" profile-pic="48" alt="" />
            </button>
        </div>
        <partial name="_AccountPanel" />
    }
</header>
