@inject IOptions<GeneralSettings> SettingsWrapper
@inject IOptions<IdentityUIOptions> UIOptions
@inject IdentityUILocalizer Localizer

@{
    Layout = "_LayoutEmail.cshtml";
}

@{
    var Settings = SettingsWrapper.Value;
    var subject = @Model.Subject;
}

@section preheader {
    @Localizer.Email_Reset_Password
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-weight:normal">@subject</h1>
}

<p style="font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 12px;">
    @Localizer.Email_Body_Hi @Model.DisplayName,
    <br />
    <br />
    @Localizer.Email_ResetPassword_RequestInfo
    <br /><br />
    @if (!string.IsNullOrWhiteSpace(Model?.Url))
    {
        <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@Model!.Url">@Localizer.Email_Reset_Password</a>
    }
    <br /><br />
    @Localizer.Email_ResetPassword_IgnoreNotice
    <br /><br />
    <br /><br />
    @Localizer.Email_Body_Sincerely,
    <br />
    @Localizer.Email_Body_Organization_Signature(Settings.Organization!).
</p>
