@using Indice.Features.Identity.Core.Models
@inject IdentityUILocalizer Localizer
@model BaseMfaModel

@functions {
    public string GetIconFromAuthenticationMethod(AuthenticationMethod? method)
    {
        return method?.Code.ToLowerInvariant() switch
        {
            "viber" => "fa-brands fa-viber",
            "sms" => "fa-regular fa-message",
            "email" => "fa-regular fa-envelope",
            "authenticatorapp" => "fa-solid fa-shield-halved",
            "trusteddevice" => "fa-solid fa-mobile-screen",
            "fido2" => "fa-solid fa-fingerprint",
            "recoverycode" => "fa-solid fa-square-binary",
            _ => "fa-regular fa-message"
        };
    }
}
<form id="mfa-form"
      asp-page="/Mfa"
      asp-route-returnUrl="@Model.Input.ReturnUrl"
      method="post"
      class="auth-form">
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.DeviceId" />
    <input type="hidden" asp-for="Input.SelectedAuthenticationMethodCode" value="@Model.View.AuthenticationMethod?.Code" />

    <div id="panel-main">
        <p class="mfa__notice">
            <i class="mfa__notice-icon @GetIconFromAuthenticationMethod(Model.View.AuthenticationMethod)" aria-hidden="true"></i>
            <span>@Localizer.Mfa_We_Texted_Your_Phone(Model.View.PhoneNumberMasked!)</span>
        </p>
        <div class="field">
            <label asp-for="Input.OtpCode" class="field__label">@Localizer.Mfa_OTP_Code</label>
            <input asp-for="Input.OtpCode"
                   class="form-control field__control otp-field__input"
                   data-otp-length="6"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="@Localizer.Mfa_OTP_Code"
                   autofocus
                   aria-describedby="Input_OtpCode-error" />
            <span asp-validation-for="Input.OtpCode" class="field__error" id="Input_OtpCode-error"></span>
        </div>
        <p class="otp-field__resend">
            <button id="otp-resend"
                    type="submit"
                    name="Input.ResendOtp"
                    value="true"
                    class="otp-field__resend-btn"
                    disabled="@(!Model.View.ResendEnabled)">
                <span class="otp-field__resend-text">@Localizer.Mfa_Resend</span>
                <span class="otp-field__wait">@Localizer.Mfa_ResendAvailableIn <span class="countdown otp-field__countdown"></span></span>
            </button>
        </p>
        <div class="form-check" indice-if="!Model.View.IsExistingBrowser">
            <input asp-for="Input.RememberClient" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="Input.RememberClient">@Localizer.Mfa_I_Sign_In_Frequently_Here_Remember_This_Browser</label>
        </div>
        <div class="auth-form__actions">
            <button type="submit" class="btn btn-primary auth-form__submit">@Localizer.Mfa_Authenticate</button>
        </div>
        @if (Model.View.AllowDowngradeAuthenticationMethod)
        {
            <p class="mfa__alt">
                <button id="show-channels" type="button" class="mfa__link">@Localizer.Mfa_Other_Authentication_Methods</button>
            </p>
        }
    </div>

    <partial name="_MfaChannelSelector" model="Model" />
    <input type="hidden" name="Input.ResendOtp" value="" />
</form>
