@inject IOptions<GeneralSettings> Settings
@inject IOptions<IdentityUIOptions> UIOptions
@inject IWebHostEnvironment Environment
@inject IdentityUILocalizer Localizer

@{
    var settings = Settings.Value;
    var copyYear = UIOptions.Value.CopyYear;
    var version = typeof(BaseLoginModel).Assembly.GetName().Version?.ToString();
    var showContactUs = !string.IsNullOrWhiteSpace(UIOptions.Value.ContactUsUrl);
}

<footer class="container-fluid footer">
    <div class="copyright">
        <div class="language">
            <partial name="_LanguageSelector" />
        </div>
        &copy; @Localizer.OrganizationName(settings.Organization!) @copyYear @(DateTime.Today.Year > copyYear ? $" - {DateTime.Today.Year}" : string.Empty)
    </div>
    <div class="links">
        <span class="software-verson">v@(version ?? "1.0.0")</span>
        <environment exclude="@UIOptions.Value.ProductionEnvironments">
            <a href="~/.well-known/openid-configuration" target="_blank">@Localizer.Footer_Discovery</a>
        </environment>
        <a asp-page="/Privacy" target="_blank">@Localizer.Footer_Privacy</a>
        <a asp-page="/Terms" target="_blank">@Localizer.Footer_Terms</a>
        <a indice-if="showContactUs" href="@UIOptions.Value.ContactUsUrl" target="_blank">@Localizer.Footer_Contact_us</a>
    </div>
</footer>
