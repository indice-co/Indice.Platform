@inject IIdentityViewLocalizer Localizer
@inject IOptions<GeneralSettings> GeneralSettings
@inject IOptions<IdentityUIOptions> UIOptions
@inject UserManager<User> UserManager
@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels


@{
    Layout = "_LayoutEmail.cshtml";
}

@{
    var settings = GeneralSettings.Value;
    var subject = Model?.Subject ?? Labels.EmailRegister_Subject(settings.ApplicationName!);
    var userName = Model?.UserName ?? UserManager.GetUserName(User);
    var confirmationLink = Model?.Url ?? throw new InvalidOperationException("Confirmation link cannot be null.");
}

@section preheader {
    @Labels.EmailRegister_Subject(settings.ApplicationName!)
}

@section subject {
    <h1 style="font-size: 18px; font-family:'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-weight:normal">
        @subject
    </h1>
}

<p style="font-family: 'Century Gothic', Arial, sans-serif ,Helvetica, Arial, sans-serif; font-size: 12px;">
    @Labels.EmailRegister_Body_Hi @(userName ?? string.Empty),
    <br />
    <br />
    @Labels.EmailRegister_Body_Welcome(settings.ApplicationName!)
    <br />
    <br />
    @Labels.EmailRegister_Body_ConfirmEmail
    <a style="color:#@UIOptions.Value.EmailLinkColorHex" href="@confirmationLink">@Labels.Email_Preheader_Here</a>.
    <br />
    <br />
    @Labels.EmailRegister_Body_IgnoreNotice
    <br />
    <br />
    @Labels.EmailRegister_Body_Thanks
    <br />
    <br />
    @Labels.Email_Body_Sincerely,<br />
    @Labels.Email_Body_Organization(settings.Organization!)
</p>