@page "/grants"

@model BaseGrantsModel
@inject IdentityUILocalizer Localizer


@{
    ViewData["Title"] = Localizer.Grants_PageTitle;
    ViewData["Shell"] = "profile";
}

<section class="data-card">
    <header class="data-card__header">
        <h1 class="data-card__title">@Localizer.Grants_PageHeader</h1>
    </header>
    <p indice-if="Model.View.Grants!.Any()" class="data-card__lead">@Localizer.Grants_Applications_And_Resources</p>
    @if (!Model.View.Grants!.Any())
    {
        <div class="alert alert-secondary" role="status">
            @Localizer.Grants_No_Applications_Provided
        </div>
    }
</section>
@foreach (var grant in Model.View.Grants!)
{
    <section class="data-card grant">
        <header class="data-card__header grant__header">
            <span class="grant__identity">
                <img class="avatar avatar--md grant__logo" src="@(!string.IsNullOrEmpty(grant.ClientLogoUrl) ? (Url.IsLocalUrl(grant.ClientLogoUrl) ? Url.Content(grant.ClientLogoUrl) : grant.ClientLogoUrl) : Url.Content($"~/avatar/{grant.ClientName}/64.png"))" alt="@Localizer.Grants_Client_Logo" />
                <span>
                    <h2 class="data-card__title grant__name">@grant.ClientName</h2>
                    <span class="data-card__meta">@Localizer.Grants_Created @grant.Created.ToString("yyyy-MM-dd HH:mm")</span>
                </span>
            </span>
        </header>
        <div class="data-card__grid">
            <div indice-if="grant.IdentityGrantNames.Any()" class="grant__group">
                <h3 class="data-card__subtitle"><i class="fa-regular fa-address-card" aria-hidden="true"></i> Identity Grants</h3>
                <ul class="grant__list">
                    @foreach (var name in grant.IdentityGrantNames)
                    {
                        <li>@name</li>
                    }
                </ul>
            </div>
            <div indice-if="grant.ApiGrantNames.Any()" class="grant__group">
                <h3 class="data-card__subtitle"><i class="fa-solid fa-server" aria-hidden="true"></i> API Grants</h3>
                <ul class="grant__list">
                    @foreach (var name in grant.ApiGrantNames)
                    {
                        <li>@name</li>
                    }
                </ul>
            </div>
        </div>
        <footer class="data-card__actions grant__footer">
            <span indice-if="grant.Expires.HasValue" class="data-card__meta">
                @Localizer.Grants_Expires_On @(grant.Expires.HasValue ? $"{grant.Expires.Value.ToString("yyyy-MM-dd")} @ {grant.Expires.Value.ToString("HH:mm")}" : "-")
            </span>
            <form asp-page-handler="Revoke" method="post">
                <input type="hidden" name="clientId" value="@grant.ClientId">
                <button class="btn btn-outline-danger">@Localizer.Grants_Revoke_Access</button>
            </form>
        </footer>
    </section>
}
