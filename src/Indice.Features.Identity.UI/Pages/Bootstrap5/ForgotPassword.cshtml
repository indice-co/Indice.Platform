@page "/forgot-password"

@model BaseForgotPasswordModel

@inject IIdentityViewLocalizer Localizer
@inject ExtendedUserManager<User> userManager
@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels


@{
    var title = ViewData["Title"] = Labels.ForgotPassword_Forgot_Password;
}

<section class="sign-in m-auto">
    <vc:page-heading title="@title" image-src="" />
    <partial name="_ValidationSummary" />
    <form method="post" autocomplete="off">
        <p class="text-muted">@Labels.ForgotPassword_To_Have_Your_Password_Reset_Enter_Your_Username_Or_Email_Address_Below_We_Will_Then_Send_An_Email_Containing_A_Link_To_Reset_Your_Password</p>
        @if (Model.RequestSent)
        {
            <div class="alert alert-info" role="alert">
                <strong>@Labels.ForgotPassword_Request_Sent.</strong> @ViewData["message"]
            </div>
        }
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label visually-hidden"></label>
            <input asp-for="Input.Email" type="text" class="form-control" placeholder="Email" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <button class="btn btn-primary w-100" type="submit">@(Model.RequestSent? Labels.ForgotPassword_Resend: Labels.ForgotPassword_Send)</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
