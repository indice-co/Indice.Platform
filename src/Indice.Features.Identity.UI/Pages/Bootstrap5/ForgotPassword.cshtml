@page "/forgot-password"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("forgot-password")]

@model BaseForgotPasswordModel

@inject ExtendedUserManager<User> userManager
@inject IdentityUILocalizer Localizer
@{
    ViewData["Title"] = Localizer.ForgotPassword_PageTitle;
}

<section class="sign-in m-auto">
    <vc:page-heading title="@Localizer.ForgotPassword_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <form method="post" autocomplete="off" id="forgotPasswordForm">
        <p class="text-muted">@Localizer.ForgotPassword_ResetInstructions</p>
        @if (Model.RequestSent)
        {
            <div class="alert alert-info" role="alert">
                <strong>@Localizer.ForgotPassword_Request_Sent.</strong> @Localizer.ForgotPassword_Request_Sent_Disclaimer
            </div>
        }
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label visually-hidden"></label>
            <input asp-for="Input.Email" type="text" class="form-control" readonly="@Model.RequestSent" placeholder="@Localizer.Email" autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <partial name="_Recaptcha" model='new RecaptchaViewModel { FormId = "forgotPasswordForm", ButtonId = "submitButton", Action = "forgotpassword" }' />
        <div class="mb-3" indice-if="@(!Model.RequestSent)">
            <button class="btn btn-primary w-100" id="submitButton" type="submit">@(Model.RequestSent? Localizer.ForgotPassword_Resend: Localizer.ForgotPassword_Send)</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
