@page "/forgot-password"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("forgot-password")]

@model BaseForgotPasswordModel

@inject ExtendedUserManager<User> userManager
@inject IdentityUILocalizer Localizer
@{
    ViewData["Title"] = Localizer.ForgotPassword_PageTitle;
}

<section class="auth-card">
    <vc:page-heading title="@Localizer.ForgotPassword_PageHeader" subtitle="@Localizer.ForgotPassword_ResetInstructions" image-src="" />
    <partial name="_ValidationSummary" />
    <form method="post" autocomplete="off" id="forgotPasswordForm" class="auth-form">
        @if (Model.RequestSent)
        {
            <div class="alert alert-info" role="status">
                <strong>@Localizer.ForgotPassword_Request_Sent.</strong> @Localizer.ForgotPassword_Request_Sent_Disclaimer
            </div>
        }
        <div class="field">
            <label asp-for="Input.Email" class="field__label">@Localizer.Email</label>
            <input asp-for="Input.Email" type="email" class="form-control field__control" readonly="@Model.RequestSent" placeholder="@Localizer.Email" autocomplete="email" autofocus aria-describedby="Input_Email-error" />
            <span asp-validation-for="Input.Email" class="field__error" id="Input_Email-error"></span>
        </div>
        <partial name="_Recaptcha" model='new RecaptchaViewModel { FormId = "forgotPasswordForm", ButtonId = "submitButton", Action = "forgotpassword" }' />
        <div class="auth-form__actions" indice-if="@(!Model.RequestSent)">
            <button class="btn btn-primary auth-form__submit" id="submitButton" type="submit">@(Model.RequestSent? Localizer.ForgotPassword_Resend: Localizer.ForgotPassword_Send)</button>
        </div>
    </form>
    <p class="auth-card__switch">
        <a asp-page="/Login">@Localizer.Login_PageHeader</a>
    </p>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
