@page "/login/add-email"

@model BaseAddEmailModel

@inject IdentityLabelsMessageDescriber Labels


@{
    var title = ViewData["Title"] = Labels.AddEmail_Verify_email;
    var tempData = TempData.Peek<ExtendedValidationTempDataModel>(BaseAddEmailModel.TempDataKey);
}

<div class="sign-in m-auto">
    <vc:page-heading title="@title" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="tempData?.Alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post">
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label visually-hidden">@Labels.Email</label>
            <input class="form-control" type="text" placeholder="@Labels.Email" asp-for="Input.Email" disabled="@tempData?.DisableForm" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <div class="row m-0 w-100">
                <div indice-if="Model.UiOptions.ShowAddEmailPrompt" class="@(tempData?.DisableForm == true ? "col-sm-6" : string.Empty) col-12 py-1">
                    <button class="btn btn-info w-100" type="submit" disabled="@tempData?.DisableForm">@Labels.AddEmail_Save</button>
                </div>
                @if (tempData?.DisableForm == true || !string.IsNullOrEmpty(tempData?.NextStepUrl))
                {
                    <div class="col-sm-6 col-12 py-1">
                        <a class="btn btn-info w-100" href="@tempData.NextStepUrl">@Labels.AddEmail_Next</a>
                    </div>
                }
            </div>
        </div>
        <input type="hidden" asp-for="Input.ReturnUrl" />
    </form>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}
