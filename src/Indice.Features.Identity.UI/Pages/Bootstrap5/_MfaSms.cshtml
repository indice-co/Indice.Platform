@using Indice.Extensions
@using Indice.Features.Identity.Core.Models
@inject IdentityUILocalizer Localizer
@model BaseMfaModel

<form id="mfa-form"
      asp-page="/Mfa"
      asp-route-returnUrl="@Model.Input.ReturnUrl"
      method="post">
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.DeviceId" />
    <input type="hidden" asp-for="Input.SelectedDeliveryChannel" value="@Model.View.AuthenticationMethodDeliveryChannel" />
    <input type="hidden" asp-for="Input.SelectedMethodCode" value="@Model.View.AuthenticationMethod?.Code" />
    
    <div id="panel-main">
        <div class="alert alert-primary mb-4">
            @Localizer.Mfa_We_Texted_Your_Phone(Model.View.PhoneNumberMasked!)
        </div>
        <div class="mb-4">
            <label asp-for="Input.OtpCode" class="form-label">
                @Localizer.Mfa_OTP_Code
            </label>
            <input asp-for="Input.OtpCode"
                   class="form-control"
                   placeholder="@Localizer.Mfa_OTP_Code"
                   autofocus autocomplete="off" />
            <span asp-validation-for="Input.OtpCode" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="form-check me-2" indice-if="!Model.View.IsExistingBrowser">
                <input asp-for="Input.RememberClient"
                       type="checkbox"
                       class="form-check-input ms-0 me-1" />
                <label class="form-check-label" for="Input_RememberClient">
                    @Localizer.Mfa_I_Sign_In_Frequently_Here_Remember_This_Browser
                </label>
            </div>
            <button type="submit" class="btn btn-primary">
                @Localizer.Mfa_Authenticate
            </button>
        </div>

        <div class="d-flex @(Model.View.AllowDowngradeAuthenticationMethod ? "justify-content-between" : "justify-content-center") mb-3">
            <button id="otp-resend"
                    type="submit"
                    name="Input.ResendOtp"
                    value="true"
                    class="btn btn-link text-decoration-none p-0"
                    disabled="@(!Model.View.ResendEnabled)">
                <span>@Localizer.Mfa_Resend</span>
                <span class="countdown ms-2 text-muted small"></span>
            </button>

            @if (Model.View.AllowDowngradeAuthenticationMethod)
            {
                <button id="show-channels"
                        type="button"
                        class="btn btn-link text-decoration-none p-0">
                    @Localizer.Mfa_Other_Authentication_Methods
                </button>
            }
        </div>
    </div>

    <div id="panel-channels" class="d-none">
        <p class="text-muted fw-medium mb-2">
            @Localizer.Mfa_Authenticate_Yourself_Using
        </p>

        <div class="list-group mb-4 border-top border-bottom">
            @foreach (var method in Model.View.AvailableAuthenticationMethods)
            {
                <button type="submit"
                        name="ChangeSelectedMethodCode"
                        value="@method.Code"
                        class="list-group-item list-group-item-action border-0 py-3 channel-btn rounded-0
                                                       channel-@(method.DisplayName.ToKebabCase()) d-flex justify-content-between align-items-center
                                                       transition">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center" style="width: 2rem;">
                            <i class="@GetIconFromAuthenticationMethod(method) fs-4 text-primary"></i>
                        </div>
                        <div class="text-start">
                            <div class="small text-muted">
                                @Localizer.GetGeneric(method.Description)
                            </div>
                            <div class="small fw-semibold">
                                @Localizer.GetGeneric(method.DisplayName)
                            </div>
                        </div>
                    </div>
                    <div>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" class="text-muted">
                            <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                        </svg>
                    </div>
                </button>
            }
        </div>

        <div class="d-flex justify-content-start mt-2">
            <button id="go-back"
                    type="button"
                    class="btn btn-link text-decoration-none p-0 text-dark">
                ← @Localizer.Mfa_Back
            </button>
        </div>
    </div>
    <input type="hidden" name="Input.ResendOtp" value="" />
</form>
@functions {
    public string GetIconFromAuthenticationMethod(AuthenticationMethod method)
    {
        return method.DisplayName.ToLowerInvariant() switch
        {
            "viber" => "fa-brands fa-viber",
            "sms" => "fa-regular fa-message",
            "email" => "fa-regular fa-envelope",
            "authenticatorapp" => "fa-solid fa-shield-halved",
            "trusteddevice" => "fa-solid fa-mobile-screen",
            "fido2" => "fa-solid fa-fingerprint",
            "code" => "fa-solid fa-square-binary",
            _ => "fa-regular fa-message"
        };
    }
}