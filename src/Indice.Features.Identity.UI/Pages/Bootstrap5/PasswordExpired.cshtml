@page "/login/password-expired"

@model BasePasswordExpiredModel

@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.PasswordExpired_PageTitle;
    var tempData = TempData.Peek<ExtendedValidationTempDataModel>(BasePasswordExpiredModel.TempDataKey);
    var formDisabled = tempData?.DisableForm == true;
    var showNext = formDisabled && !string.IsNullOrWhiteSpace(tempData?.NextStepUrl);
}

<section class="auth-card">
    <vc:page-heading title="@Localizer.PasswordExpired_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="tempData?.Alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" class="auth-form" data-sbind="event: { change: formChanged }" data-token="@Base64Id.Parse(User.FindSubjectId()!)" data-userName="@(User.FindFirstValue(JwtClaimTypes.Name) ?? string.Empty)">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <input asp-for="Input.DeviceId" type="hidden" />
        <div class="field" indice-if="@(!formDisabled)">
            <label asp-for="Input.NewPassword" class="field__label">@Localizer.PasswordExpired_New_Password</label>
            <div class="field__group">
                <input class="form-control field__control password" type="password" placeholder="@Localizer.PasswordExpired_New_Password" asp-for="Input.NewPassword" disabled="@formDisabled" autocomplete="new-password" data-sbind="event: { keyup: passwordChanged }" aria-describedby="Input_NewPassword-error password-rules" />
                <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="field__error" id="Input_NewPassword-error"></span>
            <ul id="password-rules" class="password-rules" data-sbind="foreach: passwordRules" aria-live="polite">
                <li class="password-rules__item" data-sbind="text: $data.requirement, css: { 'password-rules__item--valid': $data.isValid }"></li>
            </ul>
        </div>
        <div class="field" indice-if="@(!formDisabled)">
            <label asp-for="Input.NewPasswordConfirmation" class="field__label">@Localizer.PasswordExpired_New_Password_Confirmation</label>
            <div class="field__group">
                <input class="form-control field__control password" type="password" placeholder="@Localizer.PasswordExpired_New_Password_Confirmation" asp-for="Input.NewPasswordConfirmation" disabled="@formDisabled" autocomplete="new-password" aria-describedby="Input_NewPasswordConfirmation-error" />
                <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPasswordConfirmation" class="field__error" id="Input_NewPasswordConfirmation-error"></span>
        </div>
        <div class="auth-form__actions @(showNext ? "auth-form__actions--split" : string.Empty)">
            <button class="btn btn-primary auth-form__submit" type="submit" disabled="@formDisabled" data-sbind="attr: { disabled: !isFormValid }">@Localizer.PasswordExpired_Save</button>
            @if (showNext)
            {
                <a class="btn btn-primary auth-form__submit" href="@tempData!.NextStepUrl">@Localizer.PasswordExpired_Next</a>
            }
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/reveal-password.js" csp-nonce="true"></script>
    @if (Model.View.GenerateDeviceId)
    {
        <script type="text/javascript" src="~/lib/@@fingerprintjs/fingerprintjs/dist/fp.min.js" csp-nonce></script>
        <script type="text/javascript" src="~/js/mfa.js" csp-nonce></script>
        <script type="text/javascript" csp-nonce>
            $(document).ready(function () {
                var viewModelParameters = {
                    $deviceIdInput: $('#Input_DeviceId'),
                    browserFamily: '@Request.GetBrowserName()'
                };
                var viewModel = new indice.mfaViewModelFactory(viewModelParameters);
                viewModel.init();
                viewModel.calculateDeviceId();
            });
        </script>
    }
}
