@page "/error"

@inject Indice.Features.Identity.UI.IdentityLabelsMessageDescriber Labels

@model BaseErrorModel

@{
    var title = ViewData["Title"] = Labels.Error_Error;
}

<section class="border-0 pt-5 error-page identity-panel">
    <article>
        <h1 class="text-danger text-start">@title</h1>
        <h2 class="text-danger">@Labels.Error_Oops_Seems_We_Encountered_An_Error</h2>
        <p class="pt-5">
            @if (Model?.Message is not null)
            {
                <strong>
                    <em>: @Model.Message</em>
                </strong>
            }
            @if (Model?.RequestId is not null)
            {
                <div class="request-id">@Labels.Error_Request_Id: @Model.RequestId</div>
            }
        </p>
    </article>
</section>
