@page "/error"

@inject IdentityUILocalizer Localizer

@model BaseErrorModel

@{
    ViewData["Title"] = Localizer.Error_PageTitle;
}

<section class="border-0 pt-5 error-page identity-panel">
    <article>
        <h1 class="text-danger text-start">@Localizer.Error_PageHeader</h1>
        <h2 class="text-danger">@Localizer.Error_Oops_Seems_We_Encountered_An_Error</h2>
        <p class="pt-5">
            @if (Model?.Message is not null)
            {
                <strong>
                    @Model.Title <em>: @Model.Message</em>
                </strong>
            }
            @if (Model?.RequestId is not null)
            {
                <div class="request-id">@Localizer.Error_Request_Id: @Model.RequestId</div>
            }
        </p>
    </article>
</section>
