@page "/login/mfa"
@using Indice.Extensions
@using Indice.Features.Identity.Core.Models

@model BaseMfaModel

@inject IdentityUILocalizer Localizer
@inject IConfiguration Configuration

@{
    ViewData["Title"] = Localizer.Mfa_PageTitle;
}

<div class="sign-in m-auto">
    <vc:page-heading title="@Localizer.Mfa_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <div indice-if="!Model.View.HasError">
        @if ((Model.View is { AuthenticationMethodDeliveryChannel: TotpDeliveryChannel.Sms or TotpDeliveryChannel.Viber, PhoneNumberAvailable: true }))
        {
            <partial name="_MfaSms" model="Model" />
        }

        @if ((Model.View is { AuthenticationMethodDeliveryChannel: TotpDeliveryChannel.Email, EmailAvailable: true }))
        {
            <partial name="_MfaEmail" model="Model" />
        }

        @if (Model.View.AuthenticationMethod?.GetDeliveryChannel() == TotpDeliveryChannel.PushNotification)
        {
            <partial name="_MfaPushNotification" model="Model" />
        }

        @if (Model.View.AuthenticationMethod?.Type == AuthenticationMethodType.AuthenticatorApp)
        {
            <partial name="_MfaAuthenticatorApp" model="Model" />
        }
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    @if (Model.View.AuthenticationMethod?.GetDeliveryChannel() == TotpDeliveryChannel.PushNotification)
    {
        <script type="text/javascript" src="~/lib/@@microsoft/signalr/dist/browser/signalr.min.js" csp-nonce></script>
    }
    <script type="text/javascript" src="~/lib/@@fingerprintjs/fingerprintjs/dist/fp.min.js" csp-nonce></script>
    <script type="text/javascript" src="~/js/mfa.js" csp-nonce></script>
    <script type="text/javascript" src="~/js/otp.js" csp-nonce></script>
    <script type="text/javascript" csp-nonce>
        $(document).ready(function () {
            var viewModelParameters = {
                $deviceIdInput: $('#Input_DeviceId'),
                $mfaForm: $('#mfa-form'),
                $mfaFormReject: $('#mfa-form-reject'),
                $otpCodeInput: $('#Input_OtpCode'),
                $rememberClientCheckbox: $('#Input_RememberClient'),
                browserFamily: '@(HttpContext.Request.GetBrowserName())',
                deliveryChannel: '@Model.View.AuthenticationMethod?.GetDeliveryChannel()',
                hubConnectionUrl: '@Model.View.HubConnectionUrl'
            };
            var viewModel = new indice.mfaViewModelFactory(viewModelParameters);
            viewModel.init();

            $('button[name="ChangeSelectedMethodCode"]').on('click', function() {
                $('input[name="Input.SelectedAuthenticationMethodCode"]').val($(this).val());
                $('input[name="Input.ResendOtp"]').val('true');
            });
        });
    </script>
    <script csp-nonce>
        $(function() {
            var $mainPanel = $('#panel-main'),
                $chanPanel = $('#panel-channels');

            function showElement($element) {
                $element.removeClass('d-none');
                $element.css('display', '');
                $element.show();
            }

            function hideElement($element) {
                $element.hide();
                $element.css('display', 'none');
            }

            $(document).on('click', '#show-channels, #otp-resend:not([name])', function(e) {
                e.preventDefault();
                hideElement($mainPanel);
                showElement($chanPanel);
            });

            $('#go-back').on('click', function() {
                hideElement($chanPanel);
                showElement($mainPanel);
            });

            $('.channel-btn').on('click', function() {
                $('.channel-btn').removeClass('active');
                $(this).addClass('active');
            });

            document.head.insertAdjacentHTML('beforeend',
                '<style>.transition { transition: all 0.2s ease-in-out; } ' +
                '.channel-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }</style>');
        });
    </script>
}
