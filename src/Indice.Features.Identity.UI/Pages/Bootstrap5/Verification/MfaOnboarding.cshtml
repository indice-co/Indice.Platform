@page "/login/mfa/onboarding"
@using Indice.Features.Identity.Core.Models

@model BaseMfaOnboardingModel

@inject IConfiguration Configuration
@inject IdentityUILocalizer Localizer


@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer.MfaOnBoarding_PageTitle;
    var iconSprite = IdentityUIIcons.GetSpriteHref(ViewContext);
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.MfaOnBoarding_Keep_Your_Account_Safe" subtitle="@Localizer.MfaOnBoarding_Setup_An_Additional_Authentication_Method" image-src="" />
    <form class="auth-form" asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate>
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <input type="hidden" data-sbind="value: selectedMethodType" asp-for="Input.SelectedAuthenticationMethod" />
        <ul id="authentication-methods" class="choice-list choice-list--radio" role="radiogroup" aria-label="@Localizer.MfaOnBoarding_Setup_An_Additional_Authentication_Method">
            <!-- ko foreach: authenticationMethods -->
            <li class="choice-list__item" data-sbind="css: { 'choice-list__item--selected': selected }">
                <label class="choice-list__label">
                    <input type="radio" name="onboarding-method" class="form-check-input choice-list__radio" data-sbind="checked: $parent.selectedMethod, checkedValue: $data, attr: { value: type }, event: { change: $parent.methodSelected }" />
                    <span class="choice-list__icon"><svg class="icon" aria-hidden="true" focusable="false" width="1em" height="1em"><use data-sbind="attr: { href: iconHref }"></use></svg></span>
                    <span class="choice-list__body">
                        <span class="choice-list__title" data-sbind="text: displayName"></span>
                        <span class="choice-list__desc" data-sbind="text: description"></span>
                    </span>
                </label>
            </li>
            <!-- /ko -->
        </ul>
        <span asp-validation-for="Input.SelectedAuthenticationMethod" class="field__error"></span>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" name="button" value="login" type="submit">@Localizer.MfaOnBoarding_Next</button>
        </div>
    </form>
</section>

@section scripts {
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/mfa-onboarding.js" csp-nonce></script>
    <script type="text/javascript" csp-nonce>
        var viewModelParameters = {
            authenticationMethods: @Html.Raw(JsonSerializer.Serialize(Model.View.AuthenticationMethods, JsonSerializerOptionDefaults.GetDefaultSettings())),
            icons: @Html.Raw(JsonSerializer.Serialize(Model.View.AuthenticationMethods.ToDictionary(x => x.Code, x => $"{iconSprite}#{IdentityUIIcons.ForAuthenticationMethod(x.Code)}"), JsonSerializerOptionDefaults.GetDefaultSettings()))
        };
        var viewModel = new indice.MfaOnboardingViewModelFactory(viewModelParameters);
        viewModel.init();
        ko.bindingProvider.instance = new ko.secureBindingsProvider();
        ko.applyBindings(viewModel);
    </script>
}
