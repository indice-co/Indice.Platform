@page "/consent"

@inject IdentityUILocalizer Localizer


@model BaseConsentModel

@{
    ViewData["Title"] = Localizer.Consent_PageTitle;
    var logoUrl = !string.IsNullOrEmpty(Model.View.ClientLogoUrl)
        ? (Url.IsLocalUrl(Model.View.ClientLogoUrl) ? Url.Content(Model.View.ClientLogoUrl) : Model.View.ClientLogoUrl)
        : Url.Content($"~/avatar/{Model.View.ClientName}/128.jpg");
}

<section class="auth-card auth-card--wide consent">
    <header class="auth-card__header">
        <img class="auth-card__image" src="@logoUrl" alt="" />
        <h1 class="auth-card__title">@Model.View.ClientName</h1>
        <p class="auth-card__subtitle">
            @if (Model.View.ClientUrl is not null)
            {
                <text>@Localizer.Consent_This <a target="_blank" rel="noopener" href="@Model.View.ClientUrl">@Localizer.Consent_App</a> @(Localizer.Consent_Would_Like_To):</text>
            }
            else
            {
                <text>@(Localizer.Consent_This_App_Would_Like_To):</text>
            }
        </p>
        <p class="consent__hint">* @Localizer.Consent_Uncheck_The_Permissions_You_Do_Not_Wish_To_Grant</p>
    </header>
    <partial name="_ValidationSummary" />
    <form asp-page="/Consent" class="auth-form consent-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <fieldset indice-if="Model.View.IdentityScopes.Any()" class="consent__group">
            <legend class="consent__legend"><i class="fa-regular fa-address-card" aria-hidden="true"></i> @Localizer.Consent_Personal_Information</legend>
            <ul class="choice-list">
                @foreach (var scope in Model.View.IdentityScopes)
                {
                    <partial name="_ScopeListItem" model="@scope" />
                }
            </ul>
        </fieldset>
        <fieldset indice-if="Model.View.ApiScopes.Any()" class="consent__group">
            <legend class="consent__legend"><i class="fa-solid fa-key" aria-hidden="true"></i> @Localizer.Consent_Application_Access</legend>
            <ul class="choice-list">
                @foreach (var scope in Model.View.ApiScopes)
                {
                    <partial name="_ScopeListItem" model="@scope" />
                }
            </ul>
        </fieldset>
        <div indice-if="Model.View.AllowRememberConsent" class="consent__remember">
            <div class="form-check">
                <input class="consent-scopecheck form-check-input" asp-for="Input.RememberConsent" />
                <label asp-for="Input.RememberConsent" class="form-check-label">@Localizer.Consent_Remember_My_Decision</label>
            </div>
        </div>
        <div class="auth-form__actions auth-form__actions--split">
            <button type="submit" name="button" value="no" class="btn btn-outline-secondary auth-form__submit">@Localizer.Consent_Cancel</button>
            <button type="submit" id="submitConsent" name="Input.Button" value="yes" class="btn btn-primary auth-form__submit" autofocus>@Localizer.Consent_Accept</button>
        </div>
    </form>
</section>
