@page "/login/mfa/onboarding/verify-email"
@using Microsoft.AspNetCore.Html

@model BaseMfaOnboardingVerifyEmailModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer
@inject ExtendedUserManager<User> UserManager

@{
    Layout = "_AuthLayout";
    ViewBag.Title = Localizer.MfaOnBoardingVerifyEmail_PageTitle;
    var infoMessage = TempData.Peek<ExtendedValidationTempDataModel>(BaseMfaOnboardingVerifyEmailModel.TempDataKey);
    
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.MfaOnBoardingVerifyEmail_PageHeader" image-src=""
                     subtitle="new HtmlString(UserManager.MessageDescriber.MfaVerifyEmailValidationMissingEmail)" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="infoMessage?.Alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" novalidate class="auth-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <input type="hidden" asp-for="Input.Email" />
        <div class="field">
            <label asp-for="Input.Code" class="field__label">@Localizer.MfaOnBoardingVerifyEmail_Code</label>
            <input class="form-control field__control otp-field__input" data-otp-length="6" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="@Localizer.MfaOnBoardingVerifyEmail_Code" asp-for="Input.Code" disabled="@displayNext" autofocus aria-describedby="Input_Code-error" />
            <span asp-validation-for="Input.Code" class="field__error" id="Input_Code-error"></span>
        </div>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.MfaOnBoardingVerifyEmail_Save</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/js/otp-field.js" csp-nonce></script>
}
