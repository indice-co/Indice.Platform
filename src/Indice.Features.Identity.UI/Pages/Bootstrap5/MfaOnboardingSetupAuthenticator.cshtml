@page "/login/mfa/onboarding/setup-authenticator"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login/mfa/onboarding/setup-authenticator")]
@model BaseMfaOnboardingSetupAuthenticatorModel

@inject IdentityUILocalizer Localizer

@{
    ViewBag.Title = Localizer.MfaOnBoardingSetupAuthenticator_PageTitle;
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.MfaOnBoardingSetupAuthenticator_PageHeader" subtitle="@Localizer.MfaOnBoardingSetupAuthenticator_ScanQrCode" image-src="" />
    <partial name="_ValidationSummary" />

    <div class="mfa__qr">
        <div id="qrCode" role="img" aria-label="QR"></div>
    </div>
    <div id="qrCodeData" data-url="@Model.View.AuthenticatorUri" class="d-none"></div>

    <p class="field__help">@Localizer.MfaOnBoardingSetupAuthenticator_OrEnterManually</p>
    <p class="mfa__key">@Model.View.FormattedSharedKey</p>

    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" novalidate class="auth-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="field">
            <label asp-for="Input.Code" class="field__label">@Localizer.MfaOnBoardingSetupAuthenticator_VerificationCode</label>
            <input asp-for="Input.Code"
                   class="form-control field__control otp-field__input"
                   data-otp-length="@Model.View.AuthenticatorDigits"
                   placeholder="@Localizer.MfaOnBoardingSetupAuthenticator_VerificationCode"
                   autocomplete="one-time-code"
                   inputmode="numeric"
                   maxlength="@Model.View.AuthenticatorDigits"
                   autofocus
                   aria-describedby="Input_Code-error" />
            <span asp-validation-for="Input.Code" class="field__error" id="Input_Code-error"></span>
        </div>
        <div class="auth-form__actions">
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.MfaOnBoardingSetupAuthenticator_Verify</button>
        </div>
        <a asp-page="/MfaOnboarding" class="mfa__back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> @Localizer.Mfa_Back
        </a>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/qrcodejs2/qrcode.min.js" csp-nonce></script>
    <script type="text/javascript" src="~/js/qr.js" csp-nonce></script>
    <script type="text/javascript" src="~/js/otp-field.js" csp-nonce></script>
}
