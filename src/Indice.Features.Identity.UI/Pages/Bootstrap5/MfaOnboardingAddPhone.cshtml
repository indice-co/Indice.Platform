@page "/login/mfa/onboarding/add-phone"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login/mfa/onboarding/add-phone")]
@model BaseMfaOnboardingAddPhoneModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer


@{
    ViewBag.Title = Localizer.MfaOnBoardingAddPhone_PageTitle;
    var alert = TempData.Peek<AlertModel>(BaseMfaOnboardingAddPhoneModel.TempDataKey);
}

<div class="sign-in m-auto">
    <vc:page-heading title="@Localizer.MfaOnBoardingAddPhone_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="alert" />
    <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" novalidate>
        <div class="mb-3">
            <input type="hidden" asp-for="Input.ReturnUrl" />
            <label asp-for="Input.PhoneNumber" class="form-label visually-hidden">@Localizer.MfaOnBoardingAddPhone_Phone_Number</label>
            <input type="hidden" data-env="@HostingEnvironment.EnvironmentName" />
            <input class="form-control" type="text" placeholder="@Localizer.MfaOnBoardingAddPhone_Phone_Number" asp-for="Input.PhoneNumber" readonly="@Model.View.DisablePhoneNumberInput" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <div class="row m-0 w-100">
                @if (!string.IsNullOrEmpty(Model.View.NextStepUrl))
                {
                    <a class="btn btn-info w-100" href="@Model.View.NextStepUrl">@Localizer.MfaOnBoardingAddPhone_Next</a>
                }
                else
                {
                    <button class="btn btn-info w-100" type="submit">@Localizer.MfaOnBoardingAddPhone_Save</button>
                }
            </div>
        </div>
    </form>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
}
