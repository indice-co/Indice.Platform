@page "/forgot-password/confirmation"

@model BaseForgotPasswordConfirmationModel

@inject IdentityUILocalizer Localizer
@inject IOptions<IdentityUIOptions> identityUiOptions

@{
    ViewData["Title"] = Localizer.ForgotPasswordConfirmation_PageTitle;
}

<section class="auth-card">
    <vc:page-heading title="@Localizer.ForgotPasswordConfirmation_PageHeader" subtitle="@(!Model.PasswordSuccessfullyChanged ? Localizer.ForgotPasswordConfirmation_Please_Fill_In_Your_New_Password : null)" image-src="" />
    <partial name="_ValidationSummary" />
    @if (!Model.PasswordSuccessfullyChanged)
    {
        <form data-sbind="event: { change: formChanged }" method="post" autocomplete="off" class="auth-form" data-token="@Base64Id.Parse(Model.View.UserId!)" data-userName="@Model.View.UserName">
            <input asp-for="Input.Token" type="hidden" class="form-control" />
            <input asp-for="Input.ReturnUrl" type="hidden" class="form-control" />
            <input asp-for="Input.DeviceId" type="hidden" />
            <div class="field">
                <label asp-for="Input.Email" class="field__label">@Localizer.Email</label>
                <input asp-for="Input.Email" readonly="readonly" class="form-control field__control" />
            </div>
            <div class="field">
                <label asp-for="Input.NewPassword" class="field__label">@Localizer.ForgotPasswordConfirmation_New_Password</label>
                <div class="field__group">
                    <input type="password" class="form-control field__control password" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" placeholder="@Localizer.ForgotPasswordConfirmation_New_Password" autocomplete="new-password" autofocus aria-describedby="Input_NewPassword-error password-rules" />
                    <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="field__error" id="Input_NewPassword-error"></span>
                <ul id="password-rules" class="password-rules" data-sbind="foreach: passwordRules" aria-live="polite">
                    <li class="password-rules__item" data-sbind="text: $data.requirement, css: { 'password-rules__item--valid': $data.isValid }"></li>
                </ul>
            </div>
            @if (identityUiOptions.Value.EnablePasswordConfirmation)
            {
                <div class="field">
                    <label asp-for="Input.NewPasswordConfirmation" class="field__label">@Localizer.ForgotPasswordConfirmation_New_Password_Confirmation</label>
                    <div class="field__group">
                        <input type="password" class="form-control field__control password" asp-for="Input.NewPasswordConfirmation" placeholder="@Localizer.ForgotPasswordConfirmation_New_Password_Confirmation" autocomplete="new-password" aria-describedby="Input_NewPasswordConfirmation-error" />
                        <button type="button" class="field__reveal" aria-pressed="false" aria-label="@Localizer.Password_Show" title="@Localizer.Password_Show" data-label-show="@Localizer.Password_Show" data-label-hide="@Localizer.Password_Hide">
                            <i class="fa-regular fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPasswordConfirmation" class="field__error" id="Input_NewPasswordConfirmation-error"></span>
                </div>
            }
            <div class="auth-form__actions">
                <button class="btn btn-primary auth-form__submit" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Localizer.ForgotPasswordConfirmation_Send</button>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-success" role="status">
            <strong>@Localizer.ForgotPasswordConfirmation_Password_Changed.</strong> @Localizer.ForgotPasswordConfirmation_LoginLink(Model.Input.ReturnUrl!)
        </div>
    }
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/password-rules.js" csp-nonce="true"></script>
    <script type="text/javascript" src="~/js/reveal-password.js" csp-nonce="true"></script>
    @if (Model.View.GenerateDeviceId)
    {
        <script type="text/javascript" src="~/lib/@@fingerprintjs/fingerprintjs/dist/fp.min.js" csp-nonce></script>
        <script type="text/javascript" src="~/js/mfa.js" csp-nonce></script>
        <script type="text/javascript" csp-nonce>
            $(document).ready(function () {
                var viewModelParameters = {
                    $deviceIdInput: $('#Input_DeviceId'),
                    browserFamily: '@Request.GetBrowserName()'
                };
                var viewModel = new indice.mfaViewModelFactory(viewModelParameters);
                viewModel.init();
                viewModel.calculateDeviceId();
            });
        </script>
    }
}
