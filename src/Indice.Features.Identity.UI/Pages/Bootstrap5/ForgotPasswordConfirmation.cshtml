@page "/forgot-password/confirmation"

@model BaseForgotPasswordConfirmationModel

@inject IdentityUILocalizer Localizer

@{
    var title = ViewData["Title"] = Localizer.ForgotPasswordConfirmation_PageTitle;
}

<section class="sign-in p-5 m-auto">
    <vc:page-heading title="@Localizer.ForgotPasswordConfirmation_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    @if (!Model.PasswordSuccessfullyChanged)
    {
        <form data-sbind="event: { change: formChanged }" method="post" autocomplete="off" data-token="@Base64Id.Parse(Model.View.UserId!)" data-userName="@Model.View.UserName">
            <input asp-for="Input.Token" type="hidden" class="form-control" />
            <input asp-for="Input.ReturnUrl" type="hidden" class="form-control" />
			<partial name="_Alert" model="AlertModel.Info(@Localizer.ForgotPasswordConfirmation_Please_Fill_In_Your_New_Password)" />
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label control-label"></label>
                <input asp-for="Input.Email" readonly="readonly" class="form-control" />
            </div>
            <div class="mb-3">
                <input type="password" class="form-control" asp-for="Input.NewPassword" data-sbind="event: { keyup: passwordChanged }" placeholder="@Localizer.ForgotPasswordConfirmation_New_Password" autofocus />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <div id="password-rules" class="password-rules">
                    <ul data-sbind="foreach: passwordRules">
                        <li class="password-rule" data-sbind="text: $data.requirement, css: { 'rule-valid': $data.isValid }"></li>
                    </ul>
                </div>
            </div>
            <div class="mb-3">
                <button class="btn btn-primary w-100" type="submit" data-sbind="attr: { disabled: !isFormValid }">@Localizer.ForgotPasswordConfirmation_Send</button>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-success" role="alert">
            <strong>@Localizer.ForgotPasswordConfirmation_Password_Changed.</strong> @Localizer.ForgotPasswordConfirmation_LoginLink(Model.Input.ReturnUrl!))
        </div>
    }
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="/lib/knockout/build/output/knockout-latest.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/lib/knockout-secure-binding/dist/knockout-secure-binding.min.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/utilities.js" csp-nonce="true"></script>
    <script type="text/javascript" src="/js/password-rules.js" csp-nonce="true"></script>
}
