@page "/login/accept-terms"

@model BaseAcceptTermsModel
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.AcceptTerms_PageTitle;
    ViewData["Shell"] = "article";
}

<article class="article-card">
    <header class="article-card__header">
        <h1 class="article-card__title">@Localizer.AcceptTerms_PageHeader</h1>
        <p class="article-card__meta">@Localizer.AcceptTerms_ReadAndAcceptTerms</p>
    </header>
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="Model.View.Alert" />
    <iframe src="~/terms?raw=true" class="article-card__frame" title="@Localizer.Terms_PageTitle"></iframe>
    <form asp-route-returnUrl="@Model.View.ReturnUrl" method="post" class="auth-form article-card__actions">
        <div class="auth-form__actions auth-form__actions--split">
            <a class="btn btn-outline-secondary auth-form__submit" href="~/">@Localizer.AcceptTerms_Reject</a>
            <button class="btn btn-primary auth-form__submit" type="submit">@Localizer.AcceptTerms_Accept</button>
        </div>
        <input type="hidden" asp-for="View.ReturnUrl" />
    </form>
</article>
