@page "/associate"

@model BaseAssociateModel

@inject IdentityUILocalizer Localizer

@{
    var title = ViewData["Title"] = Localizer.Register_Associate_your_Account(Model.View.Provider);
}

<section class="sign-up m-auto">
    <vc:page-heading title="@title" image-src="" />
    <partial name="_ValidationSummary" />
    <form asp-page="/Associate" method="post" autocomplete="off" novalidate>
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <input type="hidden" asp-for="Input.UserName" />
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.FirstName" class="form-label">@Localizer.Profile_First_Name</label>
                    <input class="form-control" type="text" asp-for="Input.FirstName" placeholder="@Localizer.Profile_First_Name" autofocus />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label">@Localizer.Profile_Last_Name</label>
                    <input class="form-control" type="text" asp-for="Input.LastName" placeholder="@Localizer.Profile_Last_Name" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label">@Localizer.Profile_Phone_Number</label>
                    <input class="form-control" type="tel" asp-for="Input.PhoneNumber" placeholder="@Localizer.Profile_Phone_Number" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">@Localizer.Email</label>
                    <input class="form-control" type="email" asp-for="Input.Email" placeholder="@Localizer.Email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label class="checkbox">
                        <input asp-for="Input.HasAcceptedTerms" type="checkbox" />
                        @Localizer.Register_I_Have_Read_And_Accept_Terms
                    </label>
                    <span asp-validation-for="Input.HasAcceptedTerms" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label class="checkbox">
                        <input asp-for="Input.HasReadPrivacyPolicy" type="checkbox" />
                        @Localizer.Register_I_Consent_To_Registration
                        <a style="font-weight:bold" asp-page="/Privacy" target="_blank">@Localizer.Register_Here.</a>.
                    </label>
                    <span asp-validation-for="Input.HasReadPrivacyPolicy" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row align-items-center">
            <div class="col-xl-6 col-12">
                <div class="mb-3">
                    <button class="btn btn-primary w-100 btn-hover" type="submit">@Localizer.Register_Register</button>
                </div>
            </div>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
}
