@page "/manage/profile"


@inject CallingCodesProvider callingCodesProvider
@inject IOptions<IdentityUIOptions> identityUiOptions
@inject ExtendedUserManager<User> userManager
@inject IdentityUILocalizer Localizer

@model BaseProfileModel

@{
    ViewData["Title"] = Localizer.Profile_PageTitle;
    var alert = TempData.Get<AlertModel>("Alert");
}

<section class="identity-panel wide m-auto">
    <div class="text-center">
        <form asp-page-handler="UploadPicture" enctype="multipart/form-data">
            <div class="profilepic">
                <img class="profilepic__image" profile-pic="128" profile-display-name="@Model.Input.DisplayName" profile-pic-background="cecece" />
                <div class="profilepic__content">
                    <span class="profilepic__icon"><i class="fas fa-camera"></i></span>
                    <span class="profilepic__text">Edit</span>
                    <input type="file" id="profile_picture" name="file" accept="image/*" style="position: absolute;opacity: 0;width:100%;height:100%" />
                </div>
            </div>
        </form>
        <script csp-nonce="true">
            var fileInput = document.getElementById('profile_picture');
            fileInput.addEventListener('change', function () {
                fileInput.closest('form').submit();
            });
        </script>
        <h4 class="header-text">@Model.Input.DisplayName</h4>
    </div>
    <div id="send-confirmation-success" class="alert alert-success d-none" style="margin-bottom: 5px;">
        @Localizer.Profile_A_Confirmation_Email_Has_Been_Sent_To(Model.View.Email ?? throw new InvalidOperationException("User email cannot be null."))
    </div>
    <div id="send-confirmation-error" class="alert alert-danger d-none" style="margin-bottom: 5px;">
        @Localizer.Profile_Confirmation_Email_Delivery_Failed_Please_Contact_System_Administrator
    </div>
    @if (Model.ProfileSuccessfullyChanged)
    {
        var message = Localizer.Profile_Your_Profile_Was_Updated_Successfully.Value!;
        if (Model.EmailChangeRequested)
        {
            message += Localizer.Profile_EmailSentToNewEmail.Value;
        }
        <partial name="_Alert" model="@AlertModel.Success(message)" />
    }
    @if (Model.View.EmailChangePending && !Model.ProfileSuccessfullyChanged)
    {
		<partial name="_Alert" model="@AlertModel.Warn(Localizer.Profile_Your_New_Email_Verification_Is_Still_Pending.ToString())" />
    }
    <partial name="_Alert" model="alert" />
    <partial name="_ValidationSummary" />
    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.FirstName" class="form-label">@Localizer.Profile_First_Name</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_First_Name" asp-for="Input.FirstName" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label">@Localizer.Profile_Last_Name</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_Last_Name" asp-for="Input.LastName" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label">@Localizer.Profile_Username</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_Username" asp-for="Input.UserName" readonly="@userManager.EmailAsUserName" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">
                        @Localizer.Email
                        <a indice-if="Model.View.EmailChangePending" href="#" id="resend-email-link" style="font-size: x-small;">(@Localizer.Profile_Confirmation →)</a>
                    </label>
                    <input class="form-control" type="text" placeholder="@Localizer.Email" asp-for="Input.Email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div indice-if="identityUiOptions.Value.EnablePhoneNumberCallingCodes" class="col-md-6">
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.CallingCode">@Localizer.Profile_Calling_Code</label>
                    <select class="form-control lh-lg" asp-for="Input.CallingCode" required>
                        <option value="" selected>@Localizer.Profile_Choose</option>
                        @foreach (var callingCode in callingCodesProvider.GetSupportedCallingCodes())
                        {
                            <option value="@callingCode">@callingCode.DisplayName</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CallingCode" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label">@Localizer.Profile_Phone_Number</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_Phone_Number" asp-for="Input.PhoneNumber" />
                    <span asp-validation-for="Input.PhoneNumberWithCallingCode" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.Tin" class="form-label">@Localizer.Profile_Tax_Identification</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_Tax_Identification" asp-for="Input.Tin" />
                    <span asp-validation-for="Input.Tin" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.BirthDate" class="form-label">@Localizer.Profile_Birth_Date</label>
                    <input class="form-control" type="date" placeholder="@Localizer.Profile_Birth_Date" asp-for="Input.BirthDate" />
                    <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row" indice-if="Model.View.HasDeveloperTotp">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Input.DeveloperTotp" class="form-label">@Localizer.Profile_Developer_TOTP</label>
                    <input class="form-control" type="text" placeholder="@Localizer.Profile_Developer_TOTP" readonly="readonly" asp-for="Input.DeveloperTotp" />
                </div>
            </div>
        </div>
        <div class="mb-3">
            <div class="form-check custom-checkbox d-inline-block">
                <label class="form-check-label" asp-for="Input.ConsentCommercial">
                    <input asp-for="Input.ConsentCommercial" type="checkbox" class="form-check-input text-info" />
                    <span class="control flex-shrink-0"></span>
                    <span class="d-inline">
                        @Localizer.Profile_I_Have_Been_Informed_About_The_Processing_Of_My_Personal_Data_And_I_Consent_To_It_As_Specifically_Defined
                        <a style="font-weight:bold" target="_blank" href="/privacy" onclick="event.stopPropagation();">@Localizer.Profile_Here.</a>
                    </span>
                </label>

            </div>
        </div>
        <div class="mb-3">
            <div class="row m-0 w-100">
                <div class="col-12 py-1">
                    <button class="btn btn-primary w-100" type="submit">@Localizer.Profile_Save</button>
                </div>
            </div>
        </div>
    </form>
</section>
<br />
<section class="identity-panel wide m-auto" indice-if="Model.View.SupportedCultures.Count > 0">
    <h4>
        <span class="header-text text-center">@Localizer.Profile_Preferences</span>
    </h4>
    
    <form id="userPreferenceForm" method="post" asp-page-handler="UpdateLanguagePreference">
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="InputLanguagePreference.Locale" class="form-label">@Localizer.Profile_PreferredLanguage</label>
                    <select class="form-control form-select lh-lg" asp-for="InputLanguagePreference.Locale" required>
                        <option value="">@Localizer.Profile_Choose</option>
                        @foreach (var culture in Model.View.SupportedCultures)
                        {
                            <option value="@culture.TwoLetterISOLanguageName" selected="@(culture.TwoLetterISOLanguageName.Equals(Model.View.Locale))">@culture.TwoLetterISOLanguageName.ToUpperInvariant() - @culture.NativeName</option>
                        }
                    </select>
                    <span asp-validation-for="InputLanguagePreference.Locale" class="text-danger"></span>
                </div>
            </div>
        </div>
    </form>
</section>
<br />
<section class="identity-panel wide m-auto" indice-if="Model.View.CurrentLogins?.Count > 0 || Model.View.OtherLogins.Count > 0">
    <h2>
        <span class="header-text text-center">@Localizer.Profile_External_Providers</span>
    </h2>
    @{
        var alertProviders = TempData.Get<AlertModel>("AlertProviders");
    }
    <partial name="_Alert" model="alertProviders" />
    @if (Model.View.CurrentLogins.Count > 0)
    {
        <div class="login-form">
            <h4>@Localizer.Profile_Existing_Providers</h4>
            @foreach (var provider in Model.View.CurrentLogins)
            {
                <div class="row idp-@provider.LoginProvider.ToLower()">
                    <div class="col-sm-9">
                        <a class="btn btn-@provider.LoginProvider.ToLower() btn-hover btn-md inline-block cursor-pointer">
                            @Localizer.GetGeneric(string.IsNullOrEmpty(provider.ProviderDisplayName) ? provider.LoginProvider : provider.ProviderDisplayName)</a>
                    </div>
                    <div class="col-sm-3">
                        <form asp-page-handler="RemoveLogin" method="post" class="inline">
                            <input asp-for="InputLoginLink.LoginProvider" type="hidden" value="@provider.LoginProvider" />
                            <input asp-for="InputLoginLink.ProviderKey" type="hidden" value="@provider.ProviderKey" />
                            <button type="submit" class="btn btn-remove remove-idp btn-md" disabled="@(!Model.View.CanRemoveProvider)">@Localizer.Profile_Remove</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    @if (Model.View.OtherLogins.Count > 0)
    {
        <div class="mt-3">
            <h4>@Localizer.Profile_Connect_A_New_Provider</h4>
            <ul class="list-unstyled">
                @foreach (var provider in Model.View.OtherLogins)
                {
                    <li class="idp idp-@provider.Name.ToLower()">
                        <a class="btn btn-@provider.Name.ToLower() btn-hover" asp-page-handler="LinkLogin" asp-route-provider="@provider.Name">
                            @Localizer.GetGeneric(provider.DisplayName ?? "Unknown")
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</section>

@section scripts {
    <script type="text/javascript" csp-nonce="true">
        $(document).ready(function () {
            $('#resend-email-link').click(function () {
                $.ajax({
                    url: '@Url.PageLink(pageName: "/ConfirmEmail", pageHandler: "Resend")',
                    type: 'GET',
                    dataType: 'json',
                    statusCode: {
                        204: function () {
                            $('#resend-email-link').addClass('disabled');
                            $('#send-confirmation-success').removeClass('d-none');
                        },
                        500: function () {
                            $('#send-confirmation-error').removeClass('d-none');
                        }
                    }
                });
            });
        });
    </script>
    <partial name="_ValidationScripts" />
    <script csp-nonce="true">
        document.querySelectorAll('.idp a').forEach(function (el) {
            el.onclick = function (link) {
                if (!link.target.classList.contains('disabled')) {
                    link.target.classList.add('disabled');
                }
            };
        });
    </script>
    <script csp-nonce="true">
        document.querySelectorAll('#userPreferenceForm select').forEach(function (el) {
            el.addEventListener("change", function (select) {
                document.getElementById('userPreferenceForm').submit();
            });
        });
    </script>
}
