@page "/login/verify-phone"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login/verify-phone")]
@model BaseVerifyPhoneModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer

@{
    ViewData["Title"] = Localizer.VerifyPhone_PageTitle;
    var tempData = TempData.Peek<ExtendedValidationTempDataModel>(BaseVerifyPhoneModel.TempDataKey);
    var displayNext = tempData is not null
        && tempData.Alert?.AlertType == AlertType.Success
        && !string.IsNullOrEmpty(tempData.NextStepUrl);
}

<section class="auth-card mfa">
    <vc:page-heading title="@Localizer.VerifyPhone_PageHeader" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="tempData?.Alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post" class="auth-form">
        <input type="hidden" asp-for="Input.PhoneNumber" />
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="field">
            <label asp-for="Input.Code" class="field__label">@Localizer.VerifyPhone_Code</label>
            <input class="form-control field__control otp-field__input" data-otp-length="6" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="@Localizer.VerifyPhone_Code" asp-for="Input.Code" disabled="@displayNext" aria-describedby="Input_Code-error" />
            <span asp-validation-for="Input.Code" class="field__error" id="Input_Code-error"></span>
        </div>
        <p class="otp-field__resend">
            <button type="submit"
                    id="otp-resend"
                    name="Input.OtpResend"
                    value="true"
                    class="otp-field__resend-btn">
                <span class="otp-field__resend-text">@Localizer.VerifyPhone_Resend</span>
                <span class="otp-field__wait">@Localizer.Mfa_ResendAvailableIn <span class="countdown otp-field__countdown"></span></span>
            </button>
        </p>
        <div class="auth-form__actions @(displayNext ? "auth-form__actions--split" : string.Empty)">
            <button class="btn btn-primary auth-form__submit" type="submit" disabled="@displayNext">@Localizer.VerifyPhone_Save</button>
            @if (displayNext)
            {
                <a class="btn btn-primary auth-form__submit" href="@tempData?.NextStepUrl">@Localizer.VerifyPhone_Next</a>
            }
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/js/otp.js" csp-nonce></script>
    <script type="text/javascript" src="~/js/otp-field.js" csp-nonce></script>
}
