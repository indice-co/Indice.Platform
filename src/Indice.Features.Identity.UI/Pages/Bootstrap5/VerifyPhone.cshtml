@page "/login/verify-phone"

@model BaseVerifyPhoneModel

@inject IWebHostEnvironment HostingEnvironment
@inject IdentityUILocalizer Localizer


@{
    var title = ViewData["Title"] = Localizer.VerifyPhone_Verify_Phone_Number;
    var tempData = TempData.Peek<ExtendedValidationTempDataModel>(BaseVerifyPhoneModel.TempDataKey);
    var displayNext = !string.IsNullOrEmpty(tempData?.NextStepUrl) && tempData?.Alert?.AlertType == AlertType.Success;
}

<div class="sign-in m-auto">
    <vc:page-heading title="@title" image-src="" />
    <partial name="_ValidationSummary" />
    <partial name="_Alert" model="tempData?.Alert" />
    <form asp-route-returnUrl="@Model.Input.ReturnUrl" method="post">
        <input type="hidden" asp-for="Input.PhoneNumber" />
        <input type="hidden" asp-for="Input.ReturnUrl" />
        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label visually-hidden">@Localizer.VerifyPhone_Code</label>
            <input class="form-control" type="text" placeholder="@Localizer.VerifyPhone_Code" asp-for="Input.Code" disabled="@displayNext" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <div class="row m-0 w-100">
                <div class="col-6 py-1">
                    <button class="btn btn-info w-100" type="submit" disabled="@displayNext">@Localizer.VerifyPhone_Save</button>
                </div>
                <div class="col-6 py-1">
                    <button class="btn btn-info w-100" type="submit" id="otp-resend" name="Input.OtpResend" value="true">@Localizer.VerifyPhone_Resend</button>
                </div>
                @if (displayNext)
                {
                    <div class="col-sm-6 col-12 py-1">
                        <a class="btn btn-info w-100" href="@tempData?.NextStepUrl">@Localizer.VerifyPhone_Next</a>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script type="text/javascript" src="~/js/otp.js" csp-nonce></script>
}
