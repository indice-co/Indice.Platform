  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Indice.Features.Messages.Core\Indice.Features.Messages.Core.csproj" />
    <ProjectReference Include="..\Indice.Hosting\Indice.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/Messaging-Product.md" Pack="true" PackagePath="docs\" />
    <None Include="../../docs/messaging-logo.svg" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
