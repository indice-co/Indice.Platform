    <PackageTags>AspNetCore;CampaignManagement;Workers</PackageTags>
    <VersionPrefix>$(VersionPrefixMessages)</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Indice.Features.Messages.Core" Version="$(VersionPrefixMessages)-*" />
