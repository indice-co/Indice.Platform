      "json": "{\r\n  \"swagger\": \"2.0\",\r\n  \"info\": {\r\n    \"title\": \"Cooperative Bank of Chania Risk APIs\",\r\n    \"version\": \"v1\"\r\n  },\r\n  \"paths\": {\r\n    \"/api/risk\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Risk\"\r\n        ],\r\n        \"summary\": \"Calculates the risk given a transaction presented in the system.\",\r\n        \"operationId\": \"GetRisk\",\r\n        \"consumes\": [\r\n          \"application/json\"\r\n        ],\r\n        \"produces\": [\r\n          \"application/problem+json\",\r\n          \"application/json\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"body\",\r\n            \"name\": \"body\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/RiskModel\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/ProblemDetails\"\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/ProblemDetails\"\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/ProblemDetails\"\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/AggregateRuleExecutionResult\"\r\n            }\r\n          },\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"schema\": {\r\n              \"$ref\": \"#/definitions/HttpValidationProblemDetails\"\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\