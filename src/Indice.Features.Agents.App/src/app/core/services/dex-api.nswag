{
  "runtime": "Net100",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": "{\r\n  \"openapi\": \"3.1.1\",\r\n  \"info\": {\r\n    \"title\": \"Dex REST API\",\r\n    \"contact\": {\r\n      \"name\": \"Indice Developer\",\r\n      \"url\": \"https://www.indice.gr\"\r\n    },\r\n    \"version\": \"1.0.0\"\r\n  },\r\n  \"servers\": [\r\n    {\r\n      \"url\": \"https://localhost:2001/\"\r\n    }\r\n  ],\r\n  \"paths\": {\r\n    \"/api/documents/clear\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Documents\"\r\n        ],\r\n        \"summary\": \"Clears the knowledge base.\",\r\n        \"description\": \"Clears all documents and their chunks from the knowledge base.\",\r\n        \"operationId\": \"Clear\",\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"422\": {\r\n            \"description\": \"Unprocessable Entity\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"ingest\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/documents/ingest\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Documents\"\r\n        ],\r\n        \"summary\": \"Ingests a document into the knowledge base.\",\r\n        \"description\": \"Uploads a single Markdown file and processes it into the knowledge base.\",\r\n        \"operationId\": \"DocumentIngest\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"multipart/form-data\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/DocumentIngestRequest\"\r\n              },\r\n              \"example\": {\r\n                \"language\": \"el\",\r\n                \"isPrivate\": false,\r\n                \"category\": \"FAQ\",\r\n                \"actualSourceUrl\": \"\",\r\n                \"documentType\": \"MarkdownFaq\"\r\n              }\r\n            },\r\n            \"application/x-www-form-urlencoded\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/DocumentIngestRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"422\": {\r\n            \"description\": \"Unprocessable Entity\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/IngestionReport\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"ingest\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"List the caller's chat sessions, paged.\",\r\n        \"description\": \"Returns a paged list of sessions owned by the caller, ordered by most recent activity.\",\r\n        \"operationId\": \"List\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"Page\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The current page of the list. Default is 1.\",\r\n            \"schema\": {\r\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n              \"type\": [\r\n                \"null\",\r\n                \"integer\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Size\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The size of the list. Default is 100\",\r\n            \"schema\": {\r\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n              \"type\": [\r\n                \"null\",\r\n                \"integer\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Sort\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\r\n            \"schema\": {\r\n              \"type\": [\r\n                \"null\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Search\",\r\n            \"in\": \"query\",\r\n            \"description\": \"A search term used to limit the results of the list.\",\r\n            \"schema\": {\r\n              \"type\": [\r\n                \"null\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ConversationListItemResultSet\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      },\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Create a chat session with the first question.\",\r\n        \"description\": \"Creates a new chat session for the calling user and runs the first question through the RAG pipeline in one round-trip. Returns 201 with the grounded answer, citations, usage, and the new session id.\",\r\n        \"operationId\": \"Create\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"201\": {\r\n            \"description\": \"Created\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/DexChatResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Get a chat session with its recent messages.\",\r\n        \"description\": \"Returns session metadata (title, timestamps, cumulative token totals) plus the most recent messages in chronological order.\",\r\n        \"operationId\": \"GetChatSession\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/DexConversation\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      },\r\n      \"delete\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Delete a chat session and its messages.\",\r\n        \"description\": \"Permanently deletes the session and all its messages. Returns 204 on success, 404 when the session does not exist for the calling user.\",\r\n        \"operationId\": \"Delete\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}/messages\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Post a follow-up message to an existing chat session.\",\r\n        \"description\": \"Loads bounded conversation history, runs the message through the RAG pipeline, persists the user/assistant turn, and returns the grounded answer + cumulative session token totals.\",\r\n        \"operationId\": \"SendMessage\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/DexChatResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}/messages/{messageId}/like\": {\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Like or unlike a message in a chat session.\",\r\n        \"description\": \"Marks the message as liked or unliked by the caller. Returns 204 on success, 404 when the session or message does not exist for the calling user.\",\r\n        \"operationId\": \"Like\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"messageId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/LikeRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}/messages/stream\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Stream a follow-up turn over Server-Sent Events.\",\r\n        \"description\": \"Streaming counterpart of `POST /api/my/chats/{chatId}/messages`. Emits the same message/delta frames as\\r\\n`POST /api/my/chats/stream` — `start`, `status` progress, `delta` text chunks, then the completion parts\\r\\n(`citations`/`sources`/`usage`) and the terminal `done` (or `error`). Returns 404 before any frame is sent\\r\\nwhen the session does not exist for the caller. (SwaggerUI cannot render SSE — use a streaming client,\\r\\ne.g. `curl -N`.)\",\r\n        \"operationId\": \"StreamMessage\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"text/event-stream\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SseItemOfDexChatResponseUpdate\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/stream\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Create a chat session and stream the first turn over Server-Sent Events.\",\r\n        \"description\": \"Streaming counterpart of `POST /api/my/chats`. Creates a session and streams the first turn as\\r\\n`text/event-stream` frames of the Dex message/delta protocol. Answer text rides the `delta` SSE event\\r\\n(`{\\\"type\\\":\\\"delta\\\",\\\"text\\\":\\\"…\\\"}` — append chunks in arrival order); every other frame rides the default\\r\\n`message` event, discriminated by `type`:\\r\\n\\r\\n- `start` — first frame; carries the `conversationId` of the session.\\r\\n- `status` — pipeline progress label; ephemeral UI hint.\\r\\n- `citations` / `sources` — discrete parts of the completed answer; emitted only when non-empty.\\r\\n- `usage` — token totals and question counters for the turn.\\r\\n- `done` — terminal on success; carries the persisted assistant `messageId`, `responseId`, `modelId`,\\r\\n  `createdAt`, `finishReason` and `limitReached`. Limit-blocked turns stream the same grammar with the\\r\\n  predefined limit reply as a single delta and `finishReason` `limit` (nothing persisted).\\r\\n- `error` — terminal on failure; a safe generic `reason` (the question is recorded and counted; no\\r\\n  answer is persisted).\\r\\n\\r\\nThe turn is persisted before the completion frames; assembling the deltas plus the part frames yields the\\r\\nsame data as the non-streaming response. (SwaggerUI cannot render SSE — use a streaming client, e.g. `curl -N`.)\",\r\n        \"operationId\": \"StreamCreate\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"text/event-stream\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SseItemOfDexChatResponseUpdate\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/profile\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"MyProfile\"\r\n        ],\r\n        \"summary\": \"Get the caller's profile.\",\r\n        \"description\": \"Returns the caller's application-local profile, creating it on first access (just-in-time) from the IdP claims. The IdP stays the source of truth for identity; this row holds app-specific preferences plus a cached snapshot of name/email/locale.\",\r\n        \"operationId\": \"GetMe\",\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Profile\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": []\r\n          }\r\n        ]\r\n      },\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"MyProfile\"\r\n        ],\r\n        \"summary\": \"Update the caller's preferences.\",\r\n        \"description\": \"Updates the caller's app-specific preferences (preferred answer language, response style). The language is validated against the configured taxonomy — an unknown value returns 400.\",\r\n        \"operationId\": \"UpdateMe\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/UpdateUserRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Profile\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": []\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/sources/{path}\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Sources\"\r\n        ],\r\n        \"summary\": \"Retrieves the actual source document.\",\r\n        \"description\": \"Retrieves the actual source document. Used for citations and references.\",\r\n        \"operationId\": \"GetActualSource\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"path\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"download\",\r\n            \"in\": \"query\",\r\n            \"schema\": {\r\n              \"type\": [\r\n                \"null\",\r\n                \"boolean\"\r\n              ]\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          },\r\n          {}\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  \"components\": {\r\n    \"schemas\": {\r\n      \"ChatMessageContent\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"parts\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"$ref\": \"#/components/schemas/ChatMessagePart\"\r\n            }\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"ChatMessagePart\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"value\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"contentType\": {\r\n            \"type\": \"string\"\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"ChatRequest\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"text\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"authorName\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"Citation\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"chunkId\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"uuid\"\r\n          },\r\n          \"documentId\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"uuid\"\r\n          },\r\n          \"title\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"snippet\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"sourceUrl\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"headingPath\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"number\": {\r\n            \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n            \"type\": [\r\n              \"integer\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"score\": {\r\n            \"pattern\": \"^-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?(?:[eE][+-]?\\\\d+)?$\",\r\n            \"type\": [\r\n              \"number\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"double\"\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"ConversationListItem\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"id\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"uuid\"\r\n          },\r\n          \"title\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"createdAt\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"date-time\"\r\n          },\r\n          \"lastActivityAt\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"date-time\"\r\n          },\r\n          \"totalPromptTokens\": {\r\n            \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n            \"type\": [\r\n              \"integer\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"int64\"\r\n          },\r\n          \"totalCompletionTokens\": {\r\n            \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n            \"type\": [\r\n              \"integer\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"int64\"\r\n          },\r\n          \"pin\": {\r\n            \"type\": \"boolean\"\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"ConversationListItemResultSet\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"count\": {\r\n            \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n            \"type\": [\r\n              \"integer\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"items\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"$ref\": \"#/components/schemas/ConversationListItem\"\r\n            }\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"DexChatFinishReason\": {\r\n        \"enum\": [\r\n          \"stop\",\r\n          \"length\",\r\n          \"tool_calls\",\r\n          \"content_filter\",\r\n          \"limit\"\r\n        ],\r\n        \"type\": \"string\",\r\n        \"x-enum-varnames\": [\r\n          \"Stop\",\r\n          \"Length\",\r\n          \"ToolCalls\",\r\n          \"ContentFilter\",\r\n          \"Limit\"\r\n        ]\r\n      },\r\n      \"DexChatMessage\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"messageId\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"authorName\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"role\": {\r\n            \"$ref\": \"#/components/schemas/DexChatRole\"\r\n          },\r\n          \"content\": {\r\n            \"$ref\": \"#/components/schemas/ChatMessageContent\"\r\n          },\r\n          \"createdAt\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"date-time\"\r\n          },\r\n          \"citations\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"$ref\": \"#/components/schemas/Citation\"\r\n            }\r\n          },\r\n          \"sources\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"$ref\": \"#/components/schemas/SourceDocumentLink\"\r\n            }\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"DexChatPatchOp\": {\r\n        \"enum\": [\r\n          \"add\",\r\n          \"append\",\r\n          \"replace\"\r\n        ],\r\n        \"type\": \"string\",\r\n        \"x-enum-varnames\": [\r\n          \"Add\",\r\n          \"Append\",\r\n          \"Replace\"\r\n        ]\r\n      },\r\n      \"DexChatResponse\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"conversationId\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"uuid\"\r\n          },\r\n          \"responseId\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"messages\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"$ref\": \"#/components/schemas/DexChatMessage\"\r\n            }\r\n          },\r\n          \"modelId\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"createdAt\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ],\r\n            \"format\": \"date-time\"\r\n          },\r\n          \"finishReason\": {\r\n            \"oneOf\": [\r\n              {\r\n                \"type\": \"null\"\r\n              },\r\n              {\r\n                \"$ref\": \"#/components/schemas/DexChatFinishReason\"\r\n              }\r\n            ]\r\n          },\r\n          \"usage\": {\r\n            \"oneOf\": [\r\n              {\r\n                \"type\": \"null\"\r\n              },\r\n              {\r\n                \"$ref\": \"#/components/schemas/DexChatUsage\"\r\n              }\r\n            ]\r\n          },\r\n          \"limitReached\": {\r\n            \"type\": \"boolean\"\r\n          },\r\n          \"text\": {\r\n            \"type\": \"string\"\r\n          }\r\n        },\r\n        \"additionalProperties\": false\r\n      },\r\n      \"DexChatResponseUpdate\": {\r\n        \"required\": [\r\n          \"type\"\r\n        ],\r\n        \"type\": \"object\",\r\n        \"anyOf\": [\r\n          {\r\n            \"$ref\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamStart\"\r\n          },\r\n          {\r\n            \"$ref\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamStatus\"\r\n          },\r\n          {\r\n            \"$ref\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamDelta\"\r\n          },\r\n          {\r\n            \"$ref\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamError\"\r\n          },\r\n          {\r\n            \"$ref\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamDone\"\r\n          }\r\n        ],\r\n        \"discriminator\": {\r\n          \"propertyName\": \"type\",\r\n          \"mapping\": {\r\n            \"start\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamStart\",\r\n            \"status\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamStatus\",\r\n            \"delta\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamDelta\",\r\n            \"error\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamError\",\r\n            \"done\": \"#/components/schemas/DexChatResponseUpdateDexChatStreamDone\"\r\n          }\r\n        }\r\n      },\r\n      \"DexChatResponseUpdateDexChatStreamDelta\": {\r\n        \"type\": [\r\n          \"null\",\r\n          \"object\"\r\n        ],\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"enum\": [\r\n              \"delta\"\r\n            ],\r\n            \"type\": \"string\"\r\n          },\r\n          \"path\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"string\"\r\n            ]\r\n          },\r\n          \"op\": {\r\n            \"oneOf\": [\r\n              {\r\n                \"type\": \"null\"\r\n              },\r\n              {\r\n                \"$ref\": \"#/components/schemas/DexChatPatchOp\"\r\n              }\r\n            ]\r\n          },\r\n          \"value\": {\r\n            \"type\": [\r\n              \"null\",\r\n              \"object\"\r\n            ]\r\n          }\r\n        }\r\n      },\r\n      \"DexChatResponseUpdateDexChatStreamDone\": {\r\n        \"type\": [\r\n          \"null\",\r\n          \"object\"\r\n        ],\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"enum\": [\r\n              \"done\"\r\n            ],\r\n            \"type\": \"string\"\r\n          }\r\n        }\r\n      },\r\n      \"DexChatResponseUpdateDexChatStreamError\": {\r\n        \"required\": [\r\n          \"reason\"\r\n        ],\r\n        \"type\": [\r\n          \"null\",\r\n          \"object\"\r\n        ],\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"enum\": [\r\n              \"error\"\r\n            ],\r\n            \"type\": \"string\"\r\n          },\r\n          \"reason\": {\r\n            \"type\": \"string\"\r\n          }\r\n        }\r\n      },\r\n      \"DexChatResponseUpdateDexChatStreamStart\": {\r\n        \"type\": [\r\n          \"null\",\r\n          \"object\"\r\n        ],\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"enum\": [\r\n              \"start\"\r\n            ],\r\n            \"type\": \"string\"\r\n          },\r\n          \"conversationId\": {\r\n            \"type\": \"string\",\r\n            \"format\": \"uuid\"\r\n          }\r\n        }\r\n      },\r\n      \"DexChatResponseUpdateDexChatStreamStatus\": {\r\n        \"required\": [\r\n          \"value\"\r\n        ],\r\n        \"type\": [\r\n          \"null\",\r\n          \"object\"\r\n        ],\r\n        \"properties\": {\r\n          \"type\": {\r\n            \"enum\": [\r\n              \"status\"\r\n            ],\r\n            \"type\": \"string\"\r\n          },\r\n          \"value\": {\r\n            \"type\": \"string\"\r\n          }\r\n        }\r\n      },\r\n      \"DexChatRole\": {\r\n        \"enum\": [\r\n          \"user\",\r\n          \"assistant\",\r\n          \"system\",\r\n          \"tool\"\r\n        ],\r\n        \"type\": \"string\",\r\n        \"x-enum-varnames\": [\r\n          \"User\",\r\n          \"Assistant\",\r\n          \"System\",\r\n          \"Tool\"\r\n        ]\r\n      },\r\n      \"DexChat