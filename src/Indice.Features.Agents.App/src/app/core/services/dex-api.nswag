{
  "runtime": "Net80",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": "{\r\n  \"openapi\": \"3.1.1\",\r\n  \"info\": {\r\n    \"title\": \"Dex REST API\",\r\n    \"contact\": {\r\n      \"name\": \"Indice Developer\",\r\n      \"url\": \"https://www.indice.gr\"\r\n    },\r\n    \"version\": \"1.0.0\"\r\n  },\r\n  \"servers\": [\r\n    {\r\n      \"url\": \"https://localhost:2001/\"\r\n    }\r\n  ],\r\n  \"paths\": {\r\n    \"/api/documents/clear\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Documents\"\r\n        ],\r\n        \"summary\": \"Clears the knowledge base.\",\r\n        \"description\": \"Clears all documents and their chunks from the knowledge base.\",\r\n        \"operationId\": \"Clear\",\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"422\": {\r\n            \"description\": \"Unprocessable Entity\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"ingest\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/documents/ingest\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Documents\"\r\n        ],\r\n        \"summary\": \"Ingests a document into the knowledge base.\",\r\n        \"description\": \"Uploads a single Markdown file and processes it into the knowledge base.\",\r\n        \"operationId\": \"DocumentIngest\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"multipart/form-data\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/DocumentIngestRequest\"\r\n              },\r\n              \"example\": {\r\n                \"language\": \"el\",\r\n                \"isPrivate\": false,\r\n                \"category\": \"FAQ\",\r\n                \"actualSourceUrl\": \"\",\r\n                \"documentType\": \"MarkdownFaq\"\r\n              }\r\n            },\r\n            \"application/x-www-form-urlencoded\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/DocumentIngestRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"422\": {\r\n            \"description\": \"Unprocessable Entity\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/IngestionReport\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"ingest\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"List the caller's chat sessions, paged.\",\r\n        \"description\": \"Returns a paged list of sessions owned by the caller, ordered by most recent activity.\",\r\n        \"operationId\": \"List\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"Page\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The current page of the list. Default is 1.\",\r\n            \"schema\": {\r\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n              \"type\": [\r\n                \"null\",\r\n                \"integer\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Size\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The size of the list. Default is 100\",\r\n            \"schema\": {\r\n              \"pattern\": \"^-?(?:0|[1-9]\\\\d*)$\",\r\n              \"type\": [\r\n                \"null\",\r\n                \"integer\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Sort\",\r\n            \"in\": \"query\",\r\n            \"description\": \"The sort order plus the sort direction of the list. for example displayName-\",\r\n            \"schema\": {\r\n              \"type\": [\r\n                \"null\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"Search\",\r\n            \"in\": \"query\",\r\n            \"description\": \"A search term used to limit the results of the list.\",\r\n            \"schema\": {\r\n              \"type\": [\r\n                \"null\",\r\n                \"string\"\r\n              ]\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SessionListItemResultSet\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      },\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Create a chat session with the first question.\",\r\n        \"description\": \"Creates a new chat session for the calling user and runs the first question through the RAG pipeline in one round-trip. Returns 201 with the grounded answer, citations, usage, and the new session id.\",\r\n        \"operationId\": \"Create\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"201\": {\r\n            \"description\": \"Created\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ChatResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Get a chat session with its recent messages.\",\r\n        \"description\": \"Returns session metadata (title, timestamps, cumulative token totals) plus the most recent messages in chronological order.\",\r\n        \"operationId\": \"GetChatSession\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Session\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      },\r\n      \"delete\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Delete a chat session and its messages.\",\r\n        \"description\": \"Permanently deletes the session and all its messages. Returns 204 on success, 404 when the session does not exist for the calling user.\",\r\n        \"operationId\": \"Delete\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}/messages\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Post a follow-up message to an existing chat session.\",\r\n        \"description\": \"Loads bounded conversation history, runs the message through the RAG pipeline, persists the user/assistant turn, and returns the grounded answer + cumulative session token totals.\",\r\n        \"operationId\": \"SendMessage\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ChatResponse\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/{chatId}/messages/stream\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Stream a follow-up turn over Server-Sent Events.\",\r\n        \"description\": \"Streaming counterpart of `POST /api/my/chats/{chatId}/messages`. Emits `event: step`, then `event: delta`\\r\\n(answer token-by-token), then a terminal `event: complete` carrying the citations and persisted\\r\\n`messageId`. Returns 404 before any event is sent when the session does not exist for the caller.\\r\\n(SwaggerUI cannot render SSE — use a streaming client, e.g. `curl -N`.)\",\r\n        \"operationId\": \"StreamMessage\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"chatId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"text/event-stream\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SseItemOfChatStreamEvent\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"description\": \"Not Found\"\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/chats/stream\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"Chats\"\r\n        ],\r\n        \"summary\": \"Create a chat session and stream the first turn over Server-Sent Events.\",\r\n        \"description\": \"Streaming counterpart of `POST /api/my/chats`. Creates a session and runs the first question through\\r\\nthe RAG pipeline, emitting `text/event-stream` events as it executes:\\r\\n\\r\\n- `event: step` — `{ \\\"type\\\":\\\"step\\\", \\\"step\\\":\\\"Retrieving relevant context\\\" }` (one per pipeline step).\\r\\n- `event: delta` — `{ \\\"type\\\":\\\"delta\\\", \\\"text\\\":\\\"…\\\" }` (repeated; the answer streamed token-by-token).\\r\\n- `event: complete` — `{ \\\"type\\\":\\\"complete\\\", \\\"sessionId\\\":\\\"…\\\", \\\"messageId\\\":\\\"…\\\", \\\"answer\\\":\\\"…\\\", \\\"citations\\\":[…], \\\"failed\\\":false, \\\"failureReason\\\":null }`.\\r\\n\\r\\nThe turn is persisted when the stream completes. (SwaggerUI cannot render SSE — use a streaming client, e.g. `curl -N`.)\",\r\n        \"operationId\": \"StreamCreate\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/ChatRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"text/event-stream\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/SseItemOfChatStreamEvent\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": [\r\n              \"chat\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/my/profile\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"MyProfile\"\r\n        ],\r\n        \"summary\": \"Get the caller's profile.\",\r\n        \"description\": \"Returns the caller's application-local profile, creating it on first access (just-in-time) from the IdP claims. The IdP stays the source of truth for identity; this row holds app-specific preferences plus a cached snapshot of name/email/locale.\",\r\n        \"operationId\": \"GetMe\",\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Profile\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": []\r\n          }\r\n        ]\r\n      },\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"MyProfile\"\r\n        ],\r\n        \"summary\": \"Update the caller's preferences.\",\r\n        \"description\": \"Updates the caller's app-specific preferences (preferred answer language, response style). The language is validated against the configured taxonomy — an unknown value returns 400.\",\r\n        \"operationId\": \"UpdateMe\",\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/UpdateUserRequest\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"400\": {\r\n            \"description\": \"Bad Request\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/HttpValidationProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"description\": \"Unauthorized\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"description\": \"Internal Server Error\",\r\n            \"content\": {\r\n              \"application/problem+json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/ProblemDetails\"\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/Profile\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"security\": [\r\n          {\r\n            \"oauth2\": []\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    \"/api/sources/{pat