            ],
            "description": "Preferred answer style; `null`/empty clears it. One of `concise` / `detailed` / `formal`."
          }
        },
        "additionalProperties": false,
        "description": "Body accepted by `PUT /api/my/profile` to update the caller's app-specific preferences."
      }
