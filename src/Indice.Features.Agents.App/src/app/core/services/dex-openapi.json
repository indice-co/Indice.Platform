  "components": {
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message identifier.",
            "format": "uuid"
          },
          "role": {
            "description": "Author role of this message.",
            "$ref": "#/components/schemas/ChatRole"
          },
          "content": {
            "type": "string",
            "description": "Message body."
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "A single turn (user or assistant) in a chat session. DTO exposed at the service boundary; mirrors DbSessionMessage."
      },
      "ChatRequest": {
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
            "description": "The end-user message text."
          }
        },
        "additionalProperties": false,
        "description": "Body accepted by both `POST /api/my/chats` (creates the session inline) and `POST /api/my/chats/{id}/messages`."
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Identifier of the session this turn belongs to.",
            "format": "uuid"
          },
          "messageId": {
            "type": "string",
            "description": "Identifier of the assistant message persisted for this turn.",
            "format": "uuid"
          },
          "answer": {
            "type": [
              "null",
              "string"
            ],
            "description": "The pipeline's answer — grounded when in-scope, or the polite out-of-scope refusal text when not."
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "description": "Citations supporting the answer; empty for out-of-scope responses and on error."
          },
          "failed": {
            "type": "boolean",
            "description": "True when a pipeline step threw and the workflow halted. Out-of-scope is NOT a failure — its refusal text flows through string? ChatResponse.Answer."
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Error message from the step that threw; `null` when bool ChatResponse.Failed is false."
          }
        },
        "additionalProperties": false,
        "description": "Response returned by both `POST /api/my/chats` and `POST /api/my/chats/{id}/messages`."
      },
      "ChatRole": {
        "enum": [
          "User",
          "Assistant",
          "System"
        ],
        "type": "string",
        "description": "Author role of a chat message exposed at the service boundary. Mirrors ChatMessageRole.",
        "x-enum-varnames": [
          "User",
          "Assistant",
          "System"
        ]
      },
      "ChatStreamEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Event discriminator: `step`, `delta`, or `complete`."
          },
          "step": {
            "type": [
              "null",
              "string"
            ],
            "description": "Human-friendly progress label; populated on `step` events."
          },
          "text": {
            "type": [
              "null",
              "string"
            ],
            "description": "Incremental answer text; populated on `delta` events."
          },
          "answer": {
            "type": [
              "null",
              "string"
            ],
            "description": "The full answer; populated on the terminal `complete` event."
          },
          "citations": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "description": "Citations supporting the answer; populated on `complete`."
          },
          "sessionId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the session this turn belongs to; populated on `complete`.",
            "format": "uuid"
          },
          "messageId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the persisted assistant message; populated on `complete`.",
            "format": "uuid"
          },
          "failed": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "True when a pipeline step threw and the workflow halted; populated on `complete`."
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Error message from the step that threw; populated on `complete` when bool? ChatStreamEvent.Failed is true."
          }
        },
        "additionalProperties": false,
        "description": "    Wire model for a single Server-Sent Event emitted while streaming a chat turn. The string ChatStreamEvent.Type\r\n    discriminator mirrors the SSE `event:` name and tells the client which fields are populated:\r\n    * stepstring? ChatStreamEvent.Step — a pipeline-progress label.\r\n* deltastring? ChatStreamEvent.Text — an incremental chunk of the answer.\r\n* completeGuid? ChatStreamEvent.SessionId, Guid? ChatStreamEvent.MessageId, string? ChatStreamEvent.Answer, IReadOnlyList&lt;Citation&gt;? ChatStreamEvent.Citations, bool? ChatStreamEvent.Failed, string? ChatStreamEvent.FailureReason."
      },
      "Citation": {
        "type": "object",
        "properties": {
          "chunkId": {
            "type": "string",
            "description": "Primary key of the cited chunk (`dex.Chunks.Id`).",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "description": "Primary key of the parent document (`dex.Documents.Id`).",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional display title (heading or document title)."
          },
          "headingPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional heading breadcrumb for display, e.g. `H1 &gt; H2 &gt; H3`."
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Relevance score (cosine similarity for retrieval, 0..1 for rerank).",
            "format": "double"
          }
        },
        "additionalProperties": false,
        "description": "A reference to a retrieved chunk that supports an assistant answer."
      },
      "FileParam": {
        "type": "string",
        "format": "binary"
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngestionReport": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the persisted document; `null` when the upload was skipped.",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "description": "The uploaded file name (echoed for client convenience)."
          },
          "chunksCreated": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of chunks inserted for this document; 0 when skipped."
          },
          "skipped": {
            "type": "boolean",
            "description": "True when the upload matched an existing document hash and no work was performed."
          },
          "skippedReason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Reason for skipping; populated only when bool IngestionReport.Skipped is true (e.g. `\"unchanged\"`)."
          },
          "replaced": {
            "type": "boolean",
            "description": "True when an existing document with the same source was deleted before inserting the new one."
          }
        },
        "additionalProperties": false,
        "description": "The endpoint response shape for a single-file ingest."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Profile identifier.",
            "format": "uuid"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Cached display name (from the `name` claim)."
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Cached email (from the `email` claim)."
          },
          "locale": {
            "type": [
              "null",
              "string"
            ],
            "description": "Cached locale (from the `locale` claim)."
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ],
            "description": "Preferred answer language; when set, the composer answers in this language."
          },
          "responseStyle": {
            "type": [
              "null",
              "string"
            ],
            "description": "Preferred answer style fed to the composer (e.g. `concise` / `detailed` / `formal`)."
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp.",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Timestamp of the last change to profile data.",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "description": "Timestamp of the most recent just-in-time touch.",
            "format": "date-time"
          },
          "reasoningTokensLast7Days": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Reasoning-model tokens (prompt + completion) the user consumed in the trailing 7 days.\r\nComputed on read and populated by `UsersService`",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "description": "Application-local user profile DTO exposed at the store boundary; mirrors DbUser.\r\nConsumed by the Users feature (API) and the RAG personalization provider. The internal\r\n`SubjectId` key is not surfaced."
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Session identifier.",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional display title; auto-generated from the first user message when the title-auto-generate option is enabled."
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp.",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "description": "Timestamp of the most recent appended message.",
            "format": "date-time"
          },
          "totalPromptTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Cumulative prompt-token usage across all turns in this session.",
            "format": "int64"
          },
          "totalCompletionTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Cumulative completion-token usage across all turns in this session.",
            "format": "int64"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "description": "Recent messages in chronological order (oldest first), capped at the configured history window."
          }
        },
        "additionalProperties": false,
        "description": "Detail view of a chat session, including the most recent messages."
      },
      "SessionListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Session identifier.",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional display title."
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp.",
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "description": "Timestamp of the most recent appended message.",
            "format": "date-time"
          },
          "totalPromptTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Cumulative prompt-token usage across all turns in this session.",
            "format": "int64"
          },
          "totalCompletionTokens": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Cumulative completion-token usage across all turns in this session.",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "description": "Lightweight row used in paged session listings; messages are not included."
      },
      "SessionListItemResultSet": {
        "type": "object",
        "properties": {
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionListItem"
            }
          }
        },
        "additionalProperties": false
      },
      "SseItemOfChatStreamEvent": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ChatStreamEvent"
          },
          "eventType": {
            "type": "string"
          },
          "eventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reconnectionInterval": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
