{
  "openapi": "3.1.1",
  "info": {
    "title": "Dex REST API",
    "contact": {
      "name": "Indice Developer",
      "url": "https://www.indice.gr"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:2001/"
    }
  ],
  "paths": {
    "/api/ingest/faq": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "POST /api/ingest/faq — multipart upload of a single FAQ-format Markdown file.",
        "description": "Accepts multipart/form-data with a `file` part containing FAQ-shaped Markdown (`# Category` separates segments, `## Question` introduces each question, the body until the next `##`/`#`/EOF is the answer). Each Q&A pair becomes one retrieval chunk; HeadingPath surfaces as 'Category > Question'. The file's first `#` is used as the document category — the form-data `category` is used only when the file has none.",
        "operationId": "UploadFaq",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "$ref": "#/components/schemas/FileParam"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": [
                          "null",
                          "string"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "language": {
                        "type": [
                          "null",
                          "string"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionReport"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "dex",
              "dex:ingest"
            ]
          },
          { }
        ]
      }
    },
    "/api/my/chats": {
      "get": {
        "tags": [
          "MyChats"
        ],
        "summary": "GET /api/my/chats — paged list of the caller's sessions.",
        "description": "Returns a paged list of sessions owned by the caller, ordered by most recent activity.",
        "operationId": "List",
        "parameters": [
          {
            "name": "Page",
            "in": "query",
            "description": "The current page of the list. Default is 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "null",
                "integer",
                "string"
              ]
            }
          },
          {
            "name": "Size",
            "in": "query",
            "description": "The size of the list. Default is 100",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "null",
                "integer",
                "string"
              ]
            }
          },
          {
            "name": "Sort",
            "in": "query",
            "description": "The sort order plus the sort direction of the list. for example displayName-",
            "schema": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          {
            "name": "Search",
            "in": "query",
            "description": "A search term used to limit the results of the list.",
            "schema": {
              "type": [
                "null",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListItemResultSet"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "MyChats"
        ],
        "summary": "POST /api/my/chats — creates a session with the first question.",
        "description": "Creates a new chat session for the calling user and runs the first question through the RAG pipeline in one round-trip. Returns 201 with the grounded answer, citations, usage, and the new session id.",
        "operationId": "Create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [ ]
          }
        ]
      }
    },
    "/api/my/chats/{id}": {
